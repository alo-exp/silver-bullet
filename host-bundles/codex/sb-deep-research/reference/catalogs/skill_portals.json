{
  "version": "1.0.0",
  "description": "SB-owned portal descriptors for landscape|skill-comparison research only. No TopGun adapters.",
  "portals": {
    "github": {
      "id": "github",
      "type": "code_registry",
      "search_url": "https://api.github.com/search/code?q={query}+filename:SKILL.md",
      "landscape_only": true,
      "fallback_on_error": true
    },
    "skills_sh": {
      "id": "skills_sh",
      "type": "skill_registry",
      "search_url": "https://skills.sh/api/search?q={query}",
      "landscape_only": true,
      "fallback_on_error": true
    },
    "cursor_marketplace": {
      "id": "cursor_marketplace",
      "type": "plugin_manifest",
      "notes": "Use host marketplace manifest or curated list",
      "landscape_only": true,
      "fallback_on_error": true
    },
    "claude_plugins": {
      "id": "claude_plugins",
      "type": "plugin_manifest",
      "notes": "Anthropic official plugin registry",
      "landscape_only": true,
      "fallback_on_error": true
    },
    "smithery": {
      "id": "smithery",
      "type": "mcp_registry",
      "notes": "Adjacent MCP infrastructure for landscape scans",
      "landscape_only": true,
      "fallback_on_error": true
    }
  }
}
