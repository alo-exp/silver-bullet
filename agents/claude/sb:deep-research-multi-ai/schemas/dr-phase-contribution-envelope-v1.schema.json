{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dr-phase-contribution-envelope-v1.schema.json",
  "title": "DrPhaseContributionEnvelopeV1",
  "type": "object",
  "required": [
    "schema_id",
    "version",
    "run_id",
    "work_item_id",
    "phase_id",
    "logical_model_id",
    "attempt_id",
    "payload",
    "model_family_id"
  ],
  "properties": {
    "schema_id": {
      "const": "dr-phase-contribution-envelope-v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string"
    },
    "work_item_id": {
      "type": "string"
    },
    "phase_id": {
      "enum": [
        "DR-RETRIEVE",
        "DR-TRIANGULATE",
        "DR-CRITIQUE"
      ]
    },
    "logical_model_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "model_family_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase_id": {
            "const": "DR-RETRIEVE"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "sources": {
                "type": "array"
              },
              "evidence": {
                "type": "array"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase_id": {
            "const": "DR-TRIANGULATE"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "claim_candidates": {
                "type": "array"
              },
              "cross_checks": {
                "type": "array"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase_id": {
            "const": "DR-CRITIQUE"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "critiques": {
                "type": "array"
              },
              "gaps": {
                "type": "array"
              }
            }
          }
        }
      }
    }
  ]
}
