<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alolabs.silver-bullet-site-preview</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO_ROOT__/site/preview-server-daemon.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__/site</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PREVIEW_HOST</key>
    <string>127.0.0.1</string>
    <key>PREVIEW_PORT</key>
    <string>8765</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/site/.preview-server.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/site/.preview-server.log</string>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
