[0m⚙ [0mcontext-mode_ctx_execute {"language":"javascript","code":"const fs = require('fs');\nconst path = require('path');\n\n// Read all 8 files\nconst files = [\n  'skills/multi-ai-task/SKILL.md',\n  'skills/multi-ai-task/rules/methodology.md',\n  'skills/multi-ai-task/rules/dispatch-mechanics.md',\n  'skills/multi-ai-task/rules/consolidation-rules.md',\n  'skills/multi-ai-task/rules/output-schema.md',\n  'skills/multi-ai-task/rules/examples/research-prior-art.md',\n  'skills/multi-ai-task/rules/examples/code-review.md',\n  'skills/multi-ai-task/rules/examples/fact-check.md'\n];\n\nconst contents = {};\nfor (const f of files) {\n  contents[f] = fs.readFileSync(f, 'utf8');\n}\n\n// Cross-reference patterns to check\nconst checks = [];\n\n// 1. Check all instances of \"majority-with-uncertain\" wording\nfor (const [f, c] of Object.entries(contents)) {\n  const lines = c.split('\\n');\n  lines.forEach((line, i) => {\n    if (/majority.*uncertain/.test(line) || /max\\(2.*ceil/.test(line) || /N=3/.test(line) || /2 say true/.test(line)) {\n      checks.push(`[${path.basename(f)}:${i+1}] ${line.trim()}`);\n    }\n  });\n}\nconsole.log(\"=== majority-with-uncertain evidence ===\\n\" + checks.join('\\n'));\n\n// 2. Count references to \"2.2.0\" (vaporware examples)\nconsole.log(\"\\n=== v2.2.0 references ===\");\nfor (const [f, c] of Object.entries(contents)) {\n  const lines = c.split('\\n');\n  lines.forEach((line, i) => {\n    if (/v2\\.2\\.0/.test(line)) {\n      console.log(`[${path.basename(f)}:${i+1}] ${line.trim()}`);\n    }\n  });\n}\n\n// 3. Count all cross-file references to see which files are most referenced\nconsole.log(\"\\n=== Cross-file reference counts ===\");\nconst refCounts = {};\nfor (const [f, c] of Object.entries(contents)) {\n  refCounts[path.basename(f)] = refCounts[path.basename(f)] || [0, f.split('/').pop()];\n  for (const [f2, c2] of Object.entries(contents)) {\n    if (f2 === f) continue;\n    const name = path.basename(f2);\n    if (c.includes(name)) refCounts[path.basename(f)][0]++;\n  }\n}\nconsole.table(refCounts);\n\n// 4. Check for duplicate content between SKILL.md and methodology.md\nconst skillText = contents['skills/multi-ai-task/SKILL.md'];\nconst methText = contents['skills/multi-ai-task/rules/methodology.md'];\nconst skillLines = skillText.split('\\n');\nconst methLines = methText.split('\\n');\nlet dupCount = 0;\nfor (const sl of skillLines) {\n  const trimmed = sl.trim();\n  if (trimmed.length > 40 && methLines.some(ml => ml.trim() === trimmed)) {\n    dupCount++;\n  }\n}\nconsole.log(`\\n=== Duplicate lines (length>40) between SKILL.md and methodology.md: ${dupCount} ===`);\n\n// 5. Find all bash/shell command blocks to check for safety\nconsole.log(\"\\n=== Shell command patterns ===\");\nfor (const [f, c] of Object.entries(contents)) {\n  const lines = c.split('\\n');\n  let inCode = false;\n  lines.forEach((line, i) => {\n    if (line.trim().startsWith('```')) inCode = !inCode;\n    if (inCode && /\\$PROMPT/.test(line)) {\n      console.log(`[${path.basename(f)}:${i+1}] ${line.trim()}`);\n    }\n    if (inCode && /npx/.test(line)) {\n      console.log(`[${path.basename(f)}:${i+1}] npx: ${line.trim()}`);\n    }\n  });\n}\n\n// 6. Check \"extractor model\" references\nconsole.log(\"\\n=== extractor model references ===\");\nfor (const [f, c] of Object.entries(contents)) {\n  const lines = c.split('\\n');\n  lines.forEach((line, i) => {\n    if (/extractor/i.test(line) && line.trim().length > 20) {\n      console.log(`[${path.basename(f)}:${i+1}] ${line.trim()}`);\n    }\n  });\n}\n\n// 7. Count \"pseudocode\" occurrences\nconsole.log(\"\\n=== pseudocode/code blocks ===\");\nfor (const [f, c] of Object.entries(contents)) {\n  const lines = c.split('\\n');\n  let codeBlocks = 0;\n  let inCode = false;\n  for (const line of lines) {\n    if (line.trim().startsWith('```')) {\n      inCode = !inCode;\n      if (inCode) codeBlocks++;\n    }\n  }\n  console.log(`${path.basename(f)}: ${codeBlocks} code blocks, ${lines.length} lines`);\n}\n\n// 8. Check all \"required\" field mentions\nconsole.log(\"\\n=== required: true field references ===\");\nfor (const [f, c] of Object.entries(contents)) {\n  const lines = c.split('\\n');\n  lines.forEach((line, i) => {\n    if (/required.*true/.test(line) && line.trim().length > 5) {\n      console.log(`[${path.basename(f)}:${i+1}] ${line.trim()}`);\n    }\n  });\n}\n\n// 9. Count unique named rules across all files\nconsole.log(\"\\n=== Named rule references ===\");\nconst ruleNames = ['most-severe', 'majority', 'majority-with-uncertain', 'lowest-of-majors', \n  'longest-with-quote', 'concatenate-all', 'all-collected', 'union-dedup', 'merge-exact',\n  'prefer-with-evidence-then-newer-then-strict', 'most-cited', 'newer'];\nruleNames.forEach(rule => {\n  let count = 0;\n  for (const [f, c] of Object.entries(contents)) {\n    const regex = new RegExp(rule.replace(/-/g, '\\\\-'), 'g');\n    const matches = c.match(regex);\n    if (matches) count += matches.length;\n  }\n  console.log(`  ${rule}: ${count}`);\n});\n"}
