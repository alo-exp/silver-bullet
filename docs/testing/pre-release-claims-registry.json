    "delegate": "scripts/agent-cursor-delegate.sh",
    "skill": "skills/silver-agent-cursor/SKILL.md",
    "scenario_doc": "tests/skill-scenarios/silver-five-tool-stack.md",
    "operator_doc": "docs/testing/FIVE-TOOL-PRERELEASE.md",
