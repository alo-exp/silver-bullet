    "1": ["hero-apo-title", "mechanism-dynamic-silver", "help-router-workflow"]
  },
  "tri_host_smoke": {
    "script": "scripts/run-tri-host-install-smoke.sh",
    "test": "tests/scripts/test-tri-host-install-smoke.sh",
    "operator_doc": "docs/testing/ENTERPRISE-E2E-VALIDATION-PLAN.md#pre-release-tri-host-smoke"
  },
  "five_tool_prerelease": {
    "script": "tests/scripts/test-five-tool-prerelease-cursor.sh",
