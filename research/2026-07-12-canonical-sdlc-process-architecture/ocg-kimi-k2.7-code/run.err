[0m⚙ [0mcontext-mode_ctx_execute {"language":"javascript","code":"\nconst fs = require('fs');\nconst path = '/Users/shafqat/projects/silver-bullet/repo/research/2026-07-12-canonical-sdlc-process-architecture/ocg-kimi-k2.7-code/';\n\n// Read sources\nconst srcLines = fs.readFileSync(path + 'sources.jsonl','utf8').split('\\n').filter(l => l.trim());\nconst sources = new Map();\nconst dupes = [];\nsrcLines.forEach(line => {\n  const obj = JSON.parse(line);\n  if (sources.has(obj.id)) {\n    dupes.push(obj.id);\n  } else {\n    sources.set(obj.id, obj);\n  }\n});\nconsole.log(`Initial sources: ${srcLines.length}, unique: ${sources.size}, dupes: ${dupes.join(', ')}`);\n\n// Read evidence files\nconst files = ['subagent-1-evidence.jsonl','subagent-2-evidence.jsonl','subagent-3-evidence.jsonl','subagent-4-evidence.jsonl'];\nconst allEvidence = [];\nfiles.forEach(f => {\n  const lines = fs.readFileSync(path + f,'utf8').split('\\n').filter(l => l.trim());\n  lines.forEach(line => allEvidence.push(JSON.parse(line)));\n});\nconsole.log(`Evidence spans: ${allEvidence.length}`);\n\n// Add missing sources from evidence\nlet added = 0;\nallEvidence.forEach(e => {\n  if (!sources.has(e.source_id)) {\n    const url = e.source_url || '';\n    // derive title from URL last segment\n    let title = url;\n    try {\n      const u = new URL(url);\n      const parts = u.pathname.split('/').filter(p => p);\n      title = parts.length ? parts[parts.length-1].replace(/-/g,' ').replace(/\\.html?$/,'') : u.hostname;\n      title = title.charAt(0).toUpperCase() + title.slice(1);\n    } catch(err) {}\n    sources.set(e.source_id, {\n      id: e.source_id,\n      url: url,\n      title: title,\n      type: 'article',\n      date: '2026',\n      credibility: 'Medium — source cited by subagent; verify independently for critical claims.'\n    });\n    added++;\n  }\n});\nconsole.log(`Sources added from evidence: ${added}`);\nconsole.log(`Total unique sources after merge: ${sources.size}`);\n\n// Write clean sources.jsonl\nconst sortedSources = [...sources.values()].sort((a,b) => a.id.localeCompare(b.id));\nfs.writeFileSync(path + 'sources.jsonl', sortedSources.map(s => JSON.stringify(s)).join('\\n') + '\\n');\nconsole.log('Wrote clean sources.jsonl');\n\n// Write merged evidence.jsonl\n// Normalize evidence: ensure each has evidence_id\nallEvidence.forEach((e, idx) => {\n  e.evidence_id = `ev-${String(idx+1).padStart(4,'0')}`;\n});\nfs.writeFileSync(path + 'evidence.jsonl', allEvidence.map(e => JSON.stringify(e)).join('\\n') + '\\n');\nconsole.log('Wrote evidence.jsonl');\n\n// Summary stats\nconst areaCounts = {};\nallEvidence.forEach(e => {\n  areaCounts[e.process_area] = (areaCounts[e.process_area] || 0) + 1;\n});\nconsole.log('\\nEvidence by process area:');\nObject.entries(areaCounts).sort((a,b) => b[1]-a[1]).forEach(([area, count]) => {\n  console.log(`  ${area}: ${count}`);\n});\n"}
