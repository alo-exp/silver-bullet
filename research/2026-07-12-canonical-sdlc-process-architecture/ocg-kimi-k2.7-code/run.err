[0m⚙ [0mcontext-mode_ctx_execute {"language":"javascript","code":"\nconst fs = require('fs');\nconst path = '/Users/shafqat/projects/silver-bullet/repo/research/2026-07-12-canonical-sdlc-process-architecture/ocg-kimi-k2.7-code/';\n\nconst evidence = fs.readFileSync(path + 'evidence.jsonl','utf8').split('\\n').filter(l => l.trim()).map(JSON.parse);\n\n// Group evidence by claim (case-insensitive normalized)\nconst claimGroups = new Map();\nevidence.forEach(e => {\n  const key = e.claim.toLowerCase().replace(/\\s+/g,' ').trim();\n  if (!claimGroups.has(key)) {\n    claimGroups.set(key, {\n      claim: e.claim,\n      process_area: e.process_area,\n      evidence_ids: [],\n      source_ids: new Set(),\n      source_urls: new Set()\n    });\n  }\n  const g = claimGroups.get(key);\n  g.evidence_ids.push(e.evidence_id);\n  g.source_ids.add(e.source_id);\n  if (e.source_url) g.source_urls.add(e.source_url);\n});\n\n// Build claims\nconst claims = [];\nlet idx = 1;\n[...claimGroups.values()].forEach(g => {\n  const sourceCount = g.source_ids.size;\n  let support_status = 'single-source';\n  if (sourceCount >= 3) support_status = 'triangulated';\n  else if (sourceCount === 2) support_status = 'supported';\n  \n  claims.push({\n    claim_id: `claim-${String(idx++).padStart(4,'0')}`,\n    claim: g.claim,\n    process_area: g.process_area,\n    support_status: support_status,\n    source_count: sourceCount,\n    evidence_ids: g.evidence_ids,\n    source_ids: [...g.source_ids]\n  });\n});\n\nfs.writeFileSync(path + 'claims.jsonl', claims.map(c => JSON.stringify(c)).join('\\n') + '\\n');\n\nconsole.log(`Total unique claims: ${claims.length}`);\nconsole.log('Support status distribution:');\nconst dist = {};\nclaims.forEach(c => dist[c.support_status] = (dist[c.support_status] || 0) + 1);\nObject.entries(dist).forEach(([k,v]) => console.log(`  ${k}: ${v}`));\n\nconsole.log('\\nSample claims:');\nclaims.slice(0,5).forEach(c => console.log(`  ${c.claim_id}: ${c.claim.substring(0,80)}... [${c.support_status}]`));\n"}
