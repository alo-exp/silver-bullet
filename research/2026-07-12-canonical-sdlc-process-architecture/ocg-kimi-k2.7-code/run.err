ution & Retirement': '17. Maintenance Evolution & Retirement',\n  'PA-17 Maintenance Evolution & Retirement': '17. Maintenance Evolution & Retirement',\n  'Maintenance Evolution & Retirement': '17. Maintenance Evolution & Retirement',\n  '18': '18. AI-Assisted / Agentic Software Engineering',\n  'AI-Assisted / Agentic Software Engineering': '18. AI-Assisted / Agentic Software Engineering',\n  'PA-18 AI-Assisted / Agentic Software Engineering': '18. AI-Assisted / Agentic Software Engineering'\n};\n\nconst lines = fs.readFileSync(path + 'evidence.jsonl','utf8').split('\\n').filter(l => l.trim());\nconst normalized = [];\nconst unknown = new Set();\nlines.forEach((line, idx) => {\n  const obj = JSON.parse(line);\n  const area = obj.process_area;\n  if (canonical[area]) {\n    obj.process_area = canonical[area];\n  } else {\n    unknown.add(area);\n  }\n  normalized.push(obj);\n});\n\nif (unknown.size > 0) {\n  console.log('Unknown area labels:', [...unknown].join('\\n'));\n} else {\n  console.log('All area labels normalized successfully');\n}\n\nfs.writeFileSync(path + 'evidence.jsonl', normalized.map(e => JSON.stringify(e)).join('\\n') + '\\n');\n\nconst counts = {};\nnormalized.forEach(e => {\n  counts[e.process_area] = (counts[e.process_area] || 0) + 1;\n});\nconsole.log('\\nEvidence counts by canonical area:');\nObject.entries(counts).sort((a,b) => parseInt(a[0]) - parseInt(b[0])).forEach(([area, count]) => {\n  console.log(`  ${area}: ${count}`);\n});\nconsole.log(`\\nTotal evidence spans: ${normalized.length}`);\n"}
