/**
 * Minimal API health endpoint for smoke verification.
 *
 * Returns `{ status, service, version }`. Accepts an optional
 * `versionSource` callable so callers can wire in their own version
 * discovery (env var, package.json read, build manifest, etc.) without
 * coupling this module to a specific source.
 *
 * If `versionSource` is omitted or yields a non-string / empty value,
 * the endpoint falls back to `'0.0.0-unknown'` rather than throwing —
 * this is the fix for the bug where a missing version produced a 500.
 */

const FALLBACK_VERSION = '0.0.0-unknown';
const SERVICE_NAME = 'enterprise-grade-test-app-api';

function _resolveVersion(versionSource) {
  if (typeof versionSource !== 'function') return FALLBACK_VERSION;
  let raw;
  try {
    raw = versionSource();
  } catch (_err) {
    return FALLBACK_VERSION;
  }
  if (typeof raw !== 'string' || raw.length === 0) return FALLBACK_VERSION;
  return raw;
}

function health(options = {}) {
  const { versionSource } = options;
  return {
    status: 'ok',
    service: SERVICE_NAME,
    version: _resolveVersion(versionSource),
  };
}

module.exports = { health, FALLBACK_VERSION };
