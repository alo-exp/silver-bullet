diff --git a/api/src/observability.test.js b/api/src/observability.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..9a909ddef570eb3c03d3440d0a23f57cf06ef910
--- /dev/null
+++ b/api/src/observability.test.js
@@ -0,0 +1,79 @@
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const { health } = require('./health');
+const { createOrder } = require('./orders');
+const { startServer, stopServer } = require('../../tests/benchmarks/server');
+
+function captureLogger() {
+  const lines = [];
+  return {
+    lines,
+    logger: (line) => lines.push(line),
+    entries: () => lines.map((line) => JSON.parse(line)),
+  };
+}
+
+function request(url, correlationId) {
+  return new Promise((resolve, reject) => {
+    const req = http.get(
+      url,
+      { headers: { 'x-correlation-id': correlationId } },
+      (res) => {
+        res.resume();
+        res.on('end', () => resolve(res));
+      },
+    );
+    req.on('error', reject);
+  });
+}
+
+(async () => {
+  const healthLogs = captureLogger();
+  health({
+    correlation_id: 'tc02-health',
+    logger: healthLogs.logger,
+    versionSource: () => 'tc02',
+  });
+
+  const orderLogs = captureLogger();
+  createOrder(
+    { sku: 'OBSERVE-1', qty: 1, currency: 'USD' },
+    { correlation_id: 'tc02-order', logger: orderLogs.logger },
+  );
+
+  const serverLogs = captureLogger();
+  const started = await startServer({ logger: serverLogs.logger });
+  try {
+    await request(`${started.url}/healthz`, 'tc02-http');
+  } finally {
+    await stopServer(started.server);
+  }
+
+  for (const entry of [
+    ...healthLogs.entries(),
+    ...orderLogs.entries(),
+    ...serverLogs.entries(),
+  ]) {
+    assert.equal(typeof entry.timestamp, 'string');
+    assert.equal(entry.service, 'enterprise-grade-test-app-api');
+    assert.equal(typeof entry.level, 'string');
+    assert.equal(typeof entry.event, 'string');
+    assert.equal(typeof entry.correlation_id, 'string');
+  }
+
+  assert.deepEqual(
+    healthLogs.entries().map((entry) => entry.correlation_id),
+    ['tc02-health', 'tc02-health'],
+  );
+  assert.deepEqual(
+    orderLogs.entries().map((entry) => entry.correlation_id),
+    ['tc02-order', 'tc02-order'],
+  );
+  assert.equal(serverLogs.entries()[0].correlation_id, 'tc02-http');
+  assert.equal(serverLogs.entries()[1].correlation_id, 'tc02-http');
+
+  console.log('observability ok');
+})().catch((err) => {
+  console.error(err.stack || err.message);
+  process.exit(1);
+});
