/**
 * Orders API tests — currency field
 * TDD: written BEFORE implementation. Run with: npm test
 */

const assert = require('node:assert/strict');
const { createOrder, getOrder } = require('./orders');

let pass = 0;
let fail = 0;
const failures = [];

function test(name, fn) {
  try {
    fn();
    pass += 1;
    console.log(`  ok  ${name}`);
  } catch (err) {
    fail += 1;
    failures.push({ name, err });
    console.log(`  FAIL ${name}: ${err.message}`);
  }
}

console.log('orders.test.js');

// AC-1: createOrder with explicit currency includes it in the returned order
test('AC-1: createOrder includes supplied currency', () => {
  const order = createOrder({ sku: 'WIDGET-1', qty: 2, currency: 'EUR' });
  assert.equal(order.currency, 'EUR');
});

// AC-2: createOrder defaults currency to USD when omitted
test('AC-2: createOrder defaults to USD when currency omitted', () => {
  const order = createOrder({ sku: 'WIDGET-2', qty: 1 });
  assert.equal(order.currency, 'USD');
});

// AC-3: createOrder rejects lowercase currency
test('AC-3: createOrder rejects lowercase currency', () => {
  assert.throws(
    () => createOrder({ sku: 'WIDGET-3', qty: 1, currency: 'usd' }),
    /invalid currency/i,
  );
});

// AC-4: createOrder rejects 2-letter currency
test('AC-4: createOrder rejects 2-letter currency', () => {
  assert.throws(
    () => createOrder({ sku: 'WIDGET-4', qty: 1, currency: 'US' }),
    /invalid currency/i,
  );
});

// AC-5: getOrder returns order including currency
test('AC-5: getOrder returns order with currency', () => {
  const created = createOrder({ sku: 'WIDGET-5', qty: 3, currency: 'GBP' });
  const fetched = getOrder(created.id);
  assert.equal(fetched.currency, 'GBP');
});

// Bonus: also rejects digits
test('extra: createOrder rejects digits', () => {
  assert.throws(
    () => createOrder({ sku: 'WIDGET-6', qty: 1, currency: '123' }),
    /invalid currency/i,
  );
});

console.log(`\n${pass} passed, ${fail} failed`);

if (fail > 0) {
  for (const { name, err } of failures) {
    console.log(`\n--- ${name} ---`);
    console.log(err.stack || err.message);
  }
  process.exit(1);
}

process.exit(0);
