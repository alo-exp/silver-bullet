/**
 * Benchmark driver for the /healthz endpoint.
 *
 * The matrix is defined in BENCHMARK_SCENARIOS below. Each scenario is a
 * callable (run on a fresh server) that returns a list of {scenario, ...}
 * summary records. Per-request latencies are written to JSONL files under
 * docs/benchmarks/data/.
 *
 * Usage:
 *   node tests/benchmarks/load.js [--out docs/benchmarks/data] [--tag run1]
 */

const fs = require('node:fs');
const path = require('node:path');
const http = require('node:http');
const { performance } = require('node:perf_hooks');
const { startServer, stopServer } = require('./server');
const { summarize, fmt } = require('./stats');

function parseArgs(argv) {
  const args = { out: 'docs/benchmarks/data', tag: `run-${Date.now()}` };
  for (let i = 2; i < argv.length; i += 1) {
    const a = argv[i];
    if (a === '--out') args.out = argv[++i];
    else if (a === '--tag') args.tag = argv[++i];
  }
  return args;
}

function singleRequest(url) {
  return new Promise((resolve) => {
    const start = performance.now();
    const req = http.get(url, (res) => {
      const chunks = [];
      res.on('data', (c) => chunks.push(c));
      res.on('end', () => {
        const end = performance.now();
        resolve({
          status: res.statusCode,
          latencyMs: end - start,
          body: Buffer.concat(chunks).toString('utf8'),
        });
      });
    });
    req.on('error', (err) => {
      const end = performance.now();
      resolve({
        status: 0,
        latencyMs: end - start,
        error: err.message,
      });
    });
    req.setTimeout(5000, () => {
      req.destroy(new Error('timeout'));
    });
  });
}

async function runSequential(url, count) {
  const samples = [];
  const t0 = performance.now();
  for (let i = 0; i < count; i += 1) {
    // eslint-disable-next-line no-await-in-loop
    const r = await singleRequest(url);
    samples.push({ idx: i, ...r });
  }
  const t1 = performance.now();
  return { samples, elapsedMs: t1 - t0 };
}

async function runConcurrent(url, count, parallelism) {
  const samples = new Array(count);
  let cursor = 0;
  const t0 = performance.now();
  const workers = Array.from({ length: parallelism }, async () => {
    while (true) {
      const idx = cursor;
      cursor += 1;
      if (idx >= count) return;
      // eslint-disable-next-line no-await-in-loop
      const r = await singleRequest(url);
      samples[idx] = { idx, ...r };
    }
  });
  await Promise.all(workers);
  const t1 = performance.now();
  return { samples, elapsedMs: t1 - t0 };
}

function validateResponse(r) {
  if (r.status !== 200) return { ok: false, reason: `status ${r.status}` };
  if (!r.body) return { ok: false, reason: 'empty body' };
  let parsed;
  try {
    parsed = JSON.parse(r.body);
  } catch (e) {
    return { ok: false, reason: `json parse: ${e.message}` };
  }
  if (parsed.status !== 'ok') return { ok: false, reason: `status=${parsed.status}` };
  if (typeof parsed.version !== 'string' || parsed.version.length === 0) {
    return { ok: false, reason: 'missing version' };
  }
  if (parsed.service !== 'enterprise-grade-test-app-api') {
    return { ok: false, reason: `unexpected service=${parsed.service}` };
  }
  return { ok: true, payload: parsed };
}

function writeJsonl(file, rows) {
  fs.writeFileSync(file, rows.map((r) => JSON.stringify(r)).join('\n') + '\n');
}

function startCpuLoad(targetCores, durationMs) {
  // Spin child processes doing tight busy-loops. We measure load generation
  // wall-time separately and ensure the load stops before the next scenario.
  const procs = [];
  for (let i = 0; i < targetCores; i += 1) {
    const p = require('node:child_process').fork(
      path.join(__dirname, '..', '..', 'scripts', 'noop-spinner.js'),
      [],
      { stdio: 'ignore' },
    );
    procs.push(p);
  }
  const stop = () => {
    for (const p of procs) {
      try {
        p.kill('SIGKILL');
      } catch (_e) {
        /* ignore */
      }
    }
  };
  setTimeout(stop, durationMs).unref();
  return { procs, stop };
}

