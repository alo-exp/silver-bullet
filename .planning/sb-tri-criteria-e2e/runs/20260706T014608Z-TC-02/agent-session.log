/**
 * Orders API — currency field support
 * In-memory store. Validation is delegated to ./domain/orders/validation.
 */

const {
  DEFAULT_CURRENCY,
  validateCurrency,
  validateSku,
  validateQty,
} = require('./domain/orders/validation');

const _store = new Map();
let _nextId = 1;

function createOrder({ sku, qty, currency } = {}) {
  validateSku(sku);
  validateQty(qty);

  const finalCurrency = validateCurrency(currency);
  const id = String(_nextId++);
  const order = { id, sku, qty, currency: finalCurrency };
  _store.set(id, order);
  return order;
}

function getOrder(id) {
  const order = _store.get(String(id));
  if (!order) {
    throw new Error(`order not found: ${id}`);
  }
  return order;
}

module.exports = {
  createOrder,
  getOrder,
  DEFAULT_CURRENCY,
};
