+  padding: 14px;
+}
+
+dt {
+  color: #5d6b7a;
+  font-size: 0.78rem;
+  font-weight: 700;
+  text-transform: uppercase;
+}
+
+dd {
+  min-height: 28px;
+  margin: 6px 0 0;
+  font-size: 1.25rem;
+  font-weight: 800;
+}
+
+@media (max-width: 760px) {
