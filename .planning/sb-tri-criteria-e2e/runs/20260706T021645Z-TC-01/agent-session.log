+        <dl class="stats">
+          <div>
+            <dt>Total signups</dt>
+            <dd id="total">0</dd>
+          </div>
+          <div>
+            <dt>Latest signup</dt>
+            <dd id="latest">None</dd>
+          </div>
+        </dl>
+      </section>
+    </main>
+    <script src="/app.js"></script>
+  </body>
+</html>
