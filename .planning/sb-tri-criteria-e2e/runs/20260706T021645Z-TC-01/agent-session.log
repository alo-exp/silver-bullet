/**
 * Orders domain — input validation.
 * Pure functions; no I/O; no module-level state.
 *
 * Public API:
 *   DEFAULT_CURRENCY    — ISO 4217 default applied when caller omits currency
 *   validateCurrency(v) — returns the validated code, or DEFAULT_CURRENCY when
 *                         v is null/undefined; throws Error on invalid input
 *   validateSku(sku)    — throws Error when sku is not a non-empty string
 *   validateQty(qty)    — throws Error when qty is not a positive integer
 */

const DEFAULT_CURRENCY = 'USD';
const CURRENCY_RE = /^[A-Z]{3}$/;

function validateCurrency(value) {
  if (value === undefined || value === null) return DEFAULT_CURRENCY;
  if (typeof value !== 'string' || !CURRENCY_RE.test(value)) {
    throw new Error(`invalid currency: ${value}`);
  }
  return value;
}

function validateSku(sku) {
  if (typeof sku !== 'string' || sku.length === 0) {
    throw new Error('sku must be a non-empty string');
  }
}

function validateQty(qty) {
  if (!Number.isInteger(qty) || qty <= 0) {
    throw new Error('qty must be a positive integer');
  }
}

module.exports = { DEFAULT_CURRENCY, validateCurrency, validateSku, validateQty };
