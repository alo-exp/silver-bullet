/**
 * Badge UI test — Enterprise E2E matrix coverage.
 *
 * Style mirrors api/src/orders.test.js (mini-runner). No test framework dep.
 *
 * Matrix axes:
 *   - viewports:   [360, 768, 1280, 1920]
 *   - render modes: resolved, fallback (undefined), error (throwing source)
 *   - per cell: text non-empty, markup contains data-testid, length < 256,
 *               role="note" present, aria-label present, no broken substrings
 *
 * The badge module under test is ui/src/badge.js. The contract is fully
 * described in .planning/UI-CONTRACT-ui-badge.md.
 *
 * TDD: written BEFORE ui/src/badge.js is created. Run with: npm test
 */

const assert = require('node:assert/strict');
const fs = require('node:fs');
const path = require('node:path');

const BADGE_PATH = path.join(__dirname, '..', '..', 'ui', 'src', 'badge.js');
const APP_PATH = path.join(__dirname, '..', '..', 'ui', 'src', 'App.jsx');

let pass = 0;
let fail = 0;
const failures = [];

function test(name, fn) {
  try {
    fn();
    pass += 1;
    console.log(`  ok  ${name}`);
  } catch (err) {
    fail += 1;
    failures.push({ name, err });
    console.log(`  FAIL ${name}: ${err.message}`);
  }
}

console.log('badge.test.js');

// --- Wave 1: source-level wiring (AC-9, AC-10) -----------------------

test('AC-9: ui/src/App.jsx references the badge module', () => {
  const src = fs.readFileSync(APP_PATH, 'utf8');
  assert.ok(
    src.includes('./badge'),
    'ui/src/App.jsx must reference ./badge module',
  );
});

// --- Wave 2: badge module pure-function contract (AC-1..AC-6) ---------

let badge;
test('ui/src/badge.js is importable from Node', () => {
  badge = require(BADGE_PATH);
  assert.equal(typeof badge.getBadgeText, 'function');
  assert.equal(typeof badge.getBadgeMarkup, 'function');
  assert.equal(typeof badge.BADGE_LABEL, 'string');
});

test('AC-1: getBadgeText returns "API v1.2.3" when source returns "1.2.3"', () => {
  assert.equal(
    badge.getBadgeText({ versionSource: () => '1.2.3' }),
    'API v1.2.3',
  );
});

test('AC-2: getBadgeText returns "API v9.9.9-test" for non-semver versions', () => {
  assert.equal(
    badge.getBadgeText({ versionSource: () => '9.9.9-test' }),
    'API v9.9.9-test',
  );
});

test('AC-3: getBadgeText returns fallback "API v0.0.0-unknown" when source returns undefined', () => {
  assert.equal(
    badge.getBadgeText({ versionSource: () => undefined }),
    'API v0.0.0-unknown',
  );
});

test('AC-4: getBadgeText returns fallback when no versionSource is provided', () => {
  assert.equal(badge.getBadgeText({}), 'API v0.0.0-unknown');
});

test('AC-5: getBadgeText NEVER throws when versionSource throws', () => {
  let result;
  assert.doesNotThrow(() => {
    result = badge.getBadgeText({
      versionSource: () => {
        throw new Error('boom');
      },
    });
  });
  assert.equal(result, 'API v0.0.0-unknown');
});

test('AC-5b: getBadgeText returns fallback when source returns a non-string', () => {
  assert.equal(
    badge.getBadgeText({ versionSource: () => 42 }),
    'API v0.0.0-unknown',
  );
  assert.equal(
    badge.getBadgeText({ versionSource: () => null }),
    'API v0.0.0-unknown',
  );
  assert.equal(
    badge.getBadgeText({ versionSource: () => '' }),
    'API v0.0.0-unknown',
  );
});

test('AC-6: getBadgeMarkup contains data-testid="api-version-badge"', () => {
  const m = badge.getBadgeMarkup({ versionSource: () => '1.2.3' });
  assert.ok(
    m.includes('data-testid="api-version-badge"'),
    `markup must include data-testid="api-version-badge"; got: ${m}`,
  );
});

test('AC-11: getBadgeMarkup includes role="note" and an aria-label', () => {
  const m = badge.getBadgeMarkup({ versionSource: () => '1.2.3' });
  assert.ok(m.includes('role="note"'), 'markup must include role="note"');
  assert.ok(
    m.includes('aria-label="API version 1.2.3"'),
    `markup must include aria-label="API version 1.2.3"; got: ${m}`,
  );
});

// --- Wave 4: enterprise E2E matrix (AC-7, AC-8) -----------------------

const VIEWPORTS = [360, 768, 1280, 1920];
const RENDER_MODES = [
  { name: 'resolved', versionSource: () => '1.2.3' },
  { name: 'fallback', versionSource: () => undefined },
  { name: 'error', versionSource: () => { throw new Error('boom'); } },
];

for (const viewport of VIEWPORTS) {
  for (const mode of RENDER_MODES) {
    test(`AC-7/AC-8 [viewport=${viewport} mode=${mode.name}]: text non-empty & markup < 256`, () => {
      const text = badge.getBadgeText({ versionSource: mode.versionSource });
      const markup = badge.getBadgeMarkup({ versionSource: mode.versionSource });

      assert.ok(text.length > 0, 'text must be non-empty');
      assert.ok(markup.length < 256, `markup must be < 256 chars; got ${markup.length}`);
      assert.ok(markup.includes(text), 'markup must include the visible text');
      assert.ok(
        markup.includes('data-testid="api-version-badge"'),
        'markup must include data-testid',
      );
      assert.ok(markup.includes('role="note"'), 'markup must include role');
      assert.ok(markup.includes('aria-label="API version '), 'markup must include aria-label');

      // No broken-substring sanitization
      assert.ok(!markup.includes('undefined'), 'no "undefined" in markup');
      assert.ok(!markup.includes('[object Object]'), 'no [object Object] in markup');
    });
  }
}

console.log(`\n${pass} passed, ${fail} failed`);

if (fail > 0) {
  for (const { name, err } of failures) {
    console.log(`\n--- ${name} ---`);
    console.log(err.stack || err.message);
  }
  process.exit(1);
}

process.exit(0);

