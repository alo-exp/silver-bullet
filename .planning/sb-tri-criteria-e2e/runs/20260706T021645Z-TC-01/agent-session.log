diff --git a/api/src/server.js b/api/src/server.js
new file mode 100644
index 0000000000000000000000000000000000000000..39b981be0cc760ab5d70d268a1194a22c6d0c285
--- /dev/null
+++ b/api/src/server.js
@@ -0,0 +1,163 @@
+const fs = require('node:fs');
+const http = require('node:http');
+const path = require('node:path');
+const { pathToFileURL } = require('node:url');
+const { health } = require('./health');
+const { createWaitlistStore, DEFAULT_DB_PATH, MAX_BODY_BYTES } = require('./waitlist');
+
+const DEFAULT_PUBLIC_DIR = path.join(process.cwd(), 'public');
+const MIME_TYPES = {
+  '.css': 'text/css; charset=utf-8',
+  '.html': 'text/html; charset=utf-8',
+  '.js': 'application/javascript; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.svg': 'image/svg+xml',
+};
+
+function sendJson(res, statusCode, payload) {
+  const body = JSON.stringify(payload);
+  res.writeHead(statusCode, {
+    'content-type': 'application/json; charset=utf-8',
+    'content-length': Buffer.byteLength(body),
+    'x-content-type-options': 'nosniff',
+    'x-frame-options': 'DENY',
+    'referrer-policy': 'no-referrer',
+  });
+  res.end(body);
+}
+
+function sendError(res, err) {
+  const statusCode = Number.isInteger(err.statusCode) ? err.statusCode : 500;
+  sendJson(res, statusCode, {
+    error: statusCode >= 500 ? 'internal server error' : err.message,
+  });
+}
+
+function getTenantId(req) {
+  return req.headers['x-tenant-id'];
+}
+
+function readJsonBody(req) {
+  return new Promise((resolve, reject) => {
+    let size = 0;
+    const chunks = [];
+    req.on('data', (chunk) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        const err = new Error('request body too large');
+        err.statusCode = 413;
+        reject(err);
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('error', reject);
+    req.on('end', () => {
+      const raw = Buffer.concat(chunks).toString('utf8');
+      if (raw.length === 0) {
+        resolve({});
+        return;
+      }
+      try {
+        resolve(JSON.parse(raw));
+      } catch (_err) {
+        const err = new Error('request body must be valid JSON');
+        err.statusCode = 400;
+        reject(err);
+      }
+    });
+  });
+}
+
+function staticPathFor(urlPath, publicDir) {
+  const pathname = urlPath === '/' ? '/index.html' : urlPath;
+  const decoded = decodeURIComponent(pathname);
+  const resolved = path.resolve(publicDir, `.${decoded}`);
+  if (!resolved.startsWith(path.resolve(publicDir) + path.sep)) {
+    return null;
+  }
+  return resolved;
+}
+
+function serveStatic(req, res, publicDir) {
+  const filePath = staticPathFor(new URL(req.url, 'http://localhost').pathname, publicDir);
+  if (!filePath) {
+    sendJson(res, 403, { error: 'forbidden' });
+    return;
+  }
+  fs.readFile(filePath, (err, content) => {
+    if (err) {
+      sendJson(res, 404, { error: 'not found' });
+      return;
+    }
+    const ext = path.extname(filePath);
+    res.writeHead(200, {
+      'content-type': MIME_TYPES[ext] || 'application/octet-stream',
+      'content-length': content.length,
+      'x-content-type-options': 'nosniff',
+      'x-frame-options': 'DENY',
+      'referrer-policy': 'no-referrer',
+      'content-security-policy': "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'",
+    });
+    res.end(content);
+  });
+}
+
+function createServer(options = {}) {
+  const store = options.store || createWaitlistStore({ dbPath: options.dbPath || DEFAULT_DB_PATH });
+  const publicDir = options.publicDir || DEFAULT_PUBLIC_DIR;
+
+  const server = http.createServer(async (req, res) => {
+    const url = new URL(req.url, 'http://localhost');
+    try {
+      if (req.method === 'GET' && url.pathname === '/health') {
+        sendJson(res, 200, health());
+        return;
+      }
+
+      if (req.method === 'POST' && url.pathname === '/waitlist') {
+        const body = await readJsonBody(req);
+        const entry = store.addEntry({
+          tenantId: getTenantId(req),
+          email: body.email,
+          name: body.name,
+        });
+        sendJson(res, 201, entry);
+        return;
+      }
+
+      if (req.method === 'GET' && url.pathname === '/waitlist/stats') {
+        sendJson(res, 200, store.getStats({ tenantId: getTenantId(req) }));
+        return;
+      }
+
+      if (req.method === 'GET' || req.method === 'HEAD') {
+        serveStatic(req, res, publicDir);
+        return;
+      }
+
+      sendJson(res, 405, { error: 'method not allowed' });
+    } catch (err) {
+      sendError(res, err);
+    }
+  });
+
+  server.closeStore = () => store.close();
+  return server;
+}
+
+function start() {
+  const port = Number(process.env.PORT || 3000);
+  const dbPath = process.env.WAITLIST_DB_PATH || DEFAULT_DB_PATH;
+  const server = createServer({ dbPath });
+  server.listen(port, () => {
+    console.log(`waitlist app listening on http://localhost:${port}`);
+  });
+}
+
+if (require.main === module) {
+  start();
+}
+
+module.exports = { createServer, start, sendJson, pathToFileURL };
diff --git a/api/src/waitlist.js b/api/src/waitlist.js
new file mode 100644
index 0000000000000000000000000000000000000000..8d70a12c4f949d5c515f4755ee4f9055946f9701
--- /dev/null
+++ b/api/src/waitlist.js
@@ -0,0 +1,146 @@
+const fs = require('node:fs');
+const path = require('node:path');
+const { DatabaseSync } = require('node:sqlite');
+
+const DEFAULT_DB_PATH = path.join(process.cwd(), 'data', 'waitlist.sqlite');
+const TENANT_RE = /^[a-z0-9][a-z0-9-]{0,63}$/;
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+const MAX_BODY_BYTES = 16 * 1024;
+
+function validationError(message) {
+  const err = new Error(message);
+  err.code = 'VALIDATION_ERROR';
+  err.statusCode = 400;
+  return err;
+}
+
+function duplicateError(email) {
+  const err = new Error(`email already joined waitlist: ${email}`);
+  err.code = 'WAITLIST_DUPLICATE';
+  err.statusCode = 409;
+  return err;
+}
+
+function normalizeTenantId(value) {
+  if (typeof value !== 'string') {
+    throw validationError('X-Tenant-Id header is required');
+  }
+  const tenantId = value.trim();
+  if (!TENANT_RE.test(tenantId)) {
+    throw validationError('X-Tenant-Id must be lowercase letters, numbers, or hyphens');
+  }
+  return tenantId;
+}
+
+function normalizeEmail(value) {
+  if (typeof value !== 'string') {
+    throw validationError('email is required');
+  }
+  const email = value.trim().toLowerCase();
+  if (email.length === 0 || email.length > 254 || !EMAIL_RE.test(email)) {
+    throw validationError('email must be a valid email address');
+  }
+  return email;
+}
+
+function normalizeName(value) {
+  if (value === undefined || value === null || value === '') return null;
+  if (typeof value !== 'string') {
+    throw validationError('name must be a string when provided');
+  }
+  const name = value.trim();
+  if (name.length === 0) return null;
+  if (name.length > 120) {
+    throw validationError('name must be 120 characters or fewer');
+  }
+  return name;
+}
+
+function openDatabase(dbPath = DEFAULT_DB_PATH) {
+  if (dbPath !== ':memory:') {
+    fs.mkdirSync(path.dirname(dbPath), { recursive: true });
+  }
+  const db = new DatabaseSync(dbPath);
+  db.exec(`
+    CREATE TABLE IF NOT EXISTS waitlist_entries (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      tenant_id TEXT NOT NULL,
+      email TEXT NOT NULL,
+      name TEXT,
+      created_at TEXT NOT NULL,
+      UNIQUE(tenant_id, email)
+    );
+    CREATE INDEX IF NOT EXISTS waitlist_entries_tenant_created_idx
+      ON waitlist_entries (tenant_id, created_at);
+  `);
+  return db;
+}
+
+function rowToEntry(row) {
+  return {
+    id: String(row.id),
+    tenantId: row.tenant_id,
+    email: row.email,
+    name: row.name,
+    createdAt: row.created_at,
+  };
+}
+
+function createWaitlistStore(options = {}) {
+  const db = options.db || openDatabase(options.dbPath);
+
+  function addEntry(input = {}) {
+    const tenantId = normalizeTenantId(input.tenantId);
+    const email = normalizeEmail(input.email);
+    const name = normalizeName(input.name);
+    const createdAt = new Date().toISOString();
+
+    let result;
+    try {
+      result = db.prepare(`
+        INSERT INTO waitlist_entries (tenant_id, email, name, created_at)
+        VALUES (?, ?, ?, ?)
+      `).run(tenantId, email, name, createdAt);
+    } catch (err) {
+      if (err && err.code === 'ERR_SQLITE_ERROR' && /UNIQUE/i.test(err.message)) {
+        throw duplicateError(email);
+      }
+      throw err;
+    }
+
+    return rowToEntry(db.prepare(`
+      SELECT id, tenant_id, email, name, created_at
+      FROM waitlist_entries
+      WHERE id = ?
+    `).get(result.lastInsertRowid));
+  }
+
+  function getStats(input = {}) {
+    const tenantId = normalizeTenantId(input.tenantId);
+    const row = db.prepare(`
+      SELECT COUNT(*) AS total, MAX(created_at) AS latest_created_at
+      FROM waitlist_entries
+      WHERE tenant_id = ?
+    `).get(tenantId);
+    return {
+      tenantId,
+      total: Number(row.total),
+      latestSignupAt: row.latest_created_at || null,
+    };
+  }
+
+  function close() {
+    db.close();
+  }
+
+  return { addEntry, getStats, close };
+}
+
+module.exports = {
+  DEFAULT_DB_PATH,
+  MAX_BODY_BYTES,
+  createWaitlistStore,
+  normalizeTenantId,
+  normalizeEmail,
+  normalizeName,
+};
diff --git a/api/src/waitlist.test.js b/api/src/waitlist.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..710f75980f0c76ed061b6d53ca5e1180ce88d8ac
--- /dev/null
+++ b/api/src/waitlist.test.js
@@ -0,0 +1,91 @@
+const assert = require('node:assert/strict');
+const { createWaitlistStore } = require('./waitlist');
+
+let pass = 0;
+let fail = 0;
+const failures = [];
+
+function test(name, fn) {
+  try {
+    fn();
+    pass += 1;
+    console.log(`  ok  ${name}`);
+  } catch (err) {
+    fail += 1;
+    failures.push({ name, err });
+    console.log(`  FAIL ${name}: ${err.message}`);
+  }
+}
+
+function freshStore() {
+  return createWaitlistStore({ dbPath: ':memory:' });
+}
+
+console.log('waitlist.test.js');
+
+test('POST contract: addEntry persists a tenant-scoped waitlist signup', () => {
+  const store = freshStore();
+  const entry = store.addEntry({
+    tenantId: 'acme',
+    email: 'Person@Example.COM',
+    name: 'Ada Lovelace',
+  });
+
+  assert.equal(entry.tenantId, 'acme');
+  assert.equal(entry.email, 'person@example.com');
+  assert.equal(entry.name, 'Ada Lovelace');
+  assert.match(entry.createdAt, /^\d{4}-\d{2}-\d{2}T/);
+  assert.equal(store.getStats({ tenantId: 'acme' }).total, 1);
+  store.close();
+});
+
+test('tenant scoping: the same email can join separate tenant waitlists', () => {
+  const store = freshStore();
+  store.addEntry({ tenantId: 'acme', email: 'person@example.com' });
+  store.addEntry({ tenantId: 'globex', email: 'person@example.com' });
+
+  assert.equal(store.getStats({ tenantId: 'acme' }).total, 1);
+  assert.equal(store.getStats({ tenantId: 'globex' }).total, 1);
+  store.close();
+});
+
+test('tenant scoping: duplicate email in the same tenant is rejected', () => {
+  const store = freshStore();
+  store.addEntry({ tenantId: 'acme', email: 'person@example.com' });
+
+  assert.throws(
+    () => store.addEntry({ tenantId: 'acme', email: 'person@example.com' }),
+    /already joined/i,
+  );
+  store.close();
+});
+
+test('validation: tenant id and email are validated before persistence', () => {
+  const store = freshStore();
+  assert.throws(() => store.addEntry({ tenantId: 'Bad Tenant', email: 'a@example.com' }), /tenant/i);
+  assert.throws(() => store.addEntry({ tenantId: 'acme', email: 'not-email' }), /email/i);
+  assert.throws(() => store.addEntry({ tenantId: 'acme', email: 'a@example.com', name: 'x'.repeat(121) }), /name/i);
+  store.close();
+});
+
+test('GET stats contract: empty tenant returns zero with null latestSignupAt', () => {
+  const store = freshStore();
+  assert.deepEqual(store.getStats({ tenantId: 'empty' }), {
+    tenantId: 'empty',
+    total: 0,
+    latestSignupAt: null,
+  });
+  store.close();
+});
+
+console.log(`\n${pass} passed, ${fail} failed`);
+
+if (fail > 0) {
+  for (const { name, err } of failures) {
+    console.log(`\n--- ${name} ---`);
+    console.log(err.stack || err.message);
+  }
+  process.exit(1);
+}
+
+process.exit(0);
