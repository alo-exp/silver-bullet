+:root {
+  color-scheme: light;
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  background: #f7f8fb;
+  color: #17202a;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+}
+
+.shell {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(320px, 420px);
+  gap: 40px;
+  width: min(1040px, calc(100vw - 32px));
+  min-height: 100vh;
+  align-items: center;
+  margin: 0 auto;
+  padding: 48px 0;
+}
+
+.eyebrow {
+  margin: 0 0 12px;
+  color: #236456;
+  font-size: 0.8rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0;
+}
+
+h1 {
+  margin: 0;
+  max-width: 10ch;
+  font-size: clamp(3rem, 8vw, 6.5rem);
+  line-height: 0.95;
+}
+
+.summary {
+  max-width: 540px;
+  margin: 24px 0 0;
+  color: #44515f;
+  font-size: 1.15rem;
+  line-height: 1.6;
+}
+
+.panel {
+  border: 1px solid #d8dee8;
+  border-radius: 8px;
+  background: #ffffff;
+  box-shadow: 0 18px 60px rgba(23, 32, 42, 0.12);
+  padding: 24px;
+}
+
+form {
+  display: grid;
+  gap: 16px;
+}
+
+label {
+  display: grid;
+  gap: 6px;
+  color: #344252;
+  font-size: 0.9rem;
+  font-weight: 700;
+}
+
+input {
+  width: 100%;
+  border: 1px solid #b8c3d1;
+  border-radius: 6px;
+  padding: 12px 14px;
+  color: #17202a;
+  font: inherit;
+}
+
+input:focus {
+  border-color: #236456;
+  outline: 3px solid rgba(35, 100, 86, 0.18);
+}
+
+button {
+  border: 0;
+  border-radius: 6px;
+  background: #236456;
+  color: #ffffff;
+  cursor: pointer;
+  font: inherit;
+  font-weight: 800;
+  padding: 13px 16px;
+}
+
+button:hover {
+  background: #174b40;
+}
+
+.status {
+  min-height: 24px;
+  margin: 16px 0;
+  color: #44515f;
+}
+
+.status[data-tone="success"] {
+  color: #236456;
+}
+
+.status[data-tone="error"] {
+  color: #a12a2a;
+}
+
+.stats {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 12px;
+  margin: 0;
+}
+
+.stats div {
+  border: 1px solid #e1e6ee;
+  border-radius: 6px;
+  padding: 14px;
+}
+
+dt {
+  color: #5d6b7a;
+  font-size: 0.78rem;
+  font-weight: 700;
+  text-transform: uppercase;
+}
+
+dd {
+  min-height: 28px;
+  margin: 6px 0 0;
+  font-size: 1.25rem;
+  font-weight: 800;
+}
+
+@media (max-width: 760px) {
+  .shell {
+    grid-template-columns: 1fr;
+    gap: 28px;
+    align-items: start;
+  }
+
+  h1 {
+    max-width: none;
