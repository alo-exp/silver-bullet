+FROM node:22-slim
+
+WORKDIR /app
+ENV NODE_ENV=production
+
+COPY package*.json ./
+COPY api ./api
+COPY public ./public
+
+EXPOSE 3000
+CMD ["node", "api/src/server.js"]
