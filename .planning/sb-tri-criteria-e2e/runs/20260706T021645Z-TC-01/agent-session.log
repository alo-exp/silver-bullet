diff --git a/public/app.js b/public/app.js
new file mode 100644
index 0000000000000000000000000000000000000000..9719ac76f8edf13f222159debf59ac9789d059d5
--- /dev/null
+++ b/public/app.js
@@ -0,0 +1,59 @@
+const form = document.querySelector('#waitlist-form');
+const statusEl = document.querySelector('#status');
+const totalEl = document.querySelector('#total');
+const latestEl = document.querySelector('#latest');
+const tenantEl = document.querySelector('#tenant');
+
+function tenantHeaders() {
+  return { 'x-tenant-id': tenantEl.value.trim() };
+}
+
+function setStatus(message, tone = 'neutral') {
+  statusEl.textContent = message;
+  statusEl.dataset.tone = tone;
+}
+
+async function refreshStats() {
+  const response = await fetch('/waitlist/stats', { headers: tenantHeaders() });
+  const stats = await response.json();
+  if (!response.ok) throw new Error(stats.error || 'Unable to load stats');
+  totalEl.textContent = String(stats.total);
+  latestEl.textContent = stats.latestSignupAt
+    ? new Date(stats.latestSignupAt).toLocaleString()
+    : 'None';
+}
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  setStatus('Joining...');
+  const data = new FormData(form);
+  const payload = {
+    email: String(data.get('email') || ''),
+    name: String(data.get('name') || ''),
+  };
+
+  try {
+    const response = await fetch('/waitlist', {
+      method: 'POST',
+      headers: {
+        'content-type': 'application/json',
+        ...tenantHeaders(),
+      },
+      body: JSON.stringify(payload),
+    });
+    const body = await response.json();
+    if (!response.ok) throw new Error(body.error || 'Unable to join');
+    setStatus('You are on the waitlist.', 'success');
+    form.email.value = '';
+    form.name.value = '';
+    await refreshStats();
+  } catch (err) {
+    setStatus(err.message, 'error');
+  }
+});
+
+tenantEl.addEventListener('change', () => {
+  refreshStats().catch((err) => setStatus(err.message, 'error'));
+});
+
+refreshStats().catch((err) => setStatus(err.message, 'error'));
diff --git a/public/index.html b/public/index.html
new file mode 100644
index 0000000000000000000000000000000000000000..98007fb801a75ac4c39de6823f346c8d0526776e
