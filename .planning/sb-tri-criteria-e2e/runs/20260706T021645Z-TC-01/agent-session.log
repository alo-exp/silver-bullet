new file mode 100644
index 0000000000000000000000000000000000000000..fa13fbed2a1731f05ec7d5c6037f9564a39662ea
--- /dev/null
+++ b/tests/integration/waitlist.http.test.js
@@ -0,0 +1,134 @@
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { createServer } = require('../../api/src/server');
+
+let pass = 0;
+let fail = 0;
+const failures = [];
+
+function test(name, fn) {
+  Promise.resolve()
+    .then(fn)
+    .then(() => {
+      pass += 1;
+      console.log(`  ok  ${name}`);
+    })
+    .catch((err) => {
+      fail += 1;
+      failures.push({ name, err });
+      console.log(`  FAIL ${name}: ${err.message}`);
+    });
+}
+
+function listen(server) {
+  return new Promise((resolve) => {
+    server.listen(0, '127.0.0.1', () => {
+      const { port } = server.address();
+      resolve(`http://127.0.0.1:${port}`);
+    });
+  });
+}
+
+function close(server) {
+  return new Promise((resolve, reject) => {
+    server.close((err) => {
+      try {
+        server.closeStore();
+      } catch (_err) {
+        // Test cleanup should not hide the primary close error.
+      }
+      if (err) reject(err);
+      else resolve();
+    });
+  });
+}
+
+async function withServer(fn) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'waitlist-http-'));
+  const server = createServer({
+    dbPath: path.join(dir, 'waitlist.sqlite'),
+    publicDir: path.join(__dirname, '..', '..', 'public'),
+  });
+  const baseUrl = await listen(server);
+  try {
+    await fn(baseUrl);
+  } finally {
+    await close(server);
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+console.log('waitlist.http.test.js');
+
+test('POST /waitlist and GET /waitlist/stats persist data per tenant', async () => {
+  await withServer(async (baseUrl) => {
+    const created = await fetch(`${baseUrl}/waitlist`, {
+      method: 'POST',
+      headers: {
+        'content-type': 'application/json',
+        'x-tenant-id': 'acme',
+      },
+      body: JSON.stringify({ email: 'person@example.com', name: 'Ada' }),
+    });
+
+    assert.equal(created.status, 201);
+    const entry = await created.json();
+    assert.equal(entry.tenantId, 'acme');
+    assert.equal(entry.email, 'person@example.com');
+
+    const stats = await fetch(`${baseUrl}/waitlist/stats`, {
+      headers: { 'x-tenant-id': 'acme' },
+    });
+    assert.equal(stats.status, 200);
+    assert.deepEqual(await stats.json(), {
+      tenantId: 'acme',
+      total: 1,
+      latestSignupAt: entry.createdAt,
+    });
+  });
+});
+
+test('POST /waitlist validates tenant header and JSON body', async () => {
+  await withServer(async (baseUrl) => {
+    const missingTenant = await fetch(`${baseUrl}/waitlist`, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ email: 'person@example.com' }),
+    });
+    assert.equal(missingTenant.status, 400);
+
+    const invalidEmail = await fetch(`${baseUrl}/waitlist`, {
+      method: 'POST',
+      headers: {
+        'content-type': 'application/json',
+        'x-tenant-id': 'acme',
+      },
+      body: JSON.stringify({ email: 'not-email' }),
+    });
+    assert.equal(invalidEmail.status, 400);
+  });
+});
+
+test('GET / serves the static landing page wired to waitlist API', async () => {
+  await withServer(async (baseUrl) => {
+    const response = await fetch(`${baseUrl}/`);
+    assert.equal(response.status, 200);
+    const html = await response.text();
+    assert.match(html, /Join the waitlist/);
+    assert.match(html, /app.js/);
+  });
+});
+
+process.on('beforeExit', () => {
+  console.log(`\n${pass} passed, ${fail} failed`);
+
+  if (fail > 0) {
+    for (const { name, err } of failures) {
+      console.log(`\n--- ${name} ---`);
+      console.log(err.stack || err.message);
+    }
+    process.exitCode = 1;
+  }
+});

