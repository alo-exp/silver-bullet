+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>Waitlist SaaS</title>
+    <link rel="stylesheet" href="/styles.css">
+  </head>
+  <body>
+    <main class="shell">
+      <section class="intro" aria-labelledby="page-title">
+        <p class="eyebrow">Tenant-ready launch list</p>
+        <h1 id="page-title">Join the waitlist</h1>
+        <p class="summary">A minimal SaaS signup flow backed by SQLite and scoped per tenant.</p>
+      </section>
+
+      <section class="panel" aria-label="Waitlist signup">
+        <form id="waitlist-form">
+          <label>
+            Tenant
+            <input id="tenant" name="tenant" value="demo" autocomplete="organization" required pattern="[a-z0-9][a-z0-9-]{0,63}">
+          </label>
+          <label>
+            Email
+            <input id="email" name="email" type="email" autocomplete="email" required>
+          </label>
+          <label>
+            Name
+            <input id="name" name="name" autocomplete="name" maxlength="120">
+          </label>
+          <button type="submit">Join</button>
+        </form>
+        <p id="status" class="status" role="status" aria-live="polite"></p>
+        <dl class="stats">
+          <div>
+            <dt>Total signups</dt>
+            <dd id="total">0</dd>
+          </div>
+          <div>
+            <dt>Latest signup</dt>
+            <dd id="latest">None</dd>
+          </div>
+        </dl>
+      </section>
+    </main>
+    <script src="/app.js"></script>
+  </body>
+</html>
diff --git a/public/styles.css b/public/styles.css
new file mode 100644
index 0000000000000000000000000000000000000000..a0c763f1d3822478186098c258737ebce62d9d1e
--- /dev/null
+++ b/public/styles.css
@@ -0,0 +1,153 @@
+:root {
+  color-scheme: light;
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  background: #f7f8fb;
+  color: #17202a;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+}
+
+.shell {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(320px, 420px);
+  gap: 40px;
+  width: min(1040px, calc(100vw - 32px));
+  min-height: 100vh;
+  align-items: center;
+  margin: 0 auto;
+  padding: 48px 0;
+}
+
+.eyebrow {
+  margin: 0 0 12px;
+  color: #236456;
+  font-size: 0.8rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0;
+}
+
+h1 {
+  margin: 0;
+  max-width: 10ch;
+  font-size: clamp(3rem, 8vw, 6.5rem);
+  line-height: 0.95;
+}
+
+.summary {
+  max-width: 540px;
+  margin: 24px 0 0;
+  color: #44515f;
+  font-size: 1.15rem;
+  line-height: 1.6;
+}
+
+.panel {
+  border: 1px solid #d8dee8;
+  border-radius: 8px;
+  background: #ffffff;
+  box-shadow: 0 18px 60px rgba(23, 32, 42, 0.12);
+  padding: 24px;
+}
+
+form {
+  display: grid;
+  gap: 16px;
+}
+
+label {
+  display: grid;
+  gap: 6px;
+  color: #344252;
+  font-size: 0.9rem;
+  font-weight: 700;
+}
+
+input {
+  width: 100%;
+  border: 1px solid #b8c3d1;
+  border-radius: 6px;
+  padding: 12px 14px;
+  color: #17202a;
+  font: inherit;
+}
+
+input:focus {
+  border-color: #236456;
+  outline: 3px solid rgba(35, 100, 86, 0.18);
+}
+
+button {
+  border: 0;
+  border-radius: 6px;
+  background: #236456;
+  color: #ffffff;
+  cursor: pointer;
+  font: inherit;
+  font-weight: 800;
+  padding: 13px 16px;
+}
+
+button:hover {
+  background: #174b40;
+}
+
+.status {
+  min-height: 24px;
+  margin: 16px 0;
+  color: #44515f;
+}
+
+.status[data-tone="success"] {
+  color: #236456;
+}
+
+.status[data-tone="error"] {
+  color: #a12a2a;
+}
+
+.stats {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 12px;
+  margin: 0;
+}
+
+.stats div {
+  border: 1px solid #e1e6ee;
+  border-radius: 6px;
+  padding: 14px;
+}
+
+dt {
+  color: #5d6b7a;
+  font-size: 0.78rem;
+  font-weight: 700;
+  text-transform: uppercase;
+}
+
+dd {
+  min-height: 28px;
+  margin: 6px 0 0;
+  font-size: 1.25rem;
+  font-weight: 800;
+}
+
+@media (max-width: 760px) {
+  .shell {
+    grid-template-columns: 1fr;
+    gap: 28px;
+    align-items: start;
+  }
+
+  h1 {
+    max-width: none;
+    font-size: 3.5rem;
+  }
+}
diff --git a/tests/integration/waitlist.http.test.js b/tests/integration/waitlist.http.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..fa13fbed2a1731f05ec7d5c6037f9564a39662ea
--- /dev/null
+++ b/tests/integration/waitlist.http.test.js
@@ -0,0 +1,134 @@
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { createServer } = require('../../api/src/server');
+
+let pass = 0;
+let fail = 0;
+const failures = [];
+
+function test(name, fn) {
+  Promise.resolve()
+    .then(fn)
+    .then(() => {
+      pass += 1;
+      console.log(`  ok  ${name}`);
+    })
+    .catch((err) => {
+      fail += 1;
+      failures.push({ name, err });
+      console.log(`  FAIL ${name}: ${err.message}`);
+    });
+}
+
+function listen(server) {
+  return new Promise((resolve) => {
+    server.listen(0, '127.0.0.1', () => {
+      const { port } = server.address();
+      resolve(`http://127.0.0.1:${port}`);
+    });
+  });
+}
+
+function close(server) {
+  return new Promise((resolve, reject) => {
+    server.close((err) => {
+      try {
+        server.closeStore();
+      } catch (_err) {
+        // Test cleanup should not hide the primary close error.
+      }
+      if (err) reject(err);
+      else resolve();
+    });
+  });
+}
+
+async function withServer(fn) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'waitlist-http-'));
+  const server = createServer({
+    dbPath: path.join(dir, 'waitlist.sqlite'),
+    publicDir: path.join(__dirname, '..', '..', 'public'),
+  });
+  const baseUrl = await listen(server);
+  try {
+    await fn(baseUrl);
+  } finally {
+    await close(server);
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+}
+
+console.log('waitlist.http.test.js');
