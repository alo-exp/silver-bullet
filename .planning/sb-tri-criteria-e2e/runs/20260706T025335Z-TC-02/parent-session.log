@@ -0,0 +1,117 @@
+/**
+ * Observability regression tests for the fixture HTTP wrapper.
+ *
+ * These assertions cover correlation ID propagation and structured JSON
+ * request logs without adding routes or framework dependencies.
+ */
+
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const { createJsonLogger } = require('../../api/src/observability');
+const { startServer, stopServer } = require('./server');
+
+let pass = 0;
+let fail = 0;
+const failures = [];
+const tests = [];
+
+function test(name, fn) {
+  tests.push({ name, fn });
+}
+
+function request(url, { headers = {} } = {}) {
+  return new Promise((resolve, reject) => {
+    const req = http.get(url, { headers }, (res) => {
+      const chunks = [];
+      res.on('data', (chunk) => chunks.push(chunk));
+      res.on('end', () => {
+        resolve({
+          statusCode: res.statusCode,
+          headers: res.headers,
+          body: Buffer.concat(chunks).toString('utf8'),
+        });
+      });
+    });
+    req.on('error', reject);
+  });
+}
+
+async function withServer(fn) {
+  const lines = [];
+  const logger = createJsonLogger({ sink: (line) => lines.push(line) });
+  const handle = await startServer({ logger });
+  try {
+    return await fn({ ...handle, lines });
+  } finally {
+    await stopServer(handle.server);
+  }
+}
+
+async function main() {
+  console.log('server.test.js');
+
+  test('propagates caller supplied correlation_id through response and logs', async () => {
+    await withServer(async ({ url, lines }) => {
+      const correlationId = 'tc-02-correlation-id';
+      const response = await request(`${url}/healthz`, {
+        headers: { 'x-correlation-id': correlationId },
+      });
+
+      assert.equal(response.statusCode, 200);
+      assert.equal(response.headers['x-correlation-id'], correlationId);
+      assert.equal(lines.length, 1);
+
+      const entry = JSON.parse(lines[0]);
+      assert.equal(entry.event, 'http_request');
+      assert.equal(entry.level, 'info');
+      assert.equal(entry.correlation_id, correlationId);
+      assert.equal(entry.method, 'GET');
+      assert.equal(entry.path, '/healthz');
+      assert.equal(entry.status_code, 200);
+      assert.equal(typeof entry.duration_ms, 'number');
+      assert.match(entry.timestamp, /^\d{4}-\d{2}-\d{2}T/);
+    });
+  });
+
+  test('generates a correlation_id when the caller omits one', async () => {
+    await withServer(async ({ url, lines }) => {
+      const response = await request(`${url}/__build`);
+
+      assert.equal(response.statusCode, 200);
+      assert.equal(typeof response.headers['x-correlation-id'], 'string');
+      assert.ok(response.headers['x-correlation-id'].length > 0);
+      assert.equal(lines.length, 1);
+
+      const entry = JSON.parse(lines[0]);
+      assert.equal(entry.correlation_id, response.headers['x-correlation-id']);
+      assert.equal(entry.path, '/__build');
+      assert.equal(entry.status_code, 200);
+    });
+  });
+
+  for (const { name, fn } of tests) {
+    try {
+      await fn();
+      pass += 1;
+      console.log(`  ok  ${name}`);
+    } catch (err) {
+      fail += 1;
+      failures.push({ name, err });
+      console.log(`  FAIL ${name}: ${err.message}`);
+    }
+  }
+
+  console.log(`\n${pass} passed, ${fail} failed`);
+  if (fail > 0) {
+    for (const { name, err } of failures) {
+      console.log(`\n--- ${name} ---`);
+      console.log(err.stack || err.message);
+    }
+    process.exit(1);
+  }
+}
+
+main().catch((err) => {
+  console.error(err.stack || err.message);
+  process.exit(1);
+});

