new file mode 100644
index 0000000000000000000000000000000000000000..9709aa982476b43f346584c8c2fdff080c1223f5
--- /dev/null
+++ b/api/src/observability.js
@@ -0,0 +1,85 @@
+/**
+ * Dependency-free request observability helpers.
+ *
+ * The fixture API intentionally has no framework dependency, so this module
+ * provides the small middleware-shaped surface needed by the HTTP wrapper.
+ */
+
+const crypto = require('node:crypto');
+
+const CORRELATION_ID_HEADER = 'x-correlation-id';
+const DEFAULT_LOG_LEVEL = 'info';
+
+function _headerValue(headers, name) {
+  if (!headers || typeof headers !== 'object') return undefined;
+  const direct = headers[name];
+  if (direct !== undefined) return direct;
+
+  const target = name.toLowerCase();
+  const key = Object.keys(headers).find((candidate) => candidate.toLowerCase() === target);
+  return key ? headers[key] : undefined;
+}
+
+function _firstHeaderValue(value) {
+  if (Array.isArray(value)) return value[0];
+  return value;
+}
+
+function _generateCorrelationId() {
+  if (typeof crypto.randomUUID === 'function') {
+    return crypto.randomUUID();
+  }
+  return crypto.randomBytes(16).toString('hex');
+}
+
+function resolveCorrelationId(headers = {}) {
+  const raw = _firstHeaderValue(_headerValue(headers, CORRELATION_ID_HEADER));
+  if (typeof raw === 'string' && raw.trim().length > 0) {
+    return raw.trim();
+  }
+  return _generateCorrelationId();
+}
+
+function createJsonLogger({ sink = console.log, level = DEFAULT_LOG_LEVEL } = {}) {
+  return function log(event, fields = {}) {
+    const entry = {
+      timestamp: new Date().toISOString(),
+      level,
+      event,
+      ...fields,
+    };
+    sink(JSON.stringify(entry));
+  };
+}
+
+function attachRequestObservability(req, res, { logger = createJsonLogger() } = {}) {
+  const startedAt = process.hrtime.bigint();
+  const correlationId = resolveCorrelationId(req.headers);
+
+  req.correlation_id = correlationId;
+  req.correlationId = correlationId;
+
+  if (!res.headersSent) {
+    res.setHeader(CORRELATION_ID_HEADER, correlationId);
+  }
+
+  res.once('finish', () => {
+    const durationMs = Number(process.hrtime.bigint() - startedAt) / 1e6;
+    logger('http_request', {
+      correlation_id: correlationId,
+      method: req.method || 'UNKNOWN',
+      path: (req.url || '').split('?')[0] || '/',
+      status_code: res.statusCode,
+      duration_ms: Math.round(durationMs * 1000) / 1000,
+    });
+  });
+
+  return { correlation_id: correlationId };
+}
+
+module.exports = {
+  CORRELATION_ID_HEADER,
+  attachRequestObservability,
+  createJsonLogger,
+  resolveCorrelationId,
+};
