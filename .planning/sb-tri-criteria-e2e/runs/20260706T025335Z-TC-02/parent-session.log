/**
 * Orders integration tests — multi-order scenarios across the public contract.
 *
 * Style mirrors api/src/orders.test.js (mini-runner). No test framework dep.
 *
 * These are *integration* tests (vs. the co-located unit test):
 * - Exercise createOrder + getOrder together across multiple orders.
 * - Assert the response-shape contract end-to-end (create return + get round-trip).
 * - Assert store idempotency semantics across re-creation.
 * - Assert error propagation across the public surface.
 *
 * The production store is module-level; reset between tests by clearing the
 * require.cache entry for the resolved orders path and re-requiring, so each
 * test sees a fresh in-memory Map. Production code in api/src/orders.js is
 * not modified.
 */

const assert = require('node:assert/strict');
const path = require('node:path');

const ORDERS_PATH = path.join(__dirname, '..', '..', 'api', 'src', 'orders');

function freshOrdersModule() {
  delete require.cache[require.resolve(ORDERS_PATH)];
  return require(ORDERS_PATH);
}

let pass = 0;
let fail = 0;
const failures = [];

function test(name, fn) {
  try {
    fn();
    pass += 1;
    console.log(`  ok  ${name}`);
  } catch (err) {
    fail += 1;
    failures.push({ name, err });
    console.log(`  FAIL ${name}: ${err.message}`);
  }
}

console.log('orders.integration.test.js');

// AC-2: Multi-order creation across distinct SKUs and currencies — each retrievable via getOrder.
test('AC-2: create 3 orders across distinct SKUs and currencies; each round-trips via getOrder', () => {
  const { createOrder, getOrder } = freshOrdersModule();
  const created = [
    createOrder({ sku: 'WIDGET-A', qty: 1, currency: 'EUR' }),
    createOrder({ sku: 'GADGET-B', qty: 5, currency: 'JPY' }),
    createOrder({ sku: 'GIZMO-C', qty: 12, currency: 'GBP' }),
  ];

  assert.equal(created.length, 3);
  for (const c of created) {
    const fetched = getOrder(c.id);
    assert.equal(fetched.id, c.id);
    assert.equal(fetched.sku, c.sku);
    assert.equal(fetched.qty, c.qty);
    assert.equal(fetched.currency, c.currency);
  }
});

// AC-3a: Response-shape contract on createOrder return value.
test('AC-3a: createOrder return value matches public shape contract', () => {
  const { createOrder } = freshOrdersModule();
  const order = createOrder({ sku: 'SHAPE-1', qty: 2, currency: 'CAD' });
  assert.equal(typeof order.id, 'string');
  assert.ok(order.id.length > 0);
  assert.equal(typeof order.sku, 'string');
  assert.equal(order.sku, 'SHAPE-1');
  assert.equal(typeof order.qty, 'number');
  assert.ok(Number.isInteger(order.qty));
  assert.ok(order.qty > 0);
  assert.equal(typeof order.currency, 'string');
  assert.match(order.currency, /^[A-Z]{3}$/);
});

// AC-3b: Response-shape contract preserved across getOrder round-trip.
test('AC-3b: getOrder round-trip preserves the public shape contract', () => {
  const { createOrder, getOrder } = freshOrdersModule();
  const created = createOrder({ sku: 'SHAPE-2', qty: 7, currency: 'AUD' });
  const fetched = getOrder(created.id);
  assert.equal(typeof fetched.id, 'string');
  assert.equal(typeof fetched.sku, 'string');
  assert.equal(typeof fetched.qty, 'number');
  assert.ok(Number.isInteger(fetched.qty));
  assert.equal(typeof fetched.currency, 'string');
  assert.match(fetched.currency, /^[A-Z]{3}$/);
  // Object identity aside, the two objects should have identical own properties.
  assert.deepEqual(
    Object.keys(fetched).sort(),
    Object.keys(created).sort(),
    'create and get should expose the same set of own keys',
  );
});

// AC-4a: Error propagation — getOrder for unknown id throws.
test('AC-4a: getOrder with unknown id throws', () => {
  const { getOrder } = freshOrdersModule();
  assert.throws(() => getOrder('does-not-exist'), /order not found/i);
});

// AC-4b: Error propagation — createOrder with invalid inputs throws.
test('AC-4b: createOrder propagates validation errors for invalid currency', () => {
  const { createOrder } = freshOrdersModule();
  assert.throws(
    () => createOrder({ sku: 'BAD-1', qty: 1, currency: 'usd' }),
    /invalid currency/i,
  );
});

test('AC-4c: createOrder propagates validation errors for invalid qty', () => {
  const { createOrder } = freshOrdersModule();
  assert.throws(
    () => createOrder({ sku: 'BAD-2', qty: 0 }),
    /qty/i,
  );
  assert.throws(
    () => createOrder({ sku: 'BAD-3', qty: -1 }),
    /qty/i,
  );
});

// AC-5: Store idempotency — re-creating same SKU yields a distinct ID (no dedupe by spec).
test('AC-5: re-creating the same SKU produces a distinct order id', () => {
  const { createOrder } = freshOrdersModule();
  const a = createOrder({ sku: 'DUP-1', qty: 1, currency: 'USD' });
  const b = createOrder({ sku: 'DUP-1', qty: 1, currency: 'USD' });
  assert.notEqual(a.id, b.id, 'no dedupe — second create must yield a new id');
  assert.equal(a.sku, b.sku);
});

console.log(`\n${pass} passed, ${fail} failed`);

if (fail > 0) {
  for (const { name, err } of failures) {
    console.log(`\n--- ${name} ---`);
    console.log(err.stack || err.message);

