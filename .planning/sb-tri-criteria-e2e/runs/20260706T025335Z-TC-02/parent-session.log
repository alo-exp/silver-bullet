skills_to_record=()
if [[ -n "$raw_skill" ]]; then
  skills_to_record+=("$raw_skill")
elif { [[ "$tool_name" == "Bash" ]] || { declare -f sb_tool_is_shell_like >/dev/null 2>&1 && sb_tool_is_shell_like "$tool_name"; }; }; then
  adapter_skill="$(extract_invoke_skill_adapter_skill "$cmd")"
