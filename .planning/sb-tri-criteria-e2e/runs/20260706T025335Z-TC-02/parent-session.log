/**
 * Minimal API health endpoint for smoke verification.
 *
 * Returns `{ status, service, version }`. Accepts an optional
 * `versionSource` callable so callers can wire in their own version
 * discovery (env var, package.json read, build manifest, etc.) without
 * coupling this module to a specific source.
 *
 * If `versionSource` is omitted or yields a non-string / empty value,
 * the endpoint falls back to `'0.0.0-unknown'` rather than throwing —
 * this is the fix for the bug where a missing version produced a 500.
 */

const FALLBACK_VERSION = '0.0.0-unknown';
const SERVICE_NAME = 'enterprise-grade-test-app-api';

function _resolveVersion(versionSource) {
  if (typeof versionSource !== 'function') return FALLBACK_VERSION;
  let raw;
  try {
    raw = versionSource();
  } catch (_err) {
    return FALLBACK_VERSION;
  }
  if (typeof raw !== 'string' || raw.length === 0) return FALLBACK_VERSION;
  return raw;
}

function health(options = {}) {
  const { versionSource } = options;
  return {
    status: 'ok',
    service: SERVICE_NAME,
    version: _resolveVersion(versionSource),
  };
}

module.exports = { health, FALLBACK_VERSION };
 succeeded in 0ms:
/**
 * Minimal HTTP server for the /healthz benchmark.
 *
 * - Wraps the production api/src/health.js module (no production-code changes).
 * - Serves GET /healthz as 200 application/json with the health() payload.
 * - Serves GET /__version and GET /__build for the matrix report.
 * - Listens on a caller-supplied port (default 0 = ephemeral).
 *
 * The server is intentionally dependency-free (node:http only) so the
 * benchmark measures the application code, not a framework.
 */

const http = require('node:http');
const { health } = require('../../api/src/health');

function startServer({ port = 0, host = '127.0.0.1', version = '0.1.0-bench' } = {}) {
  const versionSource = () => process.env.APP_VERSION || version;
  const baseHealth = () => health({ versionSource });

  const server = http.createServer((req, res) => {
    if (!req.url) {
      res.writeHead(400).end();
      return;
    }
    const path = req.url.split('?')[0];

    if (req.method === 'GET' && path === '/healthz') {
      const payload = baseHealth();
      const body = JSON.stringify(payload);
      res.writeHead(200, {
        'content-type': 'application/json; charset=utf-8',
        'content-length': Buffer.byteLength(body),
        'x-service': payload.service,
      });
      res.end(body);
      return;
    }

    if (req.method === 'GET' && path === '/__build') {
      const body = JSON.stringify({
        node: process.version,
        platform: process.platform,
        arch: process.arch,
        pid: process.pid,
        uptime_s: Math.round(process.uptime() * 1000) / 1000,
      });
      res.writeHead(200, { 'content-type': 'application/json' });
      res.end(body);
      return;
    }

    res.writeHead(404, { 'content-type': 'text/plain' });
    res.end('not found');
  });

  return new Promise((resolve, reject) => {
    server.once('error', reject);
    server.listen(port, host, () => {
      const addr = server.address();
      resolve({
        server,
        host: addr.address,
        port: addr.port,
        url: `http://${addr.address}:${addr.port}`,
      });
    });
  });
}

function stopServer(server) {
  return new Promise((resolve, reject) => {
    if (!server || !server.listening) return resolve();
    server.close((err) => (err ? reject(err) : resolve()));
  });
}

module.exports = { startServer, stopServer };

if (require.main === module) {
  // Allow `node tests/benchmarks/server.js [port]` to launch a standalone server
  // for ad-hoc curl checks.
  const port = Number(process.argv[2] || 0);
  startServer({ port }).then(({ url }) => {
    console.log(`bench server listening at ${url}/healthz`);
  });
}

