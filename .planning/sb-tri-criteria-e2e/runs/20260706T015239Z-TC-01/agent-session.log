const assert = require('assert');
const fs = require('fs');
const http = require('http');
const os = require('os');
const path = require('path');
const { createServer } = require('../../api/src/server');

function request(port, method, pathName, options = {}) {
  const body = options.body ? JSON.stringify(options.body) : '';
  const headers = {
    ...(options.tenantId ? { 'x-tenant-id': options.tenantId } : {}),
    ...(body ? { 'content-type': 'application/json', 'content-length': Buffer.byteLength(body) } : {}),
  };

  return new Promise((resolve, reject) => {
    const req = http.request({ port, method, path: pathName, headers }, (res) => {
      let data = '';
      res.on('data', (chunk) => {
        data += chunk;
      });
      res.on('end', () => {
        resolve({
          statusCode: res.statusCode,
          body: data ? JSON.parse(data) : null,
        });
      });
    });
    req.on('error', reject);
    if (body) req.write(body);
    req.end();
  });
}

async function withServer(fn) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'waitlist-http-'));
  const server = createServer({ dbPath: path.join(dir, 'waitlist.sqlite') });
  await new Promise((resolve) => server.listen(0, resolve));
  try {
    await fn(server.address().port);
  } finally {
    await new Promise((resolve) => server.close(resolve));
    fs.rmSync(dir, { recursive: true, force: true });
  }
}

async function test(name, fn) {
  try {
    await fn();
    console.log(`ok - ${name}`);
  } catch (err) {
    console.error(`not ok - ${name}`);
    console.error(err);
    process.exit(1);
  }
}

(async () => {
  await test('POST /waitlist and GET /waitlist/stats isolate tenants by x-tenant-id', async () => {
    await withServer(async (port) => {
      const acmeCreate = await request(port, 'POST', '/waitlist', {
        tenantId: 'acme',
        body: { email: 'founder@example.com', name: 'Founder' },
      });
      const betaCreate = await request(port, 'POST', '/waitlist', {
        tenantId: 'beta',
        body: { email: 'founder@example.com' },
      });
      const duplicate = await request(port, 'POST', '/waitlist', {
        tenantId: 'acme',
        body: { email: 'FOUNDER@example.com' },
      });
      const acmeStats = await request(port, 'GET', '/waitlist/stats', { tenantId: 'acme' });
      const betaStats = await request(port, 'GET', '/waitlist/stats', { tenantId: 'beta' });

      assert.strictEqual(acmeCreate.statusCode, 201);
      assert.strictEqual(betaCreate.statusCode, 201);
      assert.strictEqual(duplicate.statusCode, 200);
      assert.strictEqual(duplicate.body.status, 'exists');
      assert.strictEqual(acmeStats.body.total, 1);
      assert.strictEqual(betaStats.body.total, 1);
      assert.strictEqual(acmeStats.body.tenant_id, 'acme');
      assert.strictEqual(betaStats.body.tenant_id, 'beta');
    });
  });

  await test('waitlist API rejects invalid tenant and email', async () => {
    await withServer(async (port) => {
      const missingTenant = await request(port, 'POST', '/waitlist', {
        body: { email: 'valid@example.com' },
      });
      const badEmail = await request(port, 'POST', '/waitlist', {
        tenantId: 'acme',
        body: { email: 'invalid' },
      });

      assert.strictEqual(missingTenant.statusCode, 400);
      assert.match(missingTenant.body.error, /tenant_id/);
      assert.strictEqual(badEmail.statusCode, 400);
      assert.match(badEmail.body.error, /email/);
    });
  });

  console.log('waitlist HTTP integration tests ok');
})();

