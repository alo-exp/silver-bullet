const fs = require('fs');
const http = require('http');
const path = require('path');
const { health } = require('./health');
const { createWaitlistStore } = require('./waitlist');

const DEFAULT_PORT = 3000;
const UI_PATH = path.resolve(__dirname, '../../ui/index.html');

function sendJson(res, statusCode, payload) {
  const body = JSON.stringify(payload);
  res.writeHead(statusCode, {
    'content-type': 'application/json; charset=utf-8',
    'content-length': Buffer.byteLength(body),
  });
  res.end(body);
}

function sendHtml(res, statusCode, body) {
  res.writeHead(statusCode, {
    'content-type': 'text/html; charset=utf-8',
    'content-length': Buffer.byteLength(body),
  });
  res.end(body);
}

function readJsonBody(req) {
  return new Promise((resolve, reject) => {
    let body = '';
    req.on('data', (chunk) => {
      body += chunk;
      if (body.length > 64 * 1024) {
        reject(new Error('request body too large'));
        req.destroy();
      }
    });
    req.on('end', () => {
      if (body.length === 0) {
        resolve({});
        return;
      }
      try {
        resolve(JSON.parse(body));
      } catch (_err) {
        reject(new Error('request body must be valid JSON'));
      }
    });
    req.on('error', reject);
  });
}

function tenantFromHeader(req) {
  const value = req.headers['x-tenant-id'];
  return Array.isArray(value) ? value[0] : value;
}

function createServer(options = {}) {
  const store = options.store || createWaitlistStore({ dbPath: options.dbPath });

  const server = http.createServer(async (req, res) => {
    const url = new URL(req.url, 'http://localhost');

    try {
      if (req.method === 'GET' && url.pathname === '/') {
        sendHtml(res, 200, fs.readFileSync(UI_PATH, 'utf8'));
        return;
      }

      if (req.method === 'GET' && url.pathname === '/health') {
        sendJson(res, 200, health({ versionSource: () => process.env.APP_VERSION }));
        return;
      }

      if (req.method === 'POST' && url.pathname === '/waitlist') {
        const payload = await readJsonBody(req);
        const result = store.addEntry({
          tenantId: tenantFromHeader(req),
          email: payload.email,
          name: payload.name,
          source: payload.source || 'landing-page',
        });
        sendJson(res, result.created ? 201 : 200, {
          status: result.created ? 'created' : 'exists',
          entry: result.entry,
        });
        return;
      }

      if (req.method === 'GET' && url.pathname === '/waitlist/stats') {
        sendJson(res, 200, store.stats({ tenantId: tenantFromHeader(req) }));
        return;
      }

      sendJson(res, 404, { error: 'not found' });
    } catch (err) {
      sendJson(res, 400, { error: err.message });
    }
  });

  server.on('close', () => {
    if (!options.store && store && typeof store.close === 'function') {
      store.close();
    }
  });

  return server;
}

if (require.main === module) {
  const port = Number(process.env.PORT || DEFAULT_PORT);
  const server = createServer();
  server.listen(port, () => {
    console.log(`waitlist service listening on http://localhost:${port}`);
  });
}

module.exports = { createServer };

