/**
 * Admin UI — App shell.
 *
 * Renders the smoke UI surface, API version badge, and waitlist form shape.
 * The static landing page wired to the API lives in ui/index.html; this JSX
 * remains descriptive for the no-bundler fixture while preserving the tested
 * badge contract from ui/src/badge.js.
 *
 * Default versionSource reads the project root package.json `version` field
 * lazily at render time. If the read fails, badge.js falls back to
 * "0.0.0-unknown" (matching api/src/health.js FALLBACK_VERSION).
 */

import { getBadgeMarkup } from './badge.js';

function _readPackageVersion() {
  try {
    // `require` is intentional — the project ships CommonJS throughout.
    // In a real React project this would be `import` or a build-time
    // resolved constant.
    const pkg = require('../../package.json');
    return pkg && typeof pkg.version === 'string' ? pkg.version : undefined;
  } catch (_err) {
    return undefined;
  }
}

function Badge() {
  return getBadgeMarkup({ versionSource: _readPackageVersion });
}

export default function App() {
  return (
    <main data-testid="smoke-ui">
      <h1>Enterprise Grade Test App</h1>
      <p>Runtime smoke UI for Silver Bullet workflow validation.</p>
      <form action="/waitlist" method="post">
        <label htmlFor="tenant">Tenant</label>
        <input id="tenant" name="tenant" defaultValue="acme" />
        <label htmlFor="email">Email</label>
        <input id="email" name="email" type="email" required />
        <button type="submit">Join Waitlist</button>
      </form>
      <Badge />
    </main>
  );
}

