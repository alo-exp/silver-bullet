const assert = require('assert');
const fs = require('fs');
const os = require('os');
const path = require('path');
const { createWaitlistStore } = require('./waitlist');

function withStore(fn) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'waitlist-unit-'));
  const store = createWaitlistStore({ dbPath: path.join(dir, 'waitlist.sqlite') });
  try {
    fn(store);
  } finally {
    store.close();
    fs.rmSync(dir, { recursive: true, force: true });
  }
}

function test(name, fn) {
  try {
    fn();
    console.log(`ok - ${name}`);
  } catch (err) {
    console.error(`not ok - ${name}`);
    console.error(err);
    process.exit(1);
  }
}

test('stores waitlist entries per tenant', () => withStore((store) => {
  const acme = store.addEntry({ tenantId: 'acme', email: 'USER@example.com', name: 'User' });
  const beta = store.addEntry({ tenantId: 'beta', email: 'user@example.com' });

  assert.strictEqual(acme.created, true);
  assert.strictEqual(beta.created, true);
  assert.strictEqual(acme.entry.email, 'user@example.com');
  assert.strictEqual(store.stats({ tenantId: 'acme' }).total, 1);
  assert.strictEqual(store.stats({ tenantId: 'beta' }).total, 1);
}));

test('duplicates are tenant-scoped and do not increase stats', () => withStore((store) => {
  const first = store.addEntry({ tenantId: 'acme', email: 'dupe@example.com' });
  const second = store.addEntry({ tenantId: 'acme', email: 'DUPE@example.com' });

  assert.strictEqual(first.created, true);
  assert.strictEqual(second.created, false);
  assert.strictEqual(first.entry.id, second.entry.id);
  assert.strictEqual(store.stats({ tenantId: 'acme' }).total, 1);
}));

test('validates tenant and email input', () => withStore((store) => {
  assert.throws(
    () => store.addEntry({ tenantId: 'bad tenant', email: 'valid@example.com' }),
    /tenant_id/,
  );
  assert.throws(
    () => store.addEntry({ tenantId: 'acme', email: 'not-an-email' }),
    /email/,
  );
}));

console.log('waitlist unit tests ok');

