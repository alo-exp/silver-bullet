        font: inherit;
      }

      button {
        min-height: 44px;
        border: 0;
        border-radius: 6px;
        background: #155eef;
        color: #ffffff;
        font: inherit;
        font-weight: 800;
        cursor: pointer;
      }

      output {
        min-height: 24px;
        color: #1f6f43;
        font-weight: 700;
      }

      .status {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .metric {
        display: grid;
        gap: 4px;
      }

      .metric strong {
        font-size: 1.6rem;
      }

      @media (max-width: 640px) {
        .row,
        .status {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Incident-Ready Waitlist</h1>
      <p>Tenant-scoped signups backed by SQLite. Use the tenant field to verify isolated stats.</p>

      <form id="waitlist-form">
        <div class="row">
          <label>
            Tenant
            <input id="tenant" name="tenant" value="acme" autocomplete="organization" required>
          </label>
          <label>
            Email
            <input id="email" name="email" type="email" placeholder="founder@example.com" autocomplete="email" required>
          </label>
        </div>
        <label>
          Name
          <input id="name" name="name" autocomplete="name" placeholder="Optional">
        </label>
        <button type="submit">Join Waitlist</button>
        <output id="message" role="status"></output>
      </form>

      <section class="status" aria-label="Waitlist stats">
        <div class="metric">
          <span>Tenant</span>
          <strong id="stats-tenant">acme</strong>
        </div>
        <div class="metric">
          <span>Signups</span>
          <strong id="stats-total">0</strong>
        </div>
      </section>
    </main>

    <script>
      const form = document.querySelector('#waitlist-form');
      const tenantInput = document.querySelector('#tenant');
      const message = document.querySelector('#message');
      const statsTenant = document.querySelector('#stats-tenant');
      const statsTotal = document.querySelector('#stats-total');

      async function refreshStats() {
        const tenantId = tenantInput.value.trim();
        const res = await fetch('/waitlist/stats', { headers: { 'x-tenant-id': tenantId } });
        const payload = await res.json();
        if (!res.ok) throw new Error(payload.error || 'Unable to load stats');
        statsTenant.textContent = payload.tenant_id;
        statsTotal.textContent = String(payload.total);
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        message.textContent = '';
        const formData = new FormData(form);
        const tenantId = String(formData.get('tenant')).trim();
        const payload = {
          email: formData.get('email'),
          name: formData.get('name'),
          source: 'landing-page',
        };

        try {
          const res = await fetch('/waitlist', {
            method: 'POST',
            headers: {
              'content-type': 'application/json',
              'x-tenant-id': tenantId,
            },
            body: JSON.stringify(payload),
          });
          const body = await res.json();
          if (!res.ok) throw new Error(body.error || 'Unable to join waitlist');
          message.textContent = body.status === 'created' ? 'Added to waitlist.' : 'Already on this tenant waitlist.';
          await refreshStats();
        } catch (err) {
          message.textContent = err.message;
        }
      });

      tenantInput.addEventListener('change', () => {
        refreshStats().catch((err) => {
          message.textContent = err.message;
        });
      });

      refreshStats().catch(() => {});
    </script>
  </body>
</html>

