const fs = require('fs');
const path = require('path');
const Database = require('better-sqlite3');

const DEFAULT_DB_PATH = path.resolve(__dirname, '../../data/waitlist.sqlite');
const TENANT_PATTERN = /^[a-zA-Z0-9][a-zA-Z0-9_-]{1,63}$/;
const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

function normalizeTenant(tenantId) {
  if (typeof tenantId !== 'string') {
    throw new Error('tenant_id must be provided as a string');
  }
  const trimmed = tenantId.trim();
  if (!TENANT_PATTERN.test(trimmed)) {
    throw new Error('tenant_id must be 2-64 characters using letters, numbers, underscore, or dash');
  }
  return trimmed;
}

function normalizeEmail(email) {
  if (typeof email !== 'string') {
    throw new Error('email must be provided as a string');
  }
  const normalized = email.trim().toLowerCase();
  if (normalized.length > 254 || !EMAIL_PATTERN.test(normalized)) {
    throw new Error('email must be a valid address');
  }
  return normalized;
}

function optionalText(value, fieldName) {
  if (value === undefined || value === null || value === '') return null;
  if (typeof value !== 'string') {
    throw new Error(`${fieldName} must be a string when provided`);
  }
  const trimmed = value.trim();
  if (trimmed.length > 120) {
    throw new Error(`${fieldName} must be 120 characters or fewer`);
  }
  return trimmed.length === 0 ? null : trimmed;
}

function ensureDirectory(dbPath) {
  if (dbPath === ':memory:') return;
  fs.mkdirSync(path.dirname(dbPath), { recursive: true });
}

function createWaitlistStore(options = {}) {
  const dbPath = options.dbPath || process.env.WAITLIST_DB_PATH || DEFAULT_DB_PATH;
  ensureDirectory(dbPath);
  const db = new Database(dbPath);
  db.pragma('journal_mode = WAL');
  db.exec(`
    CREATE TABLE IF NOT EXISTS waitlist_entries (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      tenant_id TEXT NOT NULL,
      email TEXT NOT NULL,
      name TEXT,
      source TEXT,
      created_at TEXT NOT NULL,
      updated_at TEXT NOT NULL,
      UNIQUE (tenant_id, email)
    );
    CREATE INDEX IF NOT EXISTS idx_waitlist_entries_tenant_created
      ON waitlist_entries (tenant_id, created_at);
  `);

  const selectEntry = db.prepare(`
    SELECT id, tenant_id, email, name, source, created_at, updated_at
    FROM waitlist_entries
    WHERE tenant_id = ? AND email = ?
  `);
  const insertEntry = db.prepare(`
    INSERT INTO waitlist_entries (tenant_id, email, name, source, created_at, updated_at)
    VALUES (?, ?, ?, ?, ?, ?)
  `);
  const statsByTenant = db.prepare(`
    SELECT COUNT(*) AS total, MAX(created_at) AS latest_signup_at
    FROM waitlist_entries
    WHERE tenant_id = ?
  `);

  function addEntry(input = {}) {
    const tenantId = normalizeTenant(input.tenantId);
    const email = normalizeEmail(input.email);
    const name = optionalText(input.name, 'name');
    const source = optionalText(input.source, 'source');
    const existing = selectEntry.get(tenantId, email);

    if (existing) {
      return { created: false, entry: existing };
    }

    const now = new Date().toISOString();
    const result = insertEntry.run(tenantId, email, name, source, now, now);
    return {
      created: true,
      entry: {
        id: result.lastInsertRowid,
        tenant_id: tenantId,
        email,
        name,
        source,
        created_at: now,
        updated_at: now,
      },
    };
  }

  function stats(input = {}) {
    const tenantId = normalizeTenant(input.tenantId);
    const row = statsByTenant.get(tenantId);
    return {
      tenant_id: tenantId,
      total: Number(row.total || 0),
      latest_signup_at: row.latest_signup_at || null,
    };
  }

  return {
    addEntry,
    stats,
    close: () => db.close(),
  };
}

module.exports = {
  createWaitlistStore,
  normalizeTenant,
  normalizeEmail,
};

