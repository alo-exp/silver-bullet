+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>Enterprise Waitlist</title>
+    <link rel="stylesheet" href="/styles.css">
+  </head>
+  <body>
+    <main class="shell">
+      <section class="hero" aria-labelledby="waitlist-title">
+        <p class="eyebrow">Private beta</p>
+        <h1 id="waitlist-title">Join the enterprise waitlist</h1>
+        <p class="lede">Request early access for your tenant workspace.</p>
+
+        <form id="waitlist-form" data-testid="waitlist-form" data-api-endpoint="/waitlist">
+          <label>
+            Tenant
