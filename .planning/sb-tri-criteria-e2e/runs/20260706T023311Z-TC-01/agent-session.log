+services:
+  waitlist:
+    image: node:22-alpine
+    working_dir: /app
+    command: npm start
+    environment:
+      NODE_ENV: development
+      PORT: "3000"
+      WAITLIST_DB_PATH: /data/waitlist.sqlite
+    ports:
+      - "3000:3000"
