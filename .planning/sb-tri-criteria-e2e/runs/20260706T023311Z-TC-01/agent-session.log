+  color: #4d5c68;
+  font-size: 1.1rem;
+}
+
+form {
+  display: grid;
+  gap: 14px;
+}
+
+label {
+  display: grid;
+  gap: 6px;
+  font-weight: 700;
+}
+
+input {
+  width: 100%;
+  border: 1px solid #c8d2dc;
+  border-radius: 6px;
+  padding: 12px;
+  font: inherit;
+  background: #fff;
+}
+
+button {
+  min-height: 46px;
+  border: 0;
+  border-radius: 6px;
+  padding: 0 18px;
+  font: inherit;
+  font-weight: 800;
+  color: #fff;
