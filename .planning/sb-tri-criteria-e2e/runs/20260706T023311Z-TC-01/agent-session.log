@@ -0,0 +1,149 @@
+/**
+ * Minimal stdlib HTTP server for the fixture API and static waitlist page.
+ */
+
+'use strict';
+
+const fs = require('node:fs');
+const http = require('node:http');
+const path = require('node:path');
+const { health } = require('./health');
+const { ValidationError, getWaitlistStore } = require('./waitlist');
+
+const DEFAULT_PORT = 3000;
+const MAX_BODY_BYTES = 16 * 1024;
+const PUBLIC_DIR = path.join(__dirname, '..', '..', 'public');
+
+const MIME_TYPES = {
+  '.css': 'text/css; charset=utf-8',
+  '.html': 'text/html; charset=utf-8',
+  '.js': 'application/javascript; charset=utf-8',
+};
+
+function _sendJson(res, statusCode, payload) {
+  const body = JSON.stringify(payload);
+  res.writeHead(statusCode, {
+    'Content-Type': 'application/json; charset=utf-8',
+    'Content-Length': Buffer.byteLength(body),
+    'Cache-Control': 'no-store',
+    'X-Content-Type-Options': 'nosniff',
+    'X-Frame-Options': 'DENY',
+    'Content-Security-Policy': "default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self'",
+  });
+  res.end(body);
+}
+
+function _sendStatic(req, res) {
+  const url = new URL(req.url, 'http://localhost');
+  const requestedPath = url.pathname === '/' ? '/index.html' : url.pathname;
+  const absolutePath = path.resolve(PUBLIC_DIR, '.' + requestedPath);
+  if (!absolutePath.startsWith(PUBLIC_DIR + path.sep)) {
+    _sendJson(res, 404, { error: 'not_found' });
+    return true;
+  }
+  if (!fs.existsSync(absolutePath) || !fs.statSync(absolutePath).isFile()) {
+    return false;
+  }
+
+  const ext = path.extname(absolutePath);
+  const body = fs.readFileSync(absolutePath);
+  res.writeHead(200, {
+    'Content-Type': MIME_TYPES[ext] || 'application/octet-stream',
+    'Content-Length': body.length,
+    'Cache-Control': 'no-store',
+    'X-Content-Type-Options': 'nosniff',
+    'X-Frame-Options': 'DENY',
+    'Content-Security-Policy': "default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self'",
+  });
+  res.end(body);
+  return true;
+}
+
+function _readJsonBody(req) {
+  return new Promise((resolve, reject) => {
+    let size = 0;
+    let raw = '';
+    req.setEncoding('utf8');
+    req.on('data', (chunk) => {
+      size += Buffer.byteLength(chunk);
+      if (size > MAX_BODY_BYTES) {
+        reject(new ValidationError('request body is too large'));
+        req.destroy();
+        return;
+      }
+      raw += chunk;
+    });
+    req.on('end', () => {
+      if (raw.length === 0) {
+        resolve({});
+        return;
+      }
+      try {
+        resolve(JSON.parse(raw));
+      } catch (_err) {
+        reject(new ValidationError('request body must be valid JSON'));
+      }
+    });
+    req.on('error', reject);
+  });
+}
+
+function createServer(options = {}) {
+  const store = options.store || getWaitlistStore({ dbPath: options.dbPath });
+
+  return http.createServer(async (req, res) => {
+    const url = new URL(req.url, 'http://localhost');
+
+    try {
+      if (req.method === 'GET' && url.pathname === '/health') {
+        _sendJson(res, 200, health({ versionSource: () => process.env.APP_VERSION }));
+        return;
+      }
+
+      if (req.method === 'POST' && url.pathname === '/waitlist') {
+        const body = await _readJsonBody(req);
+        const entry = store.addEntry({
+          tenantId: req.headers['x-tenant-id'],
+          email: body.email,
+          name: body.name,
+        });
+        _sendJson(res, 201, { entry });
+        return;
+      }
+
+      if (req.method === 'GET' && url.pathname === '/waitlist/stats') {
+        const stats = store.getStats({ tenantId: req.headers['x-tenant-id'] });
+        _sendJson(res, 200, stats);
+        return;
+      }
+
+      if (req.method === 'GET' && _sendStatic(req, res)) {
+        return;
+      }
+
+      _sendJson(res, 404, { error: 'not_found' });
+    } catch (err) {
+      const statusCode = err && err.statusCode ? err.statusCode : 500;
+      const message = statusCode >= 500 ? 'internal_server_error' : err.message;
+      _sendJson(res, statusCode, { error: message });
+    }
+  });
+}
+
+function start(options = {}) {
+  const port = Number(options.port || process.env.PORT || DEFAULT_PORT);
+  const server = createServer(options);
+  server.listen(port, () => {
+    console.log(`waitlist api listening on http://localhost:${port}`);
+  });
+  return server;
+}
+
+if (require.main === module) {
+  start();
+}
+
+module.exports = {
+  createServer,
+  start,
+};
diff --git a/api/src/waitlist.js b/api/src/waitlist.js
new file mode 100644
index 0000000000000000000000000000000000000000..d36167e974b26086559d944be18b78acd3681f5a
--- /dev/null
+++ b/api/src/waitlist.js
@@ -0,0 +1,156 @@
+/**
+ * Tenant-scoped waitlist persistence backed by SQLite.
+ *
+ * Public endpoints are intentionally anonymous for a pre-launch waitlist, but
+ * every operation must provide an explicit X-Tenant-Id so rows and stats are
+ * isolated by tenant.
+ */
+
+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+const { DatabaseSync } = require('node:sqlite');
+
+const DEFAULT_DB_PATH = path.join(process.cwd(), 'data', 'waitlist.sqlite');
+const TENANT_PATTERN = /^[a-z0-9][a-z0-9_-]{1,62}$/;
+const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+const MAX_EMAIL_LENGTH = 254;
+const MAX_NAME_LENGTH = 120;
+
+let singletonStore;
+
+class ValidationError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'ValidationError';
+    this.statusCode = 400;
+  }
+}
+
+function _normalizeTenantId(tenantId) {
+  if (typeof tenantId !== 'string') {
+    throw new ValidationError('X-Tenant-Id header is required');
+  }
+  const normalized = tenantId.trim().toLowerCase();
+  if (!TENANT_PATTERN.test(normalized)) {
+    throw new ValidationError('X-Tenant-Id must be 2-63 chars: lowercase letters, numbers, _ or -');
+  }
+  return normalized;
+}
+
+function _normalizeEmail(email) {
+  if (typeof email !== 'string') {
+    throw new ValidationError('email is required');
+  }
+  const normalized = email.trim().toLowerCase();
+  if (
+    normalized.length === 0 ||
+    normalized.length > MAX_EMAIL_LENGTH ||
+    !EMAIL_PATTERN.test(normalized)
+  ) {
+    throw new ValidationError('email must be a valid email address');
+  }
+  return normalized;
+}
+
+function _normalizeName(name) {
+  if (name == null || name === '') return null;
+  if (typeof name !== 'string') {
+    throw new ValidationError('name must be a string');
+  }
+  const normalized = name.trim();
+  if (normalized.length === 0) return null;
+  if (normalized.length > MAX_NAME_LENGTH) {
+    throw new ValidationError('name must be 120 characters or fewer');
+  }
+  return normalized;
+}
+
+function _ensureDbDir(dbPath) {
+  if (dbPath === ':memory:') return;
+  fs.mkdirSync(path.dirname(dbPath), { recursive: true });
+}
+
+function _toPublicRow(row) {
+  return {
+    id: row.id,
+    tenantId: row.tenant_id,
+    email: row.email,
+    name: row.name || null,
+    createdAt: row.created_at,
+  };
+}
+
+class WaitlistStore {
+  constructor(options = {}) {
+    const dbPath = options.dbPath || process.env.WAITLIST_DB_PATH || DEFAULT_DB_PATH;
+    _ensureDbDir(dbPath);
+    this.dbPath = dbPath;
+    this.db = new DatabaseSync(dbPath);
+    this._init();
+  }
+
+  _init() {
+    this.db.exec(`
+      CREATE TABLE IF NOT EXISTS waitlist_entries (
+        id INTEGER PRIMARY KEY AUTOINCREMENT,
+        tenant_id TEXT NOT NULL,
+        email TEXT NOT NULL,
+        name TEXT,
+        created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
+        UNIQUE (tenant_id, email)
+      );
+      CREATE INDEX IF NOT EXISTS idx_waitlist_entries_tenant
+        ON waitlist_entries (tenant_id);
+    `);
+  }
+
+  addEntry({ tenantId, email, name } = {}) {
+    const safeTenantId = _normalizeTenantId(tenantId);
+    const safeEmail = _normalizeEmail(email);
+    const safeName = _normalizeName(name);
+
+    const insert = this.db.prepare(`
+      INSERT INTO waitlist_entries (tenant_id, email, name)
+      VALUES (?, ?, ?)
+      ON CONFLICT(tenant_id, email) DO UPDATE SET
+        name = COALESCE(excluded.name, waitlist_entries.name)
+      RETURNING id, tenant_id, email, name, created_at
+    `);
+
+    const row = insert.get(safeTenantId, safeEmail, safeName);
+    return _toPublicRow(row);
+  }
+
+  getStats({ tenantId } = {}) {
+    const safeTenantId = _normalizeTenantId(tenantId);
+    const row = this.db
+      .prepare('SELECT COUNT(*) AS total FROM waitlist_entries WHERE tenant_id = ?')
+      .get(safeTenantId);
+    return {
+      tenantId: safeTenantId,
+      total: Number(row.total || 0),
+    };
+  }
+
+  close() {
+    this.db.close();
+  }
+}
+
+function getWaitlistStore(options = {}) {
+  if (options.dbPath) return new WaitlistStore(options);
+  if (!singletonStore) {
+    singletonStore = new WaitlistStore(options);
+  }
+  return singletonStore;
+}
+
+module.exports = {
+  EMAIL_PATTERN,
+  TENANT_PATTERN,
+  ValidationError,
+  WaitlistStore,
+  getWaitlistStore,
+};
diff --git a/api/src/waitlist.test.js b/api/src/waitlist.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..530efa588d8f6cd66812a855b8fff0f8b4f5d20c
--- /dev/null
+++ b/api/src/waitlist.test.js
@@ -0,0 +1,105 @@
+const assert = require('node:assert/strict');
+const { WaitlistStore, ValidationError } = require('./waitlist');
+
+let pass = 0;
+let fail = 0;
+const failures = [];
+
+function test(name, fn) {
+  try {
+    fn();
+    pass += 1;
+    console.log(`  ok  ${name}`);
+  } catch (err) {
+    fail += 1;
+    failures.push({ name, err });
+    console.log(`  FAIL ${name}: ${err.message}`);
+  }
+}
+
+function withStore(fn) {
+  const store = new WaitlistStore({ dbPath: ':memory:' });
+  try {
+    fn(store);
+  } finally {
+    store.close();
+  }
+}
+
+console.log('waitlist.test.js');
+
+test('POST contract: addEntry stores a normalized tenant-scoped email', () => {
+  withStore((store) => {
+    const entry = store.addEntry({
+      tenantId: 'Acme-1',
+      email: ' ALICE@EXAMPLE.COM ',
+      name: 'Alice',
+    });
+
+    assert.equal(entry.tenantId, 'acme-1');
+    assert.equal(entry.email, 'alice@example.com');
+    assert.equal(entry.name, 'Alice');
+    assert.equal(typeof entry.id, 'number');
+    assert.match(entry.createdAt, /^\d{4}-\d{2}-\d{2}T/);
+  });
+});
+
+test('GET stats contract: counts entries only for the requested tenant', () => {
+  withStore((store) => {
+    store.addEntry({ tenantId: 'alpha', email: 'one@example.com' });
+    store.addEntry({ tenantId: 'alpha', email: 'two@example.com' });
+    store.addEntry({ tenantId: 'beta', email: 'one@example.com' });
+
+    assert.deepEqual(store.getStats({ tenantId: 'alpha' }), {
+      tenantId: 'alpha',
+      total: 2,
+    });
+    assert.deepEqual(store.getStats({ tenantId: 'beta' }), {
+      tenantId: 'beta',
+      total: 1,
+    });
+  });
+});
+
+test('addEntry is idempotent per tenant/email without crossing tenant boundaries', () => {
+  withStore((store) => {
+    const first = store.addEntry({ tenantId: 'alpha', email: 'dupe@example.com' });
+    const second = store.addEntry({ tenantId: 'alpha', email: 'dupe@example.com', name: 'Updated' });
+    const third = store.addEntry({ tenantId: 'beta', email: 'dupe@example.com' });
+
+    assert.equal(second.id, first.id);
+    assert.equal(second.name, 'Updated');
+    assert.notEqual(third.id, first.id);
+    assert.equal(store.getStats({ tenantId: 'alpha' }).total, 1);
+    assert.equal(store.getStats({ tenantId: 'beta' }).total, 1);
+  });
+});
+
+test('validation rejects missing tenant, bad tenant and bad email', () => {
+  withStore((store) => {
+    assert.throws(
+      () => store.addEntry({ email: 'ok@example.com' }),
+      ValidationError,
+    );
+    assert.throws(
+      () => store.addEntry({ tenantId: '../bad', email: 'ok@example.com' }),
+      /X-Tenant-Id/i,
+    );
+    assert.throws(
+      () => store.addEntry({ tenantId: 'alpha', email: 'not-email' }),
+      /email/i,
+    );
+  });
+});
+
+console.log(`\n${pass} passed, ${fail} failed`);
+
+if (fail > 0) {
+  for (const { name, err } of failures) {
+    console.log(`\n--- ${name} ---`);
+    console.log(err.stack || err.message);
+  }
+  process.exit(1);
+}
+
+process.exit(0);
