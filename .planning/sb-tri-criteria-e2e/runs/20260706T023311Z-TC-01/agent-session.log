diff --git a/public/app.js b/public/app.js
new file mode 100644
index 0000000000000000000000000000000000000000..179b61dbd32c585fecd659df78e970cb53c173e8
--- /dev/null
+++ b/public/app.js
@@ -0,0 +1,56 @@
+(function () {
+  'use strict';
+
+  const form = document.getElementById('waitlist-form');
+  const message = document.getElementById('message');
+  const count = document.getElementById('waitlist-count');
+
+  function tenantId() {
+    return String(form.elements.tenantId.value || '').trim().toLowerCase();
+  }
+
+  async function refreshStats() {
+    const tenant = tenantId();
+    if (!tenant) return;
+    const res = await fetch('/waitlist/stats', {
+      headers: { 'X-Tenant-Id': tenant },
+    });
+    if (!res.ok) return;
+    const stats = await res.json();
+    count.textContent = String(stats.total);
+  }
+
+  form.addEventListener('submit', async function (event) {
+    event.preventDefault();
+    message.textContent = 'Submitting...';
+
+    const body = {
+      email: form.elements.email.value,
+      name: form.elements.name.value,
+    };
+
+    try {
+      const res = await fetch('/waitlist', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+          'X-Tenant-Id': tenantId(),
+        },
+        body: JSON.stringify(body),
+      });
+      const payload = await res.json();
+      if (!res.ok) {
+        throw new Error(payload.error || 'Unable to join waitlist');
+      }
+      message.textContent = 'You are on the waitlist.';
+      form.elements.email.value = '';
+      form.elements.name.value = '';
+      await refreshStats();
+    } catch (err) {
+      message.textContent = err.message;
+    }
+  });
+
+  form.elements.tenantId.addEventListener('change', refreshStats);
+  refreshStats();
+})();
