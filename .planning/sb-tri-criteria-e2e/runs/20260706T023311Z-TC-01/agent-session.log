 succeeded in 0ms:
/**
 * Admin UI — version badge.
 *
 * Pure functions, no I/O, safe to import from Node. No browser globals.
 *
 * The "API version" surfaced in the badge comes from a caller-injected
 * `versionSource` callable. The default source falls back to the project
 * root `package.json` `version` field. Mirrors the `_resolveVersion`
 * pattern in api/src/health.js.
 *
 * Contract (see .planning/UI-CONTRACT-ui-badge.md):
 *   - BADGE_LABEL        — visible prefix, e.g. "API v"
 *   - FALLBACK_VERSION   — "0.0.0-unknown" (mirrored from api/src/health.js
 *                          so the badge has zero coupling at runtime, but
 *                          the literal value is identical)
 *   - getBadgeText({ versionSource })
 *                        — returns "API v{version}"; never throws
 *   - getBadgeMarkup({ versionSource })
 *                        — returns a span string with data-testid, role,
 *                          aria-label, and the visible text
 */

'use strict';

const BADGE_LABEL = 'API v';
const FALLBACK_VERSION = '0.0.0-unknown';
const TESTID = 'api-version-badge';
const ROLE = 'note';
const MAX_MARKUP_LENGTH = 256;

function _defaultVersionSource() {
  // Avoid `require` at module load to keep the module side-effect free.
  // If a caller wants the package.json version, they pass it in.
  return FALLBACK_VERSION;
}

function _resolveVersion(versionSource) {
  if (typeof versionSource !== 'function') return FALLBACK_VERSION;
  let raw;
  try {
    raw = versionSource();
  } catch (_err) {
    return FALLBACK_VERSION;
  }
  if (typeof raw !== 'string' || raw.length === 0) return FALLBACK_VERSION;
  return raw;
}

function getBadgeText(options) {
  const opts = options || {};
  const version = _resolveVersion(opts.versionSource || _defaultVersionSource);
  return BADGE_LABEL + version;
}

function _escapeAttribute(value) {
  // Defensive: version strings can in principle contain `"` (extremely rare,
  // but trivially possible if someone bumps a build with a quoted tag).
  // Replace `"` with `&quot;` to keep the attribute well-formed.
  return String(value).replace(/"/g, '&quot;');
}

function getBadgeMarkup(options) {
  const text = getBadgeText(options);
  const version = text.slice(BADGE_LABEL.length);
  const safeLabel = _escapeAttribute('API version ' + version);
  const safeText = _escapeAttribute(text);

  const markup =
    '<span ' +
    'data-testid="' + TESTID + '" ' +
    'role="' + ROLE + '" ' +
    'aria-label="' + safeLabel + '"' +
    '>' +
    safeText +
    '</span>';

  // Defensive: never exceed the per-viewport budget. The contract is
  // < 256 chars; if a caller ever injects an absurdly long version string
  // we still produce a stable, truncated-but-readable badge.
  if (markup.length >= MAX_MARKUP_LENGTH) {
    const truncated = (text.length > 200 ? text.slice(0, 200) + '…' : text);
    return (
      '<span ' +
      'data-testid="' + TESTID + '" ' +
      'role="' + ROLE + '" ' +
      'aria-label="' + _escapeAttribute('API version ' + version) + '"' +
      '>' +
      _escapeAttribute(truncated) +
      '</span>'
    );
  }
  return markup;
}

module.exports = {
  BADGE_LABEL,
  FALLBACK_VERSION,
  MAX_MARKUP_LENGTH,
  getBadgeText,
  getBadgeMarkup,
};

