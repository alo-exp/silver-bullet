diff --git a/public/app.js b/public/app.js
new file mode 100644
index 0000000000000000000000000000000000000000..179b61dbd32c585fecd659df78e970cb53c173e8
--- /dev/null
+++ b/public/app.js
@@ -0,0 +1,56 @@
+(function () {
+  'use strict';
+
+  const form = document.getElementById('waitlist-form');
+  const message = document.getElementById('message');
+  const count = document.getElementById('waitlist-count');
+
+  function tenantId() {
+    return String(form.elements.tenantId.value || '').trim().toLowerCase();
+  }
+
+  async function refreshStats() {
+    const tenant = tenantId();
+    if (!tenant) return;
+    const res = await fetch('/waitlist/stats', {
+      headers: { 'X-Tenant-Id': tenant },
+    });
+    if (!res.ok) return;
+    const stats = await res.json();
+    count.textContent = String(stats.total);
+  }
+
+  form.addEventListener('submit', async function (event) {
+    event.preventDefault();
+    message.textContent = 'Submitting...';
+
+    const body = {
+      email: form.elements.email.value,
+      name: form.elements.name.value,
+    };
+
+    try {
+      const res = await fetch('/waitlist', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+          'X-Tenant-Id': tenantId(),
+        },
+        body: JSON.stringify(body),
+      });
+      const payload = await res.json();
+      if (!res.ok) {
+        throw new Error(payload.error || 'Unable to join waitlist');
+      }
+      message.textContent = 'You are on the waitlist.';
+      form.elements.email.value = '';
+      form.elements.name.value = '';
+      await refreshStats();
+    } catch (err) {
+      message.textContent = err.message;
+    }
+  });
+
+  form.elements.tenantId.addEventListener('change', refreshStats);
+  refreshStats();
+})();
diff --git a/public/index.html b/public/index.html
new file mode 100644
index 0000000000000000000000000000000000000000..486d3d9d1e12e3119cf9e74bd7cb259d66bb7b0c
--- /dev/null
+++ b/public/index.html
@@ -0,0 +1,38 @@
+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>Enterprise Waitlist</title>
+    <link rel="stylesheet" href="/styles.css">
+  </head>
+  <body>
+    <main class="shell">
+      <section class="hero" aria-labelledby="waitlist-title">
+        <p class="eyebrow">Private beta</p>
+        <h1 id="waitlist-title">Join the enterprise waitlist</h1>
+        <p class="lede">Request early access for your tenant workspace.</p>
+
+        <form id="waitlist-form" data-testid="waitlist-form" data-api-endpoint="/waitlist">
+          <label>
+            Tenant
+            <input name="tenantId" autocomplete="organization" required pattern="[A-Za-z0-9_-]{2,63}" value="demo-tenant">
+          </label>
+          <label>
+            Work email
+            <input name="email" type="email" autocomplete="email" required placeholder="you@example.com">
+          </label>
+          <label>
+            Name
+            <input name="name" autocomplete="name" maxlength="120" placeholder="Optional">
+          </label>
+          <button type="submit">Join waitlist</button>
+        </form>
+
+        <p id="message" role="status" aria-live="polite"></p>
+        <p class="stats">Tenant waitlist count: <strong id="waitlist-count">0</strong></p>
+      </section>
+    </main>
+    <script src="/app.js"></script>
+  </body>
+</html>
