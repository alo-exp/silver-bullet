diff --git a/tests/integration/waitlist.integration.test.js b/tests/integration/waitlist.integration.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..f1802b809f48458db6e84e592b276e6ba957247e
--- /dev/null
+++ b/tests/integration/waitlist.integration.test.js
@@ -0,0 +1,122 @@
+const assert = require('node:assert/strict');
+const { once } = require('node:events');
+const { createServer } = require('../../api/src/server');
+const { WaitlistStore } = require('../../api/src/waitlist');
+
+let pass = 0;
+let fail = 0;
+const failures = [];
+
+async function test(name, fn) {
+  try {
+    await fn();
+    pass += 1;
+    console.log(`  ok  ${name}`);
+  } catch (err) {
+    fail += 1;
+    failures.push({ name, err });
+    console.log(`  FAIL ${name}: ${err.message}`);
+  }
+}
+
+async function withServer(fn) {
+  const store = new WaitlistStore({ dbPath: ':memory:' });
+  const server = createServer({ store });
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+  const { port } = server.address();
+  try {
+    await fn(`http://127.0.0.1:${port}`);
+  } finally {
+    await new Promise((resolve) => server.close(resolve));
+    store.close();
+  }
+}
+
+async function requestJson(url, options = {}) {
+  const res = await fetch(url, {
+    ...options,
+    headers: {
+      'content-type': 'application/json',
+      ...(options.headers || {}),
+    },
+  });
+  const body = await res.json();
+  return { res, body };
+}
+
+console.log('waitlist.integration.test.js');
+
+(async () => {
+  await test('POST /waitlist and GET /waitlist/stats are tenant scoped', async () => {
+    await withServer(async (baseUrl) => {
+      const post = await requestJson(`${baseUrl}/waitlist`, {
+        method: 'POST',
+        headers: { 'x-tenant-id': 'alpha' },
+        body: JSON.stringify({ email: 'person@example.com', name: 'Person' }),
+      });
+      assert.equal(post.res.status, 201);
+      assert.equal(post.body.entry.tenantId, 'alpha');
+      assert.equal(post.body.entry.email, 'person@example.com');
+
+      await requestJson(`${baseUrl}/waitlist`, {
+        method: 'POST',
+        headers: { 'x-tenant-id': 'beta' },
+        body: JSON.stringify({ email: 'person@example.com' }),
+      });
+
+      const alpha = await requestJson(`${baseUrl}/waitlist/stats`, {
+        headers: { 'x-tenant-id': 'alpha' },
+      });
+      const beta = await requestJson(`${baseUrl}/waitlist/stats`, {
+        headers: { 'x-tenant-id': 'beta' },
+      });
+
+      assert.equal(alpha.res.status, 200);
+      assert.deepEqual(alpha.body, { tenantId: 'alpha', total: 1 });
+      assert.deepEqual(beta.body, { tenantId: 'beta', total: 1 });
+    });
+  });
+
+  await test('waitlist endpoints reject missing tenant and invalid body', async () => {
+    await withServer(async (baseUrl) => {
+      const missingTenant = await requestJson(`${baseUrl}/waitlist`, {
+        method: 'POST',
+        body: JSON.stringify({ email: 'person@example.com' }),
+      });
+      assert.equal(missingTenant.res.status, 400);
+      assert.match(missingTenant.body.error, /X-Tenant-Id/i);
+
+      const invalidEmail = await requestJson(`${baseUrl}/waitlist`, {
+        method: 'POST',
+        headers: { 'x-tenant-id': 'alpha' },
+        body: JSON.stringify({ email: 'not-email' }),
+      });
+      assert.equal(invalidEmail.res.status, 400);
+      assert.match(invalidEmail.body.error, /email/i);
+    });
+  });
+
+  await test('GET / serves the static waitlist landing page', async () => {
+    await withServer(async (baseUrl) => {
+      const res = await fetch(`${baseUrl}/`);
+      const body = await res.text();
+      assert.equal(res.status, 200);
+      assert.match(res.headers.get('content-type'), /text\/html/);
+      assert.match(body, /data-testid="waitlist-form"/);
+      assert.match(body, /\/waitlist/);
+    });
+  });
+
+  console.log(`\n${pass} passed, ${fail} failed`);
+
+  if (fail > 0) {
+    for (const { name, err } of failures) {
+      console.log(`\n--- ${name} ---`);
+      console.log(err.stack || err.message);
+    }
+    process.exit(1);
+  }
+
+  process.exit(0);
+})();

