const { health } = require('./health');

// 1. Existing smoke assertion — health endpoint returns ok status.
if (health().status !== 'ok') {
  console.error('health check failed');
  process.exit(1);
}

// 2. Regression test for SB bugfix-health (workflow 20260629T003704Z-803b1e-silver-bugfix):
//    health endpoint MUST surface a `version` field and MUST NOT throw
//    when the version source (e.g. APP_VERSION env var) is missing.
//    Previously the endpoint returned 500 in this case.
const _healthWithVersion = health({ versionSource: () => undefined });
if (_healthWithVersion.status !== 'ok') {
  console.error('health check failed (missing version path)');
  process.exit(1);
}
if (typeof _healthWithVersion.version !== 'string' || _healthWithVersion.version.length === 0) {
  console.error('health payload must include a non-empty string `version` even when source is missing');
  process.exit(1);
}

// 3. When a version source is provided, the surfaced version must match it.
const _healthExplicit = health({ versionSource: () => '9.9.9-test' });
if (_healthExplicit.version !== '9.9.9-test') {
  console.error(`health version mismatch — expected 9.9.9-test, got ${_healthExplicit.version}`);
  process.exit(1);
}

console.log('api health ok');
