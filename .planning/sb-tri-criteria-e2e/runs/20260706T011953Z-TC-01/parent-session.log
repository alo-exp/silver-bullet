const http = require('http');
const { health } = require('./health');
const {
  isWaitlistPost,
  isWaitlistStatsGet,
  handleWaitlistPost,
  handleWaitlistStatsGet,
} = require('./api-waitlist');

const JSON_CONTENT_TYPE = 'application/json; charset=utf-8';

function sendJson(res, statusCode, body) {
  res.statusCode = statusCode;
  res.setHeader('Content-Type', JSON_CONTENT_TYPE);
  res.end(JSON.stringify(body));
}

function handleRequest(req, res) {
  if (req.method === 'GET' && req.url === '/health') {
    sendJson(res, 200, health());
    return;
  }

  if (isWaitlistPost(req)) {
    handleWaitlistPost(req, res).catch(() => sendJson(res, 500, { error: 'internal server error' }));
    return;
  }

  if (isWaitlistStatsGet(req)) {
    handleWaitlistStatsGet(req, res);
    return;
  }

  sendJson(res, 404, { error: 'not found' });
}

function createServer() {
  return http.createServer(handleRequest);
}

function startServer(options = {}) {
  const port = Number.isInteger(options.port) ? options.port : 0;
  const server = createServer();
  return new Promise((resolve, reject) => {
    server.once('error', reject);
    server.listen(port, () => {
      const address = server.address();
      resolve({ server, port: typeof address === 'object' && address ? address.port : port });
    });
  });
}

function stopServer(server) {
  return new Promise((resolve, reject) => {
    server.close((err) => (err ? reject(err) : resolve()));
  });
}

module.exports = {
  createServer,
  handleRequest,
  startServer,
  stopServer,
};

