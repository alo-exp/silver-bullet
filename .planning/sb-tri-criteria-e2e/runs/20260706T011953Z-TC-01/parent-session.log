const fs = require('fs');
const path = require('path');
const { DatabaseSync } = require('node:sqlite');

const DEFAULT_DB_PATH = path.join(__dirname, '..', 'data', 'waitlist.sqlite');

function resolveDbPath(customPath) {
  return customPath || process.env.WAITLIST_DB_PATH || DEFAULT_DB_PATH;
}

function ensureSchema(db) {
  db.exec(`
    CREATE TABLE IF NOT EXISTS waitlist_entries (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      tenant_id TEXT NOT NULL,
      email TEXT NOT NULL,
      created_at TEXT NOT NULL DEFAULT (datetime('now')),
      UNIQUE(tenant_id, email)
    );
    CREATE INDEX IF NOT EXISTS idx_waitlist_tenant ON waitlist_entries(tenant_id);
  `);
}

function openWaitlistDb(dbPath) {
  const resolved = resolveDbPath(dbPath);
  fs.mkdirSync(path.dirname(resolved), { recursive: true });
  const db = new DatabaseSync(resolved);
  ensureSchema(db);
  return db;
}

function addWaitlistEntry(db, { tenantId, email }) {
  if (!tenantId || typeof tenantId !== 'string') {
    throw new TypeError('tenant_id is required');
  }
  if (!email || typeof email !== 'string' || !email.includes('@')) {
    throw new TypeError('valid email is required');
  }
  const stmt = db.prepare(
    'INSERT INTO waitlist_entries (tenant_id, email) VALUES (?, ?) RETURNING id, tenant_id, email, created_at'
  );
  try {
    return stmt.get(tenantId.trim(), email.trim().toLowerCase());
  } catch (err) {
    if (String(err.message || '').includes('UNIQUE')) {
      const existing = db.prepare(
        'SELECT id, tenant_id, email, created_at FROM waitlist_entries WHERE tenant_id = ? AND email = ?'
      ).get(tenantId.trim(), email.trim().toLowerCase());
      if (existing) return existing;
    }
    throw err;
  }
}

function getWaitlistStats(db, tenantId) {
  if (!tenantId || typeof tenantId !== 'string') {
    throw new TypeError('tenant_id is required');
  }
  const row = db.prepare(
    'SELECT COUNT(*) AS total FROM waitlist_entries WHERE tenant_id = ?'
  ).get(tenantId.trim());
  return { tenant_id: tenantId.trim(), total: row ? row.total : 0 };
}

function closeWaitlistDb(db) {
  if (db && typeof db.close === 'function') {
    db.close();
  }
}

module.exports = {
  DEFAULT_DB_PATH,
  openWaitlistDb,
  addWaitlistEntry,
  getWaitlistStats,
  closeWaitlistDb,
};

