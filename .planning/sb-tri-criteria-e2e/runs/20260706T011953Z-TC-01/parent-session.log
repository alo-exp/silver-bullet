const assert = require('assert');
const fs = require('fs');
const os = require('os');
const path = require('path');
const http = require('http');
const { startServer, stopServer } = require('./api-server');

const tmpDb = path.join(os.tmpdir(), `waitlist-test-${process.pid}.sqlite`);

function request(port, method, urlPath, body, headers = {}) {
  return new Promise((resolve, reject) => {
    const payload = body ? JSON.stringify(body) : '';
    const req = http.request(
      {
        hostname: '127.0.0.1',
        port,
        path: urlPath,
        method,
        headers: {
          'Content-Type': 'application/json',
          'Content-Length': Buffer.byteLength(payload),
          ...headers,
        },
      },
      (res) => {
        const chunks = [];
        res.on('data', (c) => chunks.push(c));
        res.on('end', () => {
          const text = Buffer.concat(chunks).toString('utf8');
          let parsed = text;
          try {
            parsed = JSON.parse(text);
          } catch (_err) {
            /* keep raw */
          }
          resolve({ status: res.statusCode, body: parsed });
        });
      }
    );
    req.on('error', reject);
    if (payload) req.write(payload);
    req.end();
  });
}

async function run() {
  process.env.WAITLIST_DB_PATH = tmpDb;
  const { server, port } = await startServer({ port: 0 });
  try {
    const post = await request(port, 'POST', '/waitlist', { email: 'a@example.com' }, {
      'X-Tenant-Id': 'tenant-a',
    });
    assert.strictEqual(post.status, 201);
    assert.strictEqual(post.body.entry.email, 'a@example.com');

    const stats = await request(port, 'GET', '/waitlist/stats?tenant_id=tenant-a', null);
    assert.strictEqual(stats.status, 200);
    assert.strictEqual(stats.body.total, 1);

    const dup = await request(port, 'POST', '/waitlist', { email: 'a@example.com' }, {
      'X-Tenant-Id': 'tenant-a',
    });
    assert.strictEqual(dup.status, 201);

    const stats2 = await request(port, 'GET', '/waitlist/stats?tenant_id=tenant-a', null);
    assert.strictEqual(stats2.body.total, 1);
    console.log('api-waitlist.test.js: PASS');
  } finally {
    await stopServer(server);
    fs.rmSync(tmpDb, { force: true });
    delete process.env.WAITLIST_DB_PATH;
  }
}

run().catch((err) => {
  console.error(err);
  process.exit(1);
});

