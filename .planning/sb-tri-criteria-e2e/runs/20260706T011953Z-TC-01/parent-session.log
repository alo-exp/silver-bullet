const { URL } = require('url');
const {
  openWaitlistDb,
  addWaitlistEntry,
  getWaitlistStats,
  closeWaitlistDb,
} = require('./waitlist-store');

const WAITLIST_PATH = '/waitlist';
const WAITLIST_STATS_PATH = '/waitlist/stats';
const JSON_CONTENT_TYPE = 'application/json; charset=utf-8';
const MAX_BODY_BYTES = 16 * 1024;

function sendJson(res, statusCode, body) {
  res.statusCode = statusCode;
  res.setHeader('Content-Type', JSON_CONTENT_TYPE);
  res.end(JSON.stringify(body));
}

function parseTenantId(req) {
  const header = req.headers['x-tenant-id'];
  if (typeof header === 'string' && header.trim()) {
    return header.trim();
  }
  try {
    const url = new URL(req.url, 'http://localhost');
    const queryTenant = url.searchParams.get('tenant_id');
    if (queryTenant && queryTenant.trim()) {
      return queryTenant.trim();
    }
  } catch (_err) {
    /* ignore malformed URL */
  }
  return '';
}

function readRequestBody(req, maxBytes = MAX_BODY_BYTES) {
  return new Promise((resolve, reject) => {
    const chunks = [];
    let size = 0;
    req.on('data', (chunk) => {
      size += chunk.length;
      if (size > maxBytes) {
        reject(new TypeError('payload too large'));
        return;
      }
      chunks.push(chunk);
    });
    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));
    req.on('error', reject);
  });
}

function isWaitlistPost(req) {
  return req && req.method === 'POST' && req.url && req.url.split('?')[0] === WAITLIST_PATH;
}

function isWaitlistStatsGet(req) {
  return req && req.method === 'GET' && req.url && req.url.split('?')[0] === WAITLIST_STATS_PATH;
}

async function handleWaitlistPost(req, res, options = {}) {
  const tenantId = parseTenantId(req);
  if (!tenantId) {
    sendJson(res, 400, { error: 'tenant_id required via X-Tenant-Id header or query' });
    return;
  }
  let body;
  try {
    body = JSON.parse(await readRequestBody(req));
  } catch (_err) {
    sendJson(res, 400, { error: 'invalid JSON body' });
    return;
  }
  const db = openWaitlistDb(options.dbPath);
  try {
    const entry = addWaitlistEntry(db, { tenantId, email: body.email });
    sendJson(res, 201, { ok: true, entry });
  } catch (err) {
    sendJson(res, 400, { error: err.message || 'invalid waitlist entry' });
  } finally {
    closeWaitlistDb(db);
  }
}

function handleWaitlistStatsGet(req, res, options = {}) {
  const tenantId = parseTenantId(req);
  if (!tenantId) {
    sendJson(res, 400, { error: 'tenant_id required via X-Tenant-Id header or query' });
    return;
  }
  const db = openWaitlistDb(options.dbPath);
  try {
    sendJson(res, 200, getWaitlistStats(db, tenantId));
  } catch (err) {
    sendJson(res, 400, { error: err.message || 'stats error' });
  } finally {
    closeWaitlistDb(db);
  }
}

module.exports = {
  WAITLIST_PATH,
  WAITLIST_STATS_PATH,
  isWaitlistPost,
  isWaitlistStatsGet,
  handleWaitlistPost,
  handleWaitlistStatsGet,
};

