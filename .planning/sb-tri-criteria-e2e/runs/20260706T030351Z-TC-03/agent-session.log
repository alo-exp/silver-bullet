write_receipt() {
  local raw_skill="$1"
  local canonical_skill="$2"
  local skill_file="$3"
  local receipt_dir="${SB_RUNTIME_STATE_DIR:-${HOME}/.codex/.silver-bullet}/skill-invocations"
  local timestamp receipt_file script_real cwd_real

  if [[ -L "$receipt_dir" ]]; then
    printf 'ERROR: refusing to write invocation receipt through symlinked directory: %s\n' "$receipt_dir" >&2
    return 1
  fi
  mkdir -p "$receipt_dir"

  timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  receipt_file="${receipt_dir}/${canonical_skill}.$(date +%s).$$.${RANDOM}.json"
  script_real="$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve())' "$SCRIPT_PATH")"
  cwd_real="$(python3 -c 'import pathlib; print(pathlib.Path.cwd().resolve())')"

  python3 - "$receipt_file" "$raw_skill" "$canonical_skill" "$skill_file" "$script_real" "$cwd_real" "$timestamp" <<'PY'
import json
import pathlib
import sys
import time

receipt_path = pathlib.Path(sys.argv[1])
payload = {
    "channel": "silver-bullet.invoke-skill",
    "status": "loaded",
    "raw_skill": sys.argv[2],
    "canonical_skill": sys.argv[3],
    "skill_file": str(pathlib.Path(sys.argv[4]).resolve()),
    "script": sys.argv[5],
    "cwd": sys.argv[6],
    "timestamp": sys.argv[7],
    "timestamp_epoch": int(time.time()),
}
receipt_path.write_text(json.dumps(payload, sort_keys=True) + "\n")
PY
}

