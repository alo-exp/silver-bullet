+#!/usr/bin/env node
+
+const path = require("path");
+
+const generatedAt =
+  process.env.SB_POSTURE_AUDIT_TIMESTAMP || new Date().toISOString();
+
+const repoRoot = process.env.SB_POSTURE_AUDIT_REPO || process.cwd();
+
+const manifest = {
+  manifestVersion: "2026-07-06.tc-03",
+  kind: "sb-posture-audit",
+  generatedAt,
+  repository: {
+    root: path.resolve(repoRoot),
+    fixture: "enterprise-grade-test-app",
+  },
+  artifacts: {
+    compliance: ".planning/compliance/SB-POSTURE-AUDIT.md",
+    workflow: ".planning/workflows/WF-POSTURE-AUDIT.md",
+  },
+  dispatch: {
+    workflowId: "WF-POSTURE-AUDIT",
+    mode: "net-new-workflow-dispatch",
+    emittedBy: "scripts/replay-posture-audit.js",
+    lifecycleChainsInvoked: false,
+  },
+  hooks: [
+    {
+      name: "bare-prompt-router",
+      event: "PreToolUse",
+      posture: "enforce",
+      evidence: "unrouted non-trivial prompts are intercepted before repo mutation",
+    },
+    {
+      name: "delivery-gate",
+      event: "Stop",
+      posture: "enforce",
+      evidence: "final reporting requires implementation, verification, and commit evidence",
+    },
+    {
+      name: "context-window-protection",
+      event: "PreToolUse",
+      posture: "advisory",
+      evidence: "bulk analysis is routed through indexed or derived-output tools",
+    },
+  ],
+  checks: [
+    {
+      id: "branch-confirmed",
+      status: "expected",
+      detail:
+        "feature/tri-codex-tc-03-20260706t030351z-tc-03 is the required fixture branch",
+    },
+    {
+      id: "artifact-bundle-present",
+      status: "expected",
+      detail: "script, compliance page, and workflow artifact are committed together",
+    },
+    {
+      id: "no-enterprise-matrix-env",
+      status: "expected",
+      detail: "SB_E2E_ENTERPRISE_MATRIX is not set by this replay harness",
+    },
+  ],
+};
+
+const compact = process.argv.includes("--compact");
+
+process.stdout.write(JSON.stringify(manifest, null, compact ? 0 : 2));
+process.stdout.write("\n");

