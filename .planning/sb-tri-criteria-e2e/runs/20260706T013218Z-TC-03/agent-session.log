#!/usr/bin/env bash
# Cold replay verification for SB posture audit bundle.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AUDIT="${ROOT}/scripts/sb-compliance-posture-audit.sh"
REPORT="${ROOT}/.planning/compliance/posture-audit-report.md"
WF="${ROOT}/.planning/workflows/WF-POSTURE-AUDIT.md"

fail() { echo "FAIL: $*" >&2; exit 1; }

[[ -x "$AUDIT" ]] || fail "missing executable $AUDIT"
[[ -f "$REPORT" ]] || fail "missing $REPORT"
[[ -f "$WF" ]] || fail "missing $WF"

manifest="$("$AUDIT")"
echo "$manifest" | jq -e '.project_root and .generated_at and (.hooks | type == "array")' >/dev/null \
  || fail "manifest JSON invalid"

echo "PASS: posture audit bundle replay verified"
echo "$manifest" | jq -c '{hooks: (.hooks | length), recommended_tools: (.recommended_tools | keys | length)}'

