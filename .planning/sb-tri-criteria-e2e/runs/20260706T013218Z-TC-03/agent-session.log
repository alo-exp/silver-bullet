#!/usr/bin/env bash
# Emit hook manifest JSON for SB posture audit bundle (live replay).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SB_JSON="${ROOT}/.silver-bullet.json"
GRAPHIFY_STAMP="${ROOT}/graphify-out/.last-update"

hooks=()
if [[ -f "${ROOT}/hooks/hooks.json" ]]; then
  while IFS= read -r name; do
    [[ -n "$name" ]] && hooks+=("$name")
  done < <(jq -r '.hooks[]?.name // empty' "${ROOT}/hooks/hooks.json" 2>/dev/null || true)
fi

recommended_tools="{}"
if [[ -f "$SB_JSON" ]]; then
  recommended_tools="$(jq -c '.recommended_tools // {}' "$SB_JSON" 2>/dev/null || echo '{}')"
fi

graphify_updated_at=null
if [[ -f "$GRAPHIFY_STAMP" ]]; then
  graphify_updated_at="$(cat "$GRAPHIFY_STAMP" 2>/dev/null | tr -d '\n' || echo null)"
fi

jq -n \
  --arg root "$ROOT" \
  --argjson hooks "$(printf '%s\n' "${hooks[@]:-}" | jq -R -s 'split("\n") | map(select(length>0))')" \
  --argjson recommended_tools "$recommended_tools" \
  --arg graphify "$graphify_updated_at" \
  '{
    generated_at: (now | todateiso8601),
    project_root: $root,
    hooks: $hooks,
    recommended_tools: $recommended_tools,
    graphify_updated_at: (if $graphify == "null" or $graphify == "" then null else $graphify end)
  }'

