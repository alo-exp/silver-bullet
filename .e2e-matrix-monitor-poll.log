  import json, os, subprocess, time, re
  from datetime import datetime, timezone
  
  SB = "/Users/shafqat/projects/silver-bullet/repo"
  MAX_ELAPSED_SEC = 45 * 60
  CHECKPOINT_EVERY = 5
  
  def alive(pid):
      try: os.kill(int(pid), 0); return "ALIVE"
      except: return "DEAD"
  
  def driver_elapsed_sec():
      try:
          out = subprocess.check_output(["ps","-p","9520","-o","etime="], text=True).strip()
          # formats: MM:SS, HH:MM:SS, or DD-HH:MM:SS
          if "-" in out:
              d, rest = out.split("-", 1)
              h, m, s = map(int, rest.split(":"))
              return int(d)*86400 + h*3600 + m*60 + s
          parts = out.split(":")
          if len(parts)==2:
              m, s = map(int, parts); return m*60+s
          h, m, s = map(int, parts); return h*3600+m*60+s
      except: return 0
  
  def get_expect():
      except: return "none"
  
  def new_run_row6():
      force = open(f"{SB}/.e2e-matrix-round6-force.log").read()
      clean = re.sub(r'\x1b\[[0-9;]*[a-zA-Z]', '', force)
      markers = [m.start() for m in re.finditer(r"=== Enterprise E2E Matrix Runner ===", clean)]
      nr = clean[markers[-1]:] if markers else clean
      blocks = re.findall(r"=== Row 6:[\s\S]*?(?==== Row |=== Matrix summary|$)", nr)
      block = blocks[-1] if blocks else ""
      ev = "PASS: evidence" in block
      out_fail = "FAIL: outcome" in block
      fails = list(dict.fromkeys(re.findall(r"OUTCOME-FAIL: (OUT-[A-Z0-9-]+)", block)))
      return {"done": ev or out_fail, "evPass": ev, "outFail": out_fail, "outPass": ev and not out_fail, "fails": fails}
  
  def snapshot(cycle, prev_kb):
