      pass_count = pm.group(1) if pm else "18"
      
      offset = json.load(open(f"{SB}/.planning/enterprise-e2e/.tui-monitor-agent-offset.json"))
      findings = open(f"{SB}/.e2e-tui-watch-findings.jsonl").read().strip().split("\n")
      new_f = findings[offset.get("findings_line",0):]
      
      tail = re.sub(r'\x1b\[[0-9;]*[a-zA-Z]', '', force[-6000:])
      outcome_fails = list(dict.fromkeys(re.findall(r"OUTCOME-FAIL: (OUT-[A-Z0-9-]+)", tail)))
      
      # row completion in tail
