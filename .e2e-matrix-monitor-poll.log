  import json, os, subprocess, time, re
  from datetime import datetime, timezone
  
  SB = "/Users/shafqat/projects/silver-bullet/repo"
  ROWS = [6,7,8,11]
  SLUGS = {6:'silver-fast',7:'silver-test',8:'silver-refactor',11:'silver-devops'}
  CHECKPOINT_EVERY = 5
  
  def alive(pid):
      try: os.kill(int(pid), 0); return "ALIVE"
      except: return "DEAD"
  
  def find_pids():
      driver = open(f"{SB}/.e2e-live-test.lock").read().strip() if os.path.isfile(f"{SB}/.e2e-live-test.lock") else "none"
      batch = "none"
      try:
              if "matrix.sh" in line and "monitor" not in line:
                  batch = line.split()[0]; break
      except: pass
      except: expect = "none"
      return driver, batch, expect
  
  def new_run_text():
      force = open(f"{SB}/.e2e-matrix-round6-force.log").read()
      clean = re.sub(r'\x1b\[[0-9;]*[a-zA-Z]', '', force)
      markers = [m.start() for m in re.finditer(r"=== Enterprise E2E Matrix Runner ===", clean)]
      return clean[markers[-1]:] if markers else clean
  
  def row_outcomes(nr):
      out = {}
      for r in ROWS:
          blocks = re.findall(rf"=== Row {r}:[\s\S]*?(?==== Row |=== Matrix summary|$)", nr)
          b = blocks[-1] if blocks else ""
          ev = "PASS: evidence" in b
          out_fail = "FAIL: outcome" in b
          fails = list(dict.fromkeys(re.findall(r"OUTCOME-FAIL: (OUT-[A-Z0-9-]+)", b)))
          out_pass = ("all applicable criteria pass" in b) or (ev and not out_fail and not fails)
          aligned = ev and out_pass
          out[r] = {"evPass": ev, "outPass": out_pass, "outFail": out_fail, "aligned": aligned, "fails": fails, "done": ev or out_fail}
      return out
  
  def active_row(nr):
      rows = re.findall(r"=== Row (\d+):", nr)
      return int(rows[-1]) if rows else None
  
  def all_done(outcomes):
      return all(outcomes[r]["done"] for r in ROWS)
  
  def snapshot(cycle, prev_kb, prev_row):
      driver, batch, expect = find_pids()
      ph = {"driver": alive(driver), "batch": alive(batch) if batch!="none" else "DEAD", "expect": f"{alive(expect)} ({expect})" if expect!="none" else "DEAD"}
      nr = new_run_text()
      row = active_row(nr)
      slug = SLUGS.get(row, "?") if row else "?"
      log_kb, delta = 0, 0
      if row:
          lp = f"{SB}/.e2e-row{row}-attempt.log"
          if os.path.isfile(lp):
              st = os.stat(lp)
              log_kb = round(st.st_size/1024)
              if prev_kb is not None and prev_row == row: delta = log_kb - prev_kb
      outcomes = row_outcomes(nr)
      aligned = [r for r,v in outcomes.items() if v["aligned"]]
      misaligned = [r for r,v in outcomes.items() if v["evPass"] and not v["aligned"]]
      ev_n = sum(1 for v in outcomes.values() if v["evPass"])
      out_n = sum(1 for v in outcomes.values() if v["aligned"])
      batch_done = "=== Matrix summary ===" in nr
      batch_alive = ph["driver"]=="ALIVE" and ph["batch"]=="ALIVE"
      return {
          "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
          "cycle": cycle,
          "driverPid": driver, "batchPid": batch,
          "pidHealth": ph,
          "activeRow": row, "slug": slug,
          "logKB": log_kb, "logDeltaKB": delta,
          "evidencePass": f"{ev_n}/4", "outcomeAligned": f"{out_n}/4",
          "alignedRows": aligned, "misalignedRows": misaligned,
          "outcomes": outcomes,
          "batchDone": batch_done,
          "batchAlive": batch_alive
      }, log_kb, row, outcomes, batch_done, batch_alive
  
  results = []
  prev_kb, prev_row = None, None
  exit_reason = None
  for c in range(1, 80):
      if c > 1: time.sleep(75)
      snap, prev_kb, prev_row, outcomes, batch_done, batch_alive = snapshot(c, prev_kb, prev_row)
      results.append(snap)
      print(json.dumps(snap), flush=True)
      if c % CHECKPOINT_EVERY == 0: print("CHECKPOINT_G", flush=True)
      if all_done(outcomes) and batch_done:
          exit_reason = "all_rows_done"; break
      if not batch_alive:
          exit_reason = "batch_exited"; break
      if batch_done and all_done(outcomes):
          exit_reason = "batch_complete"; break
  
  print("EXIT:" + str(exit_reason or "max_cycles"), flush=True)
  # alignment table
  table = {str(r): {"evidence": outcomes[r]["evPass"], "outcome": outcomes[r]["aligned"], "aligned": outcomes[r]["aligned"], "fails": outcomes[r]["fails"]} for r in ROWS}
  print("ALIGNMENT_TABLE:" + json.dumps(table), flush=True)
  print("---SUMMARY---")
  print(json.dumps({"exit": exit_reason, "final": results[-1], "cycles": len(results), "table": table}, indent=2))
