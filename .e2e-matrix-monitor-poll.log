  import json, os, subprocess, time, re
  from datetime import datetime, timezone
  
  SB = "/Users/shafqat/projects/silver-bullet/repo"
  ROWS = [6,7,8,11]
  SLUGS = {6:'silver-fast',7:'silver-test',8:'silver-refactor',11:'silver-devops'}
  DRIVER_PIDS = [9520, 13138]  # may vary
  
  def alive(pid):
      try: os.kill(int(pid), 0); return "ALIVE"
      except: return "DEAD"
  
  def find_pids():
      driver = batch = expect = "none"
      try:
          for line in procs.split("\n"):
              if "matrix.sh" in line and "monitor" not in line:
                  batch = line.split()[0]
              elif "live-test.sh" in line and "tmux" not in line and "bash -lc" not in line:
                  if driver == "none": driver = line.split()[0]
      except: pass
      try:
      except: expect = "none"
      return driver, batch, expect
  
  def parse_row_outcomes(force):
      clean = re.sub(r'\x1b\[[0-9;]*[a-zA-Z]', '', force)
      outcomes = {}
      for r in ROWS:
          blocks = re.findall(rf"=== Row {r}:[\s\S]*?(?==== Row |=== Matrix summary|$)", clean)
          block = blocks[-1] if blocks else ""
          ev = "PASS: evidence" in block
          out_fail = "FAIL: outcome" in block
          out_pass = ("PASS: all mandatory" in block or 
                      (ev and not out_fail and ("OUTCOMES:" in block or "outcome assessment" in block.lower()) and "FAIL: outcome" not in block))
          # better: check for explicit outcome pass
          if ev and not out_fail and block.strip().endswith("pass") is False:
              # look for outcome pass line
              if re.search(r'PASS:.*outcome|all mandatory criteria pass', block, re.I):
                  out_pass = True
              elif "FAIL: outcome" not in block and "OUTCOME-FAIL" not in block and ev and len(block) > 200:
                  # row may still be in progress
                  out_pass = None
              else:
                  out_pass = False if out_fail else None
          fails = list(dict.fromkeys(re.findall(r"OUTCOME-FAIL: (OUT-[A-Z0-9-]+)", block)))
          outcomes[r] = {"evPass": ev, "outFail": out_fail, "outPass": out_pass, "fails": fails, "done": ev or out_fail}
      return outcomes
  
  def active_row(force):
      clean = re.sub(r'\x1b\[[0-9;]*[a-zA-Z]', '', force)
      rows = re.findall(r"=== Row (\d+):", clean)
      if not rows: return None, None
      r = int(rows[-1])
      return r, SLUGS.get(r, "?")
  
  def snapshot(cycle, prev_kb, prev_row):
      driver, batch, expect = find_pids()
      ph = {
          "driver": alive(driver) if driver!="none" else "DEAD",
          "batch": alive(batch) if batch!="none" else "DEAD",
          "monitor": alive(11876) if alive(11876)=="ALIVE" else alive(64921),
          "watch": alive(12209) if alive(12209)=="ALIVE" else alive(64932),
          "monitorAgent": alive(13521),
          "expect": f"{alive(expect)} ({expect})" if expect!="none" else "DEAD"
      }
      force = open(f"{SB}/.e2e-matrix-round6-force.log").read()
      row, slug = active_row(force)
      log_kb, delta, age = 0, 0, None
      if row:
          lp = f"{SB}/.e2e-row{row}-attempt.log"
          if os.path.isfile(lp):
              st = os.stat(lp)
              log_kb = round(st.st_size/1024)
              age = round((time.time()-st.st_mtime)/60)
              if prev_kb and prev_row == row: delta = log_kb - prev_kb
      ledger = open(f"{SB}/.planning/enterprise-e2e/ROUND-6-LEDGER.md").read()
      pm = re.search(r"(\d+)\s*/\s*22", ledger)
      pass_count = pm.group(1) if pm else "18"
      offset = json.load(open(f"{SB}/.planning/enterprise-e2e/.tui-monitor-agent-offset.json"))
      findings = open(f"{SB}/.e2e-tui-watch-findings.jsonl").read().strip().split("\n")
      new_f = max(0, len(findings) - offset.get("findings_line", 618))
      outcomes = parse_row_outcomes(force)
      # pattern: evidence+outcome both pass
      aligned = [r for r,v in outcomes.items() if v.get("evPass") and v.get("outPass")]
      misaligned = [r for r,v in outcomes.items() if v.get("evPass") and v.get("outFail")]
      dup = False
      except: pass
      batch_alive = ph["driver"]=="ALIVE" and ph["batch"]=="ALIVE"
      tail = re.sub(r'\x1b\[[0-9;]*[a-zA-Z]', '', force[-800:])
      return {
          "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
          "cycle": cycle, "commit": "6c685482",
          "pidHealth": ph, "driverPid": driver, "batchPid": batch,
          "activeRow": row, "slug": slug,
          "passCount": f"{pass_count}/22",
          "logKB": log_kb, "logDeltaKB": delta, "logAgeMin": age,
          "newFrictions": new_f,
          "outcomes": outcomes,
          "alignedRows": aligned, "misalignedRows": misaligned,
          "duplicateDrivers": dup, "batchAlive": batch_alive,
          "tail": tail[-300:], "action": "none"
      }, log_kb, row, not batch_alive
  
  results = []
  prev_kb, prev_row = 0, None
  batch_dead = False
  for c in range(1, 13):
      if c > 1: time.sleep(75)
      snap, prev_kb, prev_row, batch_dead = snapshot(c, prev_kb, prev_row)
      results.append(snap)
      print(json.dumps(snap), flush=True)
      # exit early if batch dead and all rows done or matrix summary
      force = open(f"{SB}/.e2e-matrix-round6-force.log").read()
      if "=== Matrix summary ===" in force[-3000:] and not snap["batchAlive"]:
          print("EXIT:batch_complete", flush=True)
          break
      if batch_dead and c > 1:
          print("EXIT:batch_dead", flush=True)
          break
  
  print("---SUMMARY---")
  print(json.dumps({"cycles": len(results), "final": results[-1] if results else {}, "allOutcomes": results[-1]["outcomes"] if results else {}}, indent=2))
