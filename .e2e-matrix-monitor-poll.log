      for m in re.finditer(r"=== Row (\d+):[^\n]*\n(?:.*\n){0,30}?(PASS: evidence|FAIL: outcome)", tail):
          completions.append(f"row{m.group(1)} {m.group(2)}")
      
      row_done = bool(re.search(r"(PASS: evidence|FAIL: outcome assessment)", tail[-2000:]))
      
      try:
          dup = len([d for d in drivers if d]) > 4
      except: dup = False
      
      hung = log_age is not None and log_age > 45 and ph.get("expect","").startswith("ALIVE")
      
      return {
          "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
          "cycle": cycle,
          "pidHealth": ph,
