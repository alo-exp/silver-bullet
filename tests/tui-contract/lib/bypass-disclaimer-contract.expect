#!/usr/bin/expect -f
# PTY contract: Bypass Permissions disclaimer detection (no live Claude API).
# Validates the same TCL procs used by scripts/claude-interactive-invoke.expect.

proc strip_ansi {text} {
  regsub -all {\x1b\[[0-9;?]*[ -/]*[@-~]} $text "" text
  regsub -all {\x1b\][^\x07]*(\x07|\x1b\\)} $text "" text
  regsub -all {\x1b.} $text "" text
  return $text
}

proc bypass_disclaimer_visible {buffer} {
  set plain [strip_ansi $buffer]
  if {![regexp -nocase {Bypass} $plain]} { return 0 }
  if {![regexp -nocase {Permissions} $plain]} { return 0 }
  if {![regexp {code\.claude\.com/docs/en/security} $plain]} { return 0 }
  if {![regexp -nocase {No,exit|No, exit} $plain]} { return 0 }
  if {![regexp -nocase {Yes,Iaccept|Yes, I accept} $plain]} { return 0 }
  if {![regexp -nocase {Entertoconfirm|Enter to confirm} $plain]} { return 0 }
  return 1
}

proc bypass_disclaimer_menu_ready {buffer} {
  set plain [strip_ansi $buffer]
  if {![regexp -nocase {No,exit|No, exit} $plain]} { return 0 }
  if {![regexp -nocase {Yes,Iaccept|Yes, I accept} $plain]} { return 0 }
  if {![regexp -nocase {Entertoconfirm|Enter to confirm} $plain]} { return 0 }
  return 1
}

set fixture [file normalize [file join [file dirname $argv0] .. fixtures bypass-disclaimer.ansi]]
if {![file exists $fixture]} {
  puts stderr "FAIL: missing fixture $fixture"
  exit 1
}

set fh [open $fixture r]
fconfigure $fh -translation binary
set bytes [read $fh]
close $fh

if {![bypass_disclaimer_visible $bytes]} {
  puts stderr "FAIL: bypass_disclaimer_visible did not match fixture"
  exit 1
}
if {![bypass_disclaimer_menu_ready $bytes]} {
  puts stderr "FAIL: bypass_disclaimer_menu_ready did not match fixture"
  exit 1
}

set plain [strip_ansi $bytes]
if {![regexp -nocase {Bypass} $plain] || ![regexp -nocase {Permissions} $plain]} {
  puts stderr "FAIL: stripped fixture missing Bypass/Permissions text"
  exit 1
}

puts "PASS: bypass disclaimer contract (fixture bytes, no live API)"
exit 0
