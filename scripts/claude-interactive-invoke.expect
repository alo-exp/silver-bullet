#!/usr/bin/expect -f

proc env_or_default {name default} {
  if {[info exists ::env($name)] && $::env($name) ne ""} {
    return $::env($name)
  }
  return $default
}

proc type_slow {text delay_ms} {
  set length [string length $text]
  for {set i 0} {$i < $length} {incr i} {
    send -- [string index $text $i]
    if {$delay_ms > 0} {
      after $delay_ms
    }
  }
}

proc dismiss_claude_splash {} {
  # Claude "What's new" overlays usually dismiss with Enter; avoid Escape
  # because it can cancel the active input buffer before prompt submission.
  send -- "\r"
  after 500
}

proc load_claude_settings_env {} {
  if {[env_or_default SB_E2E_MATRIX_SKIP_SETTINGS_EXPORT "0"] eq "1"} {
    return
  }
  if {[env_or_default CLAUDE_PRINT_SKIP_SETTINGS_EXPORT "0"] eq "1"} {
    return
  }
  # Interactive TUI does not always inherit ~/.codex/settings.json env like
  # `claude --print`. Inject API-key env before spawn when not in clean-env mode
  # and when claude.ai OAuth is not already active (avoid auth conflicts).
  set matrix_clean_env [env_or_default SB_E2E_MATRIX_CLEAN_ENV "0"]
  if {$matrix_clean_env eq "1"} {
    return
  }
  set home [env_or_default HOME ""]
  if {$home eq ""} {
    return
  }
  set settings [env_or_default CLAUDE_SETTINGS_FILE ""]
  if {$settings eq "" && [info exists ::env(CLAUDE_CONFIG_DIR)] && $::env(CLAUDE_CONFIG_DIR) ne ""} {
    set settings "$::env(CLAUDE_CONFIG_DIR)/settings.json"
  }
  if {$settings eq ""} {
    set settings "$home/.codex/settings.json"
  }
  if {![file exists $settings]} {
    return
  }
  set cli [env_or_default CLAUDE_BIN "/Users/shafqat/.local/bin/claude"]
  if {![catch {exec $cli auth status} auth_json]} {
    if {![catch {exec jq -e {(.authMethod == "claude.ai") and ((.apiKeySource? // "") == "ANTHROPIC_API_KEY")} <<< $auth_json}]} {
      return
    }
  }
  if {[catch {exec jq -e {(.env.ANTHROPIC_API_KEY? // "") != "" or (.env.ANTHROPIC_AUTH_TOKEN? // "") != "" or (.env.ANTHROPIC_BASE_URL? // "") != ""} $settings}]} {
    return
  }
  if {[catch {exec jq -r {.env // {} | to_entries[] | "\(.key)=\(.value)"} $settings} lines]} {
    return
  }
  foreach line [split $lines \n] {
    if {$line eq ""} {
      continue
    }
    if {![regexp {^([^=]+)=(.*)$} $line -> key value]} {
      continue
    }
    if {$key eq ""} {
      continue
    }
    if {![info exists env($key)] || $env($key) eq ""} {
      set env($key) $value
    }
  }
}


proc strip_ansi {text} {
  regsub -all {\[[0-9;?]*[ -/]*[@-~]} $text "" text
  regsub -all {\][^]*(|\\)} $text "" text
  regsub -all {.} $text "" text
  return $text
}

proc bypass_disclaimer_visible {buffer} {
  set plain [strip_ansi $buffer]
  if {![regexp -nocase {Bypass} $plain]} {
    return 0
  }
  if {![regexp -nocase {Permissions} $plain]} {
    return 0
  }
  if {![regexp {code\.claude\.com/docs/en/security} $plain]} {
    return 0
  }
  if {![regexp -nocase {Yes,Iaccept|Yes, I accept} $plain]} {
    return 0
  }
  if {![regexp -nocase {Entertoconfirm|Enter to confirm|Esctocancel|Esc to cancel} $plain]} {
    return 0
  }
  return 1
}

proc bypass_disclaimer_menu_ready {buffer} {
  set plain [strip_ansi $buffer]
  if {![regexp -nocase {Yes,Iaccept|Yes, I accept} $plain]} {
    return 0
  }
  if {![regexp -nocase {1\.\s*exit|No,exit|No, exit|Esctocancel|Esc to cancel} $plain]} {
    return 0
  }
  if {![regexp -nocase {Entertoconfirm|Enter to confirm} $plain]} {
    return 0
  }
  return 1
}

proc folder_trust_visible {buffer} {
  set plain [strip_ansi $buffer]
  if {[regexp -nocase {Quick.{0,12}safety.{0,12}check} $plain]} {
    return 1
  }
  if {[regexp -nocase {trust.{0,24}folder|safety.{0,12}check:.{0,40}project} $plain]} {
    if {[regexp -nocase {Yes.{0,8}trust|1\.\s*Yes} $plain]} {
      return 1
    }
  }
  return 0
}

proc accept_folder_trust {} {
  global folder_trust_accept_attempts folder_trust_confirmed
  if {$folder_trust_accept_attempts >= 6} {
    return
  }
  incr folder_trust_accept_attempts
  set folder_trust_confirmed 1
  set strategy [env_or_default CLAUDE_INTERACTIVE_TRUST_STRATEGY "enter"]
  log_harness_keys "\[harness\] accept_folder_trust: strategy=$strategy attempt=$folder_trust_accept_attempts"
  if {$strategy eq "keys"} {
    type_slow "1" 40
    after 500
    send -- "\r"
  } else {
    # Trust menu pre-selects option 1 (❯); Enter confirms.
    send -- "\r"
  }
  after 500
  send -- "\r"
  after 900
}

proc respawn_after_folder_trust {} {
  global cli args folder_trust_respawn_count folder_trust_accept_attempts
  global ready_timeout post_prompt_delay_ms permission_mode continue_flag
  set max_respawn [expr {int([env_or_default CLAUDE_INTERACTIVE_TRUST_RESPAWN_MAX 2])}]
  if {$folder_trust_respawn_count >= $max_respawn} {
    return 0
  }
  incr folder_trust_respawn_count
  log_harness_keys "\[harness\] respawn after folder trust (respawn=$folder_trust_respawn_count/$max_respawn)"
  catch {close}
  catch {wait}
  after 2000
  spawn -noecho $cli {*}$args
  if {$continue_flag eq "0"} {
    set trust_delay_ms [expr {int([env_or_default CLAUDE_INTERACTIVE_TRUST_DELAY_MS 2000])}]
    after $trust_delay_ms
    if {$permission_mode ne "bypassPermissions"} {
      dismiss_claude_splash
    }
  } else {
    after 200
  }
  after $post_prompt_delay_ms
  set folder_trust_accept_attempts 0
  set timeout $ready_timeout
  return 1
}

proc bypass_disclaimer_confirm_only {buffer} {
  global bypass_disclaimer_menu_open
  set plain [strip_ansi $buffer]
  if {[folder_trust_visible $buffer]} {
    return 0
  }
  if {![regexp -nocase {Entertoconfirm|Enter to confirm} $plain]} {
    return 0
  }
  if {![regexp -nocase {Esctocancel|Esc to cancel} $plain]} {
    return 0
  }
  if {$bypass_disclaimer_menu_open} {
    return 1
  }
  if {[regexp -nocase {Yes,Iaccept|Yes, I accept} $plain]} {
    return 1
  }
  if {[regexp -nocase {Bypass} $plain] && [regexp -nocase {Permissions} $plain]} {
    return 1
  }
  return 0
}

proc should_accept_bypass_disclaimer {buffer} {
  global bypass_disclaimer_menu_open
  if {[folder_trust_visible $buffer]} {
    return 0
  }
  if {$bypass_disclaimer_menu_open} {
    return 1
  }
  if {[bypass_disclaimer_confirm_only $buffer]} {
    return 1
  }
  if {[bypass_disclaimer_menu_ready $buffer]} {
    return 1
  }
  if {[bypass_disclaimer_visible $buffer]} {
    return 1
  }
  return 0
}

proc reset_ready_timeout {} {
  global ready_timeout
  set timeout $ready_timeout
}

proc log_harness_keys {message} {
  global debug_log
  if {$debug_log ne ""} {
    catch {
      set fh [open $debug_log a]
      puts $fh $message
      close $fh
    }
  }
  puts stderr $message
}

proc accept_bypass_permissions_disclaimer {} {
  global bypass_disclaimer_accept_attempts expect_out
  if {[info exists expect_out(buffer)] && [folder_trust_visible $expect_out(buffer)]} {
    accept_folder_trust
    return
  }
  if {$bypass_disclaimer_accept_attempts >= 6} {
    return
  }
  incr bypass_disclaimer_accept_attempts
  set strategy [env_or_default CLAUDE_INTERACTIVE_BYPASS_STRATEGY "arrow"]
  log_harness_keys "\[harness\] accept_bypass_permissions_disclaimer: strategy=$strategy attempt=$bypass_disclaimer_accept_attempts"
  if {$strategy eq "arrow"} {
    send -- "\033\[B"
    after 400
    send -- "\r"
  } elseif {$strategy eq "alt-arrow"} {
    send -- "\033OB"
    after 400
    send -- "\r"
  } else {
    type_slow "2" 40
    after 500
    send -- "\r"
  }
  after 900
}

proc custom_api_key_disclaimer_visible {buffer} {
  set plain [strip_ansi $buffer]
  if {![regexp -nocase {Detected} $plain]} {
    return 0
  }
  if {![regexp -nocase {custom} $plain]} {
    return 0
  }
  if {![regexp -nocase {API} $plain]} {
    return 0
  }
  if {![regexp -nocase {ANTHROPIC_API_KEY|Doyouwant|Do you want} $plain]} {
    return 0
  }
  if {![regexp -nocase {use.*this.*API.*key|use this API key} $plain]} {
    return 0
  }
  if {![regexp -nocase {No.*recommended|No,recommended} $plain]} {
    return 0
  }
  if {![regexp -nocase {1\.Yes|1\. Yes|Yes} $plain]} {
    return 0
  }
  if {![regexp -nocase {Entertoconfirm|Enter to confirm} $plain]} {
    return 0
  }
  return 1
}

proc custom_api_key_disclaimer_menu_ready {buffer} {
  set plain [strip_ansi $buffer]
  if {![regexp -nocase {Doyouwant|Do you want} $plain]} {
    return 0
  }
  if {![regexp -nocase {use.*this.*API.*key|use this API key} $plain]} {
    return 0
  }
  if {![regexp -nocase {No.*recommended|No,recommended} $plain]} {
    return 0
  }
  if {![regexp -nocase {1\.Yes|1\. Yes|Yes} $plain]} {
    return 0
  }
  if {![regexp -nocase {Entertoconfirm|Enter to confirm} $plain]} {
    return 0
  }
  return 1
}

proc should_accept_custom_api_key_disclaimer {buffer} {
  global custom_api_key_disclaimer_menu_open
  if {$custom_api_key_disclaimer_menu_open} {
    return 1
  }
  if {[custom_api_key_disclaimer_menu_ready $buffer]} {
    return 1
  }
  if {[custom_api_key_disclaimer_visible $buffer]} {
    return 1
  }
  return 0
}

proc accept_custom_api_key_disclaimer {} {
  global custom_api_key_disclaimer_accept_attempts
  if {$custom_api_key_disclaimer_accept_attempts >= 6} {
    return
  }
  incr custom_api_key_disclaimer_accept_attempts
  set strategy [env_or_default CLAUDE_INTERACTIVE_CUSTOM_API_KEY_STRATEGY "keys"]
  log_harness_keys "\[harness\] accept_custom_api_key_disclaimer: strategy=$strategy attempt=$custom_api_key_disclaimer_accept_attempts"
  if {$strategy eq "arrow"} {
    send -- "\033\[A"
    after 400
    send -- "\r"
  } elseif {$strategy eq "alt-arrow"} {
    send -- "\033OA"
    after 400
    send -- "\r"
  } elseif {$strategy eq "recommended"} {
    send -- "\r"
  } else {
    type_slow "1" 40
    after 500
    send -- "\r"
  }
  after 900
}

proc blocking_decision_picker_visible {buffer} {
  set plain [strip_ansi $buffer]
  if {![regexp -nocase {Enter to select} $plain]} {
    return 0
  }
  if {![regexp -nocase {navigate} $plain]} {
    return 0
  }
  if {![regexp -nocase {Esc to cancel} $plain]} {
    return 0
  }
  if {![regexp -nocase {1\.|2\.|3\.} $plain]} {
    return 0
  }
  return 1
}

proc resolve_blocking_decision_picker {} {
  global picker_resolve_attempts
  if {$picker_resolve_attempts >= 6} {
    return
  }
  incr picker_resolve_attempts
  set choice [env_or_default CLAUDE_INTERACTIVE_PICKER_CHOICE "1"]
  log_harness_keys "\[harness\] resolve_blocking_decision_picker: choice=$choice attempt=$picker_resolve_attempts"
  type_slow $choice 40
  after 500
  send -- "\r"
  after 900
}

proc finish_session_success {} {
  catch {close}
  catch {wait}
  exit 0
}

proc matrix_evidence_ready {} {
  global evidence_path work_dir session_started
  if {$evidence_path eq ""} {
    return 0
  }
  set target "$work_dir/$evidence_path"
  if {![file exists $target]} {
    return 0
  }
  if {[file mtime $target] + 2 < $session_started} {
    return 0
  }
  return 1
}

proc maybe_finish_on_matrix_evidence {} {
  global prompt_submitted saw_prompt require_final_marker final_marker_seen
  if {!$prompt_submitted || !$saw_prompt} {
    return 0
  }
  if {$require_final_marker == 1 && $final_marker_seen == 0} {
    return 0
  }
  if {[matrix_evidence_ready]} {
    finish_session_success
  }
  return 0
}

proc parse_token_count_from_marker {marker} {
  set m [string trim $marker]
  if {$m eq ""} {
    return 0
  }
  if {[regexp {^([0-9][0-9.,]*)([kKmM])?} $m -> num suffix]} {
    set num [string map {, ""} $num]
    if {$num eq ""} {
      return 0
    }
    set value [expr {double($num)}]
    if {[info exists suffix] && $suffix ne ""} {
      switch -nocase $suffix {
        k { set value [expr {$value * 1000.0}] }
        m { set value [expr {$value * 1000000.0}] }
      }
    }
    return [expr {int($value)}]
  }
  return 0
}

proc workflow_response_complete_ok {} {
  global peak_token_count prompt_submitted_at workflow_quiet_timeout require_final_marker prompt_submitted
  if {$require_final_marker == 1} {
    return 1
  }
  if {$peak_token_count > 0} {
    return 1
  }
  if {[matrix_evidence_ready]} {
    return 1
  }
  if {$prompt_submitted && $peak_token_count == 0 && [info exists ::env(SB_E2E_ENTERPRISE_MATRIX)] && $::env(SB_E2E_ENTERPRISE_MATRIX) eq "1"} {
    return 0
  }
  if {$prompt_submitted_at > 0} {
    set elapsed [expr {[clock seconds] - $prompt_submitted_at}]
    if {$elapsed >= $workflow_quiet_timeout} {
      return 1
    }
  }
  return 0
}

proc extend_workflow_wait_timeout {} {
  global workflow_quiet_timeout prompt_submitted_at peak_token_count
  if {$prompt_submitted_at <= 0} {
    set timeout 60
    return
  }
  set elapsed [expr {[clock seconds] - $prompt_submitted_at}]
  set remaining [expr {$workflow_quiet_timeout - $elapsed}]
  if {$remaining < 10} {
    set remaining 10
  }
  if {$remaining > 120} {
    set remaining 120
  }
  log_harness_keys "\[harness\] 0-token quiet hold (peak=$peak_token_count elapsed=${elapsed}s) — retry in ${remaining}s"
  set timeout $remaining
}

proc context_exhaustion_visible {buffer} {
  set plain [strip_ansi $buffer]
  if {[regexp -nocase {100%\s*context\s*used} $plain]} {
    return 1
  }
  if {[regexp -nocase {context\s+window.*full|context\s+is\s+full|context\s+limit\s+reached} $plain]} {
    return 1
  }
  if {[regexp -nocase {run\s+/compact|auto[- ]?compact|compact\s+(the\s+)?conversation} $plain]} {
    return 1
  }
  return 0
}

proc recover_from_context_exhaustion {} {
  global context_recovery_attempts
  if {$context_recovery_attempts >= 1} {
    log_harness_keys "\[harness\] context exhaustion persists after /clear - allowing quiet timeout"
    return 0
  }
  incr context_recovery_attempts
  log_harness_keys "\[harness\] context exhaustion detected - sending /clear"
  send -- "/clear"
  after 400
  send -- "\r"
  after 2000
  return 1
}

proc extend_quiet_on_new_token_marker {plain_text} {
  global quiet_timeout last_token_marker context_full_stalled_at peak_token_count
  set marker ""
  if {![regexp {([0-9][0-9.,kKmM]*[^0-9]{0,12}tokens)} $plain_text match marker]} {
    return
  }
  set parsed [parse_token_count_from_marker $marker]
  if {$parsed > $peak_token_count} {
    set peak_token_count $parsed
  }
  if {[context_exhaustion_visible $plain_text]} {
    if {$context_full_stalled_at == 0} {
      set context_full_stalled_at [clock seconds]
      recover_from_context_exhaustion
    } elseif {$marker eq $last_token_marker} {
      set stalled [expr {[clock seconds] - $context_full_stalled_at}]
      # Context-full with unchanged token count: cap quiet window so matrix
      # can fail/retry instead of hanging while the TUI refreshes idle status.
      if {$stalled >= 120} {
        set timeout 30
      }
      return
    }
  } else {
    set context_full_stalled_at 0
  }
  if {$marker eq $last_token_marker} {
    return
  }
  set last_token_marker $marker
  set timeout $quiet_timeout
}

proc token_gateway_configured {} {
  if {[info exists env(ANTHROPIC_BASE_URL)] && $env(ANTHROPIC_BASE_URL) ne ""} {
    return 1
  }
  if {[info exists env(ANTHROPIC_API_KEY)] && $env(ANTHROPIC_API_KEY) ne ""} {
    return 1
  }
  if {[info exists env(ANTHROPIC_AUTH_TOKEN)] && $env(ANTHROPIC_AUTH_TOKEN) ne ""} {
    return 1
  }
  return 0
}

proc pasted_prompt_collapsed_visible {buffer} {
  set plain [strip_ansi $buffer]
  if {[regexp -nocase {\[Pasted|Pasted text} $plain]} {
    return 1
  }
  if {[regexp -nocase {paste again to expand} $plain]} {
    return 1
  }
  return 0
}

proc confirm_pasted_prompt_submit {} {
  global paste_confirm_attempts
  if {![info exists paste_confirm_attempts]} {
    set paste_confirm_attempts 0
  }
  if {$paste_confirm_attempts >= 8} {
    return
  }
  incr paste_confirm_attempts
  log_harness_keys "\[harness\] pasted prompt collapsed — Enter to expand/submit (attempt=$paste_confirm_attempts)"
  send -- "\r"
  after 500
  send -- "\r"
  after 500
}

proc input_prompt_ready {buffer} {
  set plain [strip_ansi $buffer]
  return [regexp {❯} $plain]
}

proc maybe_submit_prompt {buffer} {
  global command_name prompt_body prompt_submitted saw_not_logged_in quiet_timeout slash_pause_ms slash_route_pending
  if {$prompt_submitted || $saw_not_logged_in} {
    return 0
  }
  # Slash routes need the ❯ input line; submitting on the idle "0 tokens"
  # status bar fires before Claude registers plugin /sb commands.
  if {$slash_route_pending && ![input_prompt_ready $buffer]} {
    return 0
  }
  if {$slash_route_pending} {
    after $slash_pause_ms
  }
  if {[submit_prompt $command_name $prompt_body]} {
    if {[pasted_prompt_collapsed_visible $buffer]} {
      confirm_pasted_prompt_submit
    }
    set prompt_submitted 1
    global prompt_submitted_at
    if {$prompt_submitted_at == 0} {
      set prompt_submitted_at [clock seconds]
    }
    set timeout $quiet_timeout
    return 1
  }
  return 0
}

proc submit_prompt {command_name prompt_body} {
  global saw_not_logged_in
  if {$saw_not_logged_in && ![token_gateway_configured]} {
    return 0
  }
  if {$command_name ne ""} {
    send -- "/$command_name"
    if {[string length $prompt_body] > 0} {
      send -- " "
      set body_len [string length $prompt_body]
      set paste_threshold [expr {int([env_or_default CLAUDE_INTERACTIVE_PASTE_THRESHOLD 400])}]
      if {$body_len > $paste_threshold} {
        global type_delay_ms
        type_slow $prompt_body $type_delay_ms
      } else {
        send -- $prompt_body
      }
    }
  } elseif {[string length $prompt_body] > 0} {
    set body_len [string length $prompt_body]
    set paste_threshold [expr {int([env_or_default CLAUDE_INTERACTIVE_PASTE_THRESHOLD 400])}]
    if {$body_len > $paste_threshold} {
      global type_delay_ms
      type_slow $prompt_body $type_delay_ms
    } else {
      send -- $prompt_body
    }
  }
  if {$command_name ne "" || [string length $prompt_body] > 0} {
    after 250
    send -- "\r"
    after 250
    send -- "\r"
    return 1
  }
  return 0
}

set timeout [expr {int([env_or_default CLAUDE_INTERACTIVE_TIMEOUT 900])}]
set cli [env_or_default CLAUDE_BIN "/Users/shafqat/.local/bin/claude"]
set work_dir [env_or_default CLAUDE_WORK_DIR ""]
set prompt_file [env_or_default CLAUDE_PROMPT_FILE ""]
set model [env_or_default CLAUDE_MODEL "sonnet"]
set effort [env_or_default CLAUDE_EFFORT "low"]
set permission_mode [env_or_default CLAUDE_PERMISSION_MODE "acceptEdits"]
set continue_flag [env_or_default CLAUDE_CONTINUE "0"]
set debug_log [env_or_default CLAUDE_INTERACTIVE_LOG_FILE ""]
set evidence_path [env_or_default SB_E2E_MATRIX_EVIDENCE_PATH ""]
set debug_trace [env_or_default CLAUDE_INTERACTIVE_DEBUG "0"]
set post_prompt_delay_ms [expr {int([env_or_default CLAUDE_INTERACTIVE_READY_DELAY_MS 1000])}]
set ready_timeout [expr {int([env_or_default CLAUDE_INTERACTIVE_READY_TIMEOUT 300])}]
set quiet_timeout [expr {int([env_or_default CLAUDE_INTERACTIVE_QUIET_TIMEOUT 5])}]
set workflow_quiet_timeout [expr {int([env_or_default SB_E2E_WORKFLOW_QUIET_TIMEOUT 600])}]
if {$workflow_quiet_timeout < $quiet_timeout} {
  set workflow_quiet_timeout $quiet_timeout
}
set type_delay_ms [expr {int([env_or_default CLAUDE_INTERACTIVE_TYPE_DELAY_MS 15])}]
set slash_pause_ms [expr {int([env_or_default CLAUDE_INTERACTIVE_SLASH_PAUSE_MS 250])}]

if {$work_dir eq "" || $prompt_file eq ""} {
  puts stderr "ERROR: CLAUDE_WORK_DIR and CLAUDE_PROMPT_FILE must be set"
  exit 2
}

set prompt_handle [open $prompt_file r]
set prompt [read $prompt_handle]
close $prompt_handle

set command_name ""
set prompt_body $prompt
if {[string length $prompt] > 0 && [string index $prompt 0] eq "/"} {
  if {[regexp {^/([^[:space:]]+)\s*(.*)$} $prompt -> command_name prompt_body]} {
    set prompt_body [string trimleft $prompt_body]
  }
}
set slash_route_pending 0
if {$command_name ne ""} {
  set slash_route_pending 1
}

cd $work_dir

# Only strip shell API keys in clean-env matrix runs (OAuth/key-conflict isolation).
set matrix_clean_env [env_or_default SB_E2E_MATRIX_CLEAN_ENV "0"]
if {$matrix_clean_env eq "1"} {
  catch {unset env(ANTHROPIC_API_KEY)}
  catch {unset env(OPENAI_API_KEY)}
} else {
  load_claude_settings_env
}

if {$debug_log ne ""} {
  log_file -a $debug_log
}
if {$debug_trace eq "1"} {
  exp_internal 1
}

set args [list --model $model --effort $effort --permission-mode $permission_mode --verbose]
if {$permission_mode eq "bypassPermissions"} {
  lappend args --allow-dangerously-skip-permissions
}
set home [env_or_default HOME ""]
set settings_file [env_or_default CLAUDE_SETTINGS_FILE ""]
if {$settings_file eq "" && [info exists ::env(CLAUDE_CONFIG_DIR)] && $::env(CLAUDE_CONFIG_DIR) ne ""} {
  set settings_file "$::env(CLAUDE_CONFIG_DIR)/settings.json"
}
if {$settings_file eq "" && $home ne ""} {
  set settings_file "$home/.codex/settings.json"
}
if {$matrix_clean_env ne "1" && $settings_file ne "" && [file exists $settings_file]} {
  lappend args --settings $settings_file
}
if {$continue_flag eq "1"} {
  lappend args --continue
}

log_user 1
spawn -noecho $cli {*}$args

if {$continue_flag eq "0"} {
  set trust_delay_ms [expr {int([env_or_default CLAUDE_INTERACTIVE_TRUST_DELAY_MS 2000])}]
  after $trust_delay_ms
  # Bare Enter during Bypass Permissions disclaimer selects option 1 (exit).
  if {$permission_mode ne "bypassPermissions"} {
    dismiss_claude_splash
  }
} else {
  after 200
}

after $post_prompt_delay_ms
set timeout $ready_timeout
set prompt_submitted 0
set saw_prompt 0
set final_marker_seen 0
set require_final_marker 0
set saw_not_logged_in 0
set last_token_marker ""
set peak_token_count 0
set prompt_submitted_at 0
set context_recovery_attempts 0
set context_full_stalled_at 0
set session_started [clock seconds]
if {$debug_log ne "" && [file exists $debug_log]} {
  set session_started [file mtime $debug_log]
}
set bypass_disclaimer_menu_open 0
set bypass_disclaimer_accept_attempts 0
set custom_api_key_disclaimer_menu_open 0
set custom_api_key_disclaimer_accept_attempts 0
set picker_resolve_attempts 0
set folder_trust_accept_attempts 0
set folder_trust_confirmed 0
set folder_trust_respawn_count 0
if {$command_name eq "silver-init" || $command_name eq "sb:init"} {
  set require_final_marker 1
  if {$quiet_timeout < 600} {
    # Silver init is the longest-running bootstrap path in the live matrix.
    # Give it a wider quiet window so it can finish scaffolding before we cut
    # it off and misclassify the result as an incomplete init.
    set quiet_timeout 600
  }
}

expect {
  -re {Quick safety check:|trust this folder|Accessing.{0,20}workspace} {
    if {[folder_trust_visible $expect_out(buffer)]} {
      accept_folder_trust
      reset_ready_timeout
      exp_continue
    }
    exp_continue
  }
  -re {RTK\.md} {
    log_harness_keys "\[harness\] onboarding: RTK.md import dialog — confirm allow"
    send -- "\r"
    after 800
    reset_ready_timeout
    exp_continue
  }
  -re {Bypass Permissions mode|running in Bypass|Bypa[s ]{1,3}s Permissions|Permissions mode} {
    set bypass_disclaimer_menu_open 1
    reset_ready_timeout
    exp_continue
  }
  -re {Gaccept|Yes, I accept|Yes,I accept|I accept the risk} {
    if {[folder_trust_visible $expect_out(buffer)]} {
      accept_folder_trust
      reset_ready_timeout
      exp_continue
    }
    set bypass_disclaimer_menu_open 1
    accept_bypass_permissions_disclaimer
    set bypass_disclaimer_menu_open 0
    reset_ready_timeout
    exp_continue
  }
  -re {Yes, I accept|Yes,I accept|I accept the risk} {
    if {[folder_trust_visible $expect_out(buffer)]} {
      accept_folder_trust
      reset_ready_timeout
      exp_continue
    }
    set bypass_disclaimer_menu_open 1
    reset_ready_timeout
    exp_continue
  }
  -re {Allow external imports|external CLAUDE\.md imports|RTK\.md} {
    log_harness_keys "\[harness\] onboarding: allow external CLAUDE.md imports (yes)"
    send -- "1\r"
    after 800
    reset_ready_timeout
    exp_continue
  }
  -re {Enterto confirm|Enter to confirm|Entertoconfirm|Gto.{0,12}Gconfirm|to.{0,8}confirm} {
    if {[folder_trust_visible $expect_out(buffer)]} {
      accept_folder_trust
      after 800
      reset_ready_timeout
      exp_continue
    }
    if {[should_accept_custom_api_key_disclaimer $expect_out(buffer)]} {
      accept_custom_api_key_disclaimer
      set custom_api_key_disclaimer_menu_open 0
      after 800
      exp_continue
    }
    if {[should_accept_bypass_disclaimer $expect_out(buffer)]} {
      accept_bypass_permissions_disclaimer
      set bypass_disclaimer_menu_open 0
      after 800
      reset_ready_timeout
      exp_continue
    }
    exp_continue
  }
  -re {How should I close out this turn\?} {
    if {$prompt_submitted == 0} { exp_continue }
    resolve_blocking_decision_picker
    set timeout $quiet_timeout
    exp_continue
  }
  -re {Esc.*to.*cancel} {
    if {[folder_trust_visible $expect_out(buffer)]} {
      accept_folder_trust
      after 500
      reset_ready_timeout
      exp_continue
    }
    if {[regexp -nocase {allowexternal|externalimports|RTK\.md} $expect_out(buffer)]} {
      log_harness_keys "\[harness\] onboarding: allow external CLAUDE.md imports"
      send -- "\r"
      after 800
      reset_ready_timeout
      exp_continue
    }
    if {$bypass_disclaimer_menu_open} {
      log_harness_keys "\[harness\] bypass disclaimer: confirm (esc footer)"
      accept_bypass_permissions_disclaimer
      set bypass_disclaimer_menu_open 0
      after 500
      reset_ready_timeout
      exp_continue
    }
    if {$prompt_submitted && [blocking_decision_picker_visible $expect_out(buffer)]} {
      resolve_blocking_decision_picker
      set timeout $quiet_timeout
      exp_continue
    }
    if {[should_accept_custom_api_key_disclaimer $expect_out(buffer)]} {
      accept_custom_api_key_disclaimer
      set custom_api_key_disclaimer_menu_open 0
      after 500
      exp_continue
    }
    if {[should_accept_bypass_disclaimer $expect_out(buffer)]} {
      accept_bypass_permissions_disclaimer
      set bypass_disclaimer_menu_open 0
      after 500
      reset_ready_timeout
      exp_continue
    }
    exp_continue
  }
  -re {Detected.*custom.*API.*key|ANTHROPIC_API_KEY:} {
    set custom_api_key_disclaimer_menu_open 1
    exp_continue
  }
  -re {Do you want to use this API key\?|want to use this API key} {
    if {[should_accept_custom_api_key_disclaimer $expect_out(buffer)]} {
      accept_custom_api_key_disclaimer
      set custom_api_key_disclaimer_menu_open 0
      after 500
      exp_continue
    }
    exp_continue
  }

  -re {Select login method|Claude account with subscription.*Anthropic Console} {
    if {[token_gateway_configured]} {
      log_harness_keys "\[harness\] login method: Anthropic Console (token gateway)"
      send -- "2\r"
      after 900
      exp_continue
    }
    log_harness_keys "\[harness\] onboarding: dismiss login method (use env API key / gateway)"
    send -- "\033"
    after 900
    exp_continue
  }
  -re {Browser didn't open\?|oauth/authorize\?code} {
    log_harness_keys "\[harness\] blocking OAuth gate — token gateway expected (set CLAUDE_SETTINGS_FILE env or clear isolated config session)"
    send -- "\033"
    after 500
    exp_continue
  }
  -re {Using 3rd-party platforms|Amazon Bedrock.*Microsoft Foundry} {
    if {[token_gateway_configured]} {
      log_harness_keys "\[harness\] 3rd-party menu: go back (token gateway)"
      send -- "4\r"
      after 900
      exp_continue
    }
    log_harness_keys "\[harness\] onboarding: back from 3rd-party menu"
    send -- "4\r"
    after 900
    exp_continue
  }
  -re {microsoft-foundry|code\.claude\.com/docs/en/microsoft-foundry} {
    if {[token_gateway_configured]} {
      log_harness_keys "\[harness\] closing Foundry docs overlay (token gateway)"
      send -- "\033"
      after 400
      send -- "4\r"
      after 900
      exp_continue
    }
    exp_continue
  }
  -re {Syntax theme|Dark mode.*Light mode|Auto \(match terminal\)} {
    log_harness_keys "\[harness\] onboarding: syntax theme dark"
    send -- "2\r"
    after 900
    exp_continue
  }
  -re {Bypass Permissions mode|running in Bypass|Bypa[s ]{1,3}s Permissions} {
    set bypass_disclaimer_menu_open 1
    if {[should_accept_bypass_disclaimer $expect_out(buffer)]} {
      accept_bypass_permissions_disclaimer
      set bypass_disclaimer_menu_open 0
      after 800
    }
    exp_continue
  }
  -re {code.claude.com/docs/en/security} {
    if {![folder_trust_visible $expect_out(buffer)]} {
      set bypass_disclaimer_menu_open 1
    }
    reset_ready_timeout
    exp_continue
  }
  -re {Bypass Permissions mode.*2\. Yes, I accept} {
    accept_bypass_permissions_disclaimer
    exp_continue
  }
  -re {2\. Yes, I accept.*Enter.*to.*confirm} {
    accept_bypass_permissions_disclaimer
    exp_continue
  }
  -re {Press Enter to continue|Security notes:|Claude can make mistakes} {
    log_harness_keys "\[harness\] onboarding: security notes — continue"
    send -- "\r"
    after 600
    reset_ready_timeout
    exp_continue
  }
  -re {Quick safety check:|trust this folder|Yes, I trust this folder|1\. Yes, I trust this folder} {
    accept_folder_trust
    reset_ready_timeout
    exp_continue
  }
  -re {What's new|What.s new|Internal infrastructur|/release-notes for more} {
    dismiss_claude_splash
    exp_continue
  }
  -re {Press (Enter|Return|any key)|Continue to Claude|Got it|Dismiss|Skip intro} {
    dismiss_claude_splash
    exp_continue
  }
  -re {Not logged in|Please run /login} {
    if {[token_gateway_configured]} {
      log_harness_keys "\[harness\] ignoring OAuth banner - token gateway env configured"
      exp_continue
    }
    set saw_not_logged_in 1
    if {$prompt_submitted == 0} {
      after 5000
      exp_continue
    }
    exp_continue
  }

  -re {MCP servers need authentication|Needs authentication.*run /mcp} {
    log_harness_keys "\[harness\] dismissing MCP auth banner - servers disabled in settings.local.json"
    dismiss_claude_splash
    exp_continue
  }
  -re {shift\+tab|tab to cycle|for agents.*0 tokens|low.effort.*0 tokens} {
    log_harness_keys "\[harness\] 0-token mode banner — wake TUI with Enter (E2E-081)"
    # E2E-081 Enter wake must not starve slash-route submit: the status bar
    # pattern often matches before bypass-permissions and would loop on Enter.
    if {![maybe_submit_prompt $expect_out(buffer)]} {
      send -- "\r"
    }
    after 800
    exp_continue
  }
  -re {SessionStart:.*hook error|startup hook error|SessionStart:clear hook error} {
    log_harness_keys "\[harness\] ignoring SessionStart hook error (non-blocking)"
    exp_continue
  }
  -re {Failed with non-blocking status code} {
    log_harness_keys "\[harness\] ignoring non-blocking hook failure"
    exp_continue
  }
  -re {\[Pasted|Pasted text|paste again to expand} {
    confirm_pasted_prompt_submit
    if {!$prompt_submitted} {
      set prompt_submitted 1
      global prompt_submitted_at
      if {$prompt_submitted_at == 0} {
        set prompt_submitted_at [clock seconds]
      }
    }
    set timeout $quiet_timeout
    exp_continue
  }
  -re {bypass.*permissions.*on} {
    maybe_submit_prompt $expect_out(buffer)
    exp_continue
  }
  -re {Try "how does .* work\?"} {
    # Claude has rendered the prompt helper text; it is ready for input.
    exp_continue
  }
  -re {Silver Bullet initialized\. Start any task and the active workflow will be enforced automatically\.} {
    set final_marker_seen 1
    exp_continue
  }
  -re {Silver Bullet updated\. silver-bullet\.md refreshed\. All skills active\.} {
    set final_marker_seen 1
    exp_continue
  }
  -re {No \.planning/ directory found\. How would you like to initialize this project\?} {
    # The todo-app fixture is brownfield, so we should map the existing codebase
    # first before scaffolding the Silver Bullet project state.
    send -- "b\r"
    exp_continue
  }
  -re {Do these detected values look right\?} {
    send -- "a\r"
    exp_continue
  }
  -re {MultAI plugin is not installed} {
    send -- "b\r"
    exp_continue
  }
  -re {Silver Bullet works best with auto-approve permissions\. Choose a permission mode:} {
    send -- "a\r"
    exp_continue
  }
  -re {Which project management system should Silver Bullet use when filing issues and backlog items\?} {
    send -- "a\r"
    exp_continue
  }
  -re {Enable Graphify for this project\?} {
    send -- "a\r"
    exp_continue
  }
  -re {Enable agentmemory for this project\?} {
    send -- "a\r"
    exp_continue
  }
  -re {Enable RTK for this project\?} {
    send -- "a\r"
    exp_continue
  }
  -re {Enable Context Mode for this project\?} {
    send -- "a\r"
    exp_continue
  }
  -re {Approve composition\? \[Y/n\]} {
    send -- "y\r"
    exp_continue
  }
  -re {What best describes this failure\?} {
    send -- "a\r"
    exp_continue
  }
  -re {Which validation library should} {
    if {$prompt_submitted == 0} { exp_continue }
    # sb:clarify / sb:feature interactive picker - pick first option.
    send -- "1\r"
    set timeout $quiet_timeout
    exp_continue
  }
  -re {Enter to select.*navigate.*Esc to cancel} {
    if {$prompt_submitted == 0} { exp_continue }
    resolve_blocking_decision_picker
    set timeout $quiet_timeout
    exp_continue
  }
  -re {Submit.*(->|Submit)|Submit} {
    if {$prompt_submitted == 0} { exp_continue }
    send -- "\r"
    set timeout $quiet_timeout
    exp_continue
  }
  -re {100%.*context.*used|context window|context is full|context limit reached|/compact} {
    if {[context_exhaustion_visible $expect_out(buffer)]} {
      recover_from_context_exhaustion
    }
    exp_continue
  }
  -re {[1-9][0-9]*[^0-9].*tokens} {
    set saw_not_logged_in 0
    # Extend quiet window only when the token counter changes; idle TUI
    # status lines repeat the same count and would never reach quiet timeout.
    extend_quiet_on_new_token_marker [strip_ansi $expect_out(buffer)]
    maybe_finish_on_matrix_evidence
    exp_continue
  }
  -re {accept.*edits.*on} {
    maybe_submit_prompt $expect_out(buffer)
    exp_continue
  }
  -re {[0-9]+[^0-9]{0,40}tokens} {
    if {$prompt_submitted} {
      extend_quiet_on_new_token_marker [strip_ansi $expect_out(buffer)]
      maybe_finish_on_matrix_evidence
    }
    exp_continue
  }
  -re {1\. Yes.*2\. No|Yes.*No.*recommended.*Enter.*to.*confirm} {
    set custom_api_key_disclaimer_menu_open 1
    accept_custom_api_key_disclaimer
    exp_continue
  }
  -re {No, exit.*Yes, I accept|Yes, I accept.*Enter.*to.*confirm} {
    set bypass_disclaimer_menu_open 1
    accept_bypass_permissions_disclaimer
    exp_continue
  }
  -re {❯} {
    if {[should_accept_custom_api_key_disclaimer $expect_out(buffer)]} {
      set custom_api_key_disclaimer_menu_open 0
      accept_custom_api_key_disclaimer
      exp_continue
    }
    if {[should_accept_bypass_disclaimer $expect_out(buffer)]} {
      set bypass_disclaimer_menu_open 0
      accept_bypass_permissions_disclaimer
      exp_continue
    }
    if {$require_final_marker == 1 && $final_marker_seen == 0} {
      exp_continue
    }
    set saw_prompt 1
    maybe_submit_prompt $expect_out(buffer)
    set timeout $quiet_timeout
    maybe_finish_on_matrix_evidence
    exp_continue
  }
  timeout {
    if {$bypass_disclaimer_menu_open && $bypass_disclaimer_accept_attempts < 6} {
      log_harness_keys "\[harness\] timeout bypass retry"
      accept_bypass_permissions_disclaimer
      set bypass_disclaimer_menu_open 0
      reset_ready_timeout
      exp_continue
    }
    set plain [strip_ansi $expect_out(buffer)]
    if {[regexp -nocase {Bypass} $plain] && [regexp -nocase {Permissions} $plain] && [regexp -nocase {accept|confirm|Gaccept} $plain]} {
      log_harness_keys "\[harness\] timeout bypass detected in buffer"
      accept_bypass_permissions_disclaimer
      set bypass_disclaimer_menu_open 0
      reset_ready_timeout
      exp_continue
    }
    if {[folder_trust_visible $plain]} {
      log_harness_keys "\[harness\] timeout folder trust retry"
      accept_folder_trust
      reset_ready_timeout
      exp_continue
    }
    if {[regexp -nocase {RTK\.md|external imports} $plain] && [regexp -nocase {confirm|cancel} $plain]} {
      log_harness_keys "\[harness\] timeout external imports retry"
      send -- "1\r"
      reset_ready_timeout
      exp_continue
    }
    if {$require_final_marker == 1} {
      if {$final_marker_seen} {
        # The session has returned to a prompt and gone quiet after the
        # init completion marker, so the response is complete.
      } else {
        puts stderr "ERROR: timed out waiting for Silver Bullet init to complete"
        exit 1
      }
    } elseif {$saw_prompt || $prompt_submitted} {
      if {$peak_token_count == 0 && [pasted_prompt_collapsed_visible $expect_out(buffer)]} {
        log_harness_keys "\[harness\] timeout: pasted prompt still collapsed — retry Enter"
        confirm_pasted_prompt_submit
        reset_ready_timeout
        exp_continue
      }
      if {![workflow_response_complete_ok]} {
        extend_workflow_wait_timeout
        exp_continue
      }
      if {$peak_token_count == 0 && ![matrix_evidence_ready]} {
        puts stderr "WARNING: workflow completed after ${workflow_quiet_timeout}s with 0 tokens and no matrix evidence"
      }
    } elseif {$prompt_submitted} {
      puts stderr "ERROR: timed out waiting for Claude response"
      exit 1
    } else {
      puts stderr "ERROR: timed out waiting for Claude prompt to become ready"
      exit 1
    }
  }
  eof {
    if {$folder_trust_accept_attempts > 0 || $folder_trust_confirmed} {
      log_harness_keys "\[harness\] eof after folder trust (confirmed=$folder_trust_confirmed submitted=$prompt_submitted saw_prompt=$saw_prompt)"
    }
    if {$folder_trust_confirmed && !$prompt_submitted && !$saw_prompt} {
      if {[respawn_after_folder_trust]} {
        exp_continue
      }
      puts stderr "ERROR: Claude exited after folder trust before prompt became ready"
      exit 1
    }
    # Some sessions exit cleanly after the response. Accept that.
  }
}

catch {close}
catch {wait}
