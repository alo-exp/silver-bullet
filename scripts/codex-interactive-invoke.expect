#!/usr/bin/expect -f

proc env_or_default {name default} {
  if {[info exists ::env($name)] && $::env($name) ne ""} {
    return $::env($name)
  }
  return $default
}

set timeout [expr {int([env_or_default CODEX_INTERACTIVE_TIMEOUT 900])}]
set cli [env_or_default CODEX_BIN [env_or_default CODEX_CLI [exec sh -lc {command -v kay}]]]
set work_dir [env_or_default CODEX_WORK_DIR ""]
set prompt_file [env_or_default CODEX_PROMPT_FILE ""]
set sandbox_mode [env_or_default CODEX_SANDBOX_MODE "danger-full-access"]
set bypass [env_or_default CODEX_BYPASS "0"]
set color [env_or_default CODEX_COLOR "never"]
set json_output [env_or_default CODEX_JSON "0"]
set transcript_file [env_or_default CODEX_TRANSCRIPT_FILE ""]
set last_message_file [env_or_default CODEX_LAST_MESSAGE_FILE ""]
set model [env_or_default CODEX_MODEL ""]
set model_provider [env_or_default CODEX_MODEL_PROVIDER ""]
set reasoning_effort [env_or_default CODEX_REASONING_EFFORT ""]
set ready_timeout [expr {int([env_or_default CODEX_INTERACTIVE_READY_TIMEOUT 20])}]
set quiet_timeout [expr {int([env_or_default CODEX_INTERACTIVE_QUIET_TIMEOUT 5])}]

if {$work_dir eq "" || $prompt_file eq ""} {
  puts stderr "ERROR: CODEX_WORK_DIR and CODEX_PROMPT_FILE must be set"
  exit 2
}
if {[file tail $cli] ne "kay"} {
  puts stderr "ERROR: SB test launchers require Kay as the compatible agent"
  exit 2
}

set prompt_handle [open $prompt_file r]
set prompt [read $prompt_handle]
close $prompt_handle

cd $work_dir

set args [list exec --cd $work_dir --skip-git-repo-check --color $color]
if {$sandbox_mode ne ""} {
  lappend args --sandbox $sandbox_mode
}
if {$bypass eq "1"} {
  lappend args --dangerously-bypass-approvals-and-sandbox
}
if {$model ne ""} {
  lappend args --model $model
}
if {$model_provider ne ""} {
  lappend args --config "model_provider=$model_provider"
}
if {$reasoning_effort ne ""} {
  # Use the same model, but force the reasoning level for cost control in live E2E runs.
  lappend args --config "model_reasoning_effort=$reasoning_effort"
}
if {$json_output eq "1"} {
  lappend args --json
}
if {$last_message_file ne ""} {
  lappend args --output-last-message $last_message_file
}

if {$transcript_file ne ""} {
  log_file -a $transcript_file
}

spawn -noecho $cli {*}$args $prompt
set saw_completion_marker 0
set saw_prompt 0
expect {
  -re {Uninstall the existing npm-managed Code now\? \[y/N\]} {
    send -- "n\r"
    exp_continue
  }
  -re {Start Code now\? \[y/N\]} {
    send -- "n\r"
    exp_continue
  }
  -re {\"type\":\"task_lifecycle\",\"phase\":\"quiescent\"} {
    set saw_completion_marker 1
    set timeout $quiet_timeout
    exp_continue
  }
  -re {❯} {
    set saw_prompt 1
    set timeout $quiet_timeout
    exp_continue
  }
  -re {^> $} {
    set saw_prompt 1
    set timeout $quiet_timeout
    exp_continue
  }
  eof {
    # Accept clean exit after a single prompt turn.
  }
  timeout {
    if {$saw_completion_marker || $saw_prompt} {
      # The session has returned to a quiescent prompt and gone quiet, so the
      # response is complete.
    } else {
      puts stderr "ERROR: timed out waiting for Codex prompt to complete"
      exit 1
    }
  }
}

if {$transcript_file ne ""} {
  log_file
}
