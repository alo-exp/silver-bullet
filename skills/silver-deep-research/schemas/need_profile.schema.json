{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sb.alolabs.dev/schemas/need_profile.schema.json",
  "title": "NeedProfile",
  "type": "object",
  "required": [
    "category",
    "audience",
    "must_haves",
    "license_preference",
    "interview_complete"
  ],
  "properties": {
    "category": { "type": "string", "minLength": 1 },
    "adjacent_categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "audience": { "type": "string", "minLength": 1 },
    "must_haves": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nice_to_haves": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "success_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "weights_override": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["Critical", "Very High", "High", "Medium", "Low"]
      }
    },
    "license_preference": {
      "type": "string",
      "enum": ["oss", "commercial", "mixed"]
    },
    "interview_complete": { "type": "boolean" },
    "decision_goal": { "type": "string" },
    "hard_vetoes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "persona_id": {
      "type": "string",
      "enum": ["startup", "enterprise", "regulated"],
      "description": "Optional persona from reference/need-profile-personas.json for weighted matrix scoring"
    },
    "category_pack_id": {
      "type": "string",
      "minLength": 1,
      "description": "Required for solution-landscape and solution-compare; references reference/landscape/category-packs/{id}.json"
    },
    "must_research": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Additional product slugs or names that must appear in core coverage (merged with pack core_seeds)"
    },
    "allow_adjacent_section": {
      "type": "boolean",
      "default": true,
      "description": "When false, omit Adjacent Markets section from packaging"
    },
    "inclusion_criteria": {
      "type": "object",
      "description": "Optional override of pack inclusion_criteria; must include non-empty criteria list when set",
      "required": ["rule", "min_pass_count", "criteria"],
      "properties": {
        "rule": { "type": "string", "enum": ["min_pass_count"] },
        "min_pass_count": { "type": "integer", "minimum": 1 },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "description"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "exclusion_classes": {
      "type": "array",
      "description": "Optional override of pack exclusion_classes taxonomy",
      "items": {
        "type": "object",
        "required": ["id", "label", "description"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "auto_assumed": { "type": "boolean" }
  },
  "additionalProperties": true
}


