{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sb.alolabs.dev/schemas/need_profile.schema.json",
  "title": "NeedProfile",
  "type": "object",
  "required": [
    "category",
    "audience",
    "must_haves",
    "license_preference",
    "interview_complete"
  ],
  "properties": {
    "category": { "type": "string", "minLength": 1 },
    "adjacent_categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "audience": { "type": "string", "minLength": 1 },
    "must_haves": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nice_to_haves": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "success_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "weights_override": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["Critical", "Very High", "High", "Medium", "Low"]
      }
    },
    "license_preference": {
      "type": "string",
      "enum": ["oss", "commercial", "mixed"]
    },
    "interview_complete": { "type": "boolean" },
    "decision_goal": { "type": "string" },
    "hard_vetoes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "auto_assumed": { "type": "boolean" }
  },
  "additionalProperties": true
}
