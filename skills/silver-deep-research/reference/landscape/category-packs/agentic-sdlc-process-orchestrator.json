{
  "schema_version": "1.0.0",
  "category_id": "agentic-sdlc-process-orchestrator",
  "display_name": "Agentic SDLC Process Orchestrators",
  "definition": "Systems that add repeatable workflows, cross-session state, deterministic quality gates, specialist agents, and enforcement above the host coding-agent runtime \u2014 not generic AI coding assistants, foundation-model labs, or single-step SDLC tools. Closest comps orchestrate full or multi-phase software delivery and DevOps cycles as composable, host-integrated process layers (plugins, skills, hooks).",
  "jobs_to_be_done": [
    "Enforce a full SDLC or DevOps cycle so agents cannot skip planning, verification, review, or release steps",
    "Compose specialist agents and external workflows (GSD, spec kits, review ladders) under one compliance layer",
    "Persist process state, gates, and evidence across sessions and parallel workers",
    "Provide procurement-ready comparison of process-orchestration depth vs host runtimes and frameworks"
  ],
  "inclusion_criteria": {
    "rule": "min_pass_count",
    "min_pass_count": 3,
    "criteria": [
      {
        "id": "lifecycle_span",
        "label": "Multi-phase lifecycle span",
        "description": "Covers two or more of plan/spec, build, test, review, release, or DevOps operations as an integrated process \u2014 not a single-shot codegen or review-only tool."
      },
      {
        "id": "plugin_skill_hook_packaging",
        "label": "Plugin / skill / hook packaging",
        "description": "Ships as host-integrated packaging (Claude/Codex/Cursor plugin, skill bundle, hook layer, or equivalent) rather than a standalone IDE or raw API."
      },
      {
        "id": "deterministic_gates",
        "label": "Deterministic quality gates",
        "description": "Uses machine-checkable gates (hooks, audits, stop-checks, CI integration) that block progression when criteria fail."
      },
      {
        "id": "cross_session_state",
        "label": "Cross-session state",
        "description": "Persists workflow state, memory, or runbooks across agent clears, sessions, or parallel workers."
      },
      {
        "id": "specialist_agents",
        "label": "Specialist agent orchestration",
        "description": "Routes work to named specialist agents, hats, or role-specific subagents \u2014 not a single monolithic agent."
      },
      {
        "id": "quality_release_enforcement",
        "label": "Quality / release enforcement claim",
        "description": "Publicly claims enforcement of quality, compliance, release, or governance \u2014 not advisory-only suggestions."
      },
      {
        "id": "process_layer_above_host",
        "label": "Process layer above host runtime",
        "description": "Positions as a meta-orchestrator or compliance wrapper above Claude Code, Codex, Cursor, or similar \u2014 not as the host runtime itself."
      }
    ]
  },
  "exclusion_classes": [
    {
      "id": "coding_agent",
      "label": "Generic AI coding agent",
      "description": "IDE copilots, autocomplete agents, and autonomous SWE bots whose primary job is writing code \u2014 not enforcing a full process lattice."
    },
    {
      "id": "host_runtime",
      "label": "Host runtime",
      "description": "The underlying agent host (Cursor, Claude Code, Codex CLI, Copilot) when evaluated as the runtime itself \u2014 adjacent only, not a process-orchestrator peer."
    },
    {
      "id": "single_sdlc_step",
      "label": "Single SDLC step tool",
      "description": "Point solutions for one step only: code review bots, test generators, security scanners, design tools without workflow orchestration."
    },
    {
      "id": "generic_agent_framework",
      "label": "Generic agent framework",
      "description": "Reusable multi-agent libraries (LangGraph, CrewAI, MetaGPT) without a shipped, enforced SDLC process product."
    },
    {
      "id": "project_management",
      "label": "Project management",
      "description": "Issue trackers and PM SaaS (Linear, Jira-style) without agentic process enforcement."
    },
    {
      "id": "foundation_model_lab",
      "label": "Foundation model lab",
      "description": "Model providers and research labs \u2014 not process-orchestration products."
    },
    {
      "id": "sunset",
      "label": "Sunset / discontinued",
      "description": "Products officially discontinued or abandoned; never list in Top-N, charts, or matrix."
    }
  ],
  "adjacent_classes": [
    {
      "id": "host_runtime",
      "label": "Host runtimes & autonomous SWE",
      "description": "Devin, Factory.ai, Cursor, Copilot, Claude Code, Codex \u2014 important context but not SB-comparable process orchestrators."
    },
    {
      "id": "methodology_ingredient",
      "label": "Methodology / ingredient systems",
      "description": "GSD, Superpowers, BMAD, Spec Kit, SuperClaude \u2014 upstream ingredients SB may compose, not full compliance wrappers."
    },
    {
      "id": "generic_agent_framework",
      "label": "Generic agent frameworks",
      "description": "LangGraph, CrewAI, MetaGPT \u2014 building blocks, not analyst-grade process-orchestrator peers."
    },
    {
      "id": "governance_adjacent",
      "label": "Governance-adjacent",
      "description": "Runtime policy and audit layers (e.g. AxonFlow) \u2014 adjacent on enforcement evidence, not full SDLC orchestration."
