{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cursor-host-adapter-v1.schema.json",
  "title": "CursorHostAdapterV1",
  "type": "object",
  "required": ["schema_id", "version", "launch", "result"],
  "properties": {
    "schema_id": { "const": "cursor-host-adapter-v1" },
    "version": { "const": "1.0.0" },
    "launch": {
      "type": "object",
      "required": [
        "idempotency_key",
        "run_id",
        "work_item_id",
        "logical_model_id",
        "attempt_id",
        "requested_model_id",
        "effective_model_id",
        "output_root",
        "deadline",
        "hard_token_ceiling"
      ],
      "properties": {
        "idempotency_key": { "type": "string" },
        "run_id": { "type": "string" },
        "work_item_id": { "type": "string" },
        "phase_id": { "type": ["string", "null"] },
        "logical_model_id": { "type": "string" },
        "attempt_id": { "type": "string" },
        "requested_model_id": { "type": "string" },
        "effective_model_id": { "type": "string" },
        "output_root": { "type": "string" },
        "deadline": { "type": "string", "format": "date-time" },
        "hard_token_ceiling": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "required": ["status", "effective_model_id", "usage"],
      "properties": {
        "status": {
          "enum": ["completed", "partial", "failed", "cancelled", "budget_stopped"]
        },
        "effective_model_id": { "type": "string" },
        "usage": {
          "type": "object",
          "required": ["input_tokens", "output_tokens", "total_tokens"],
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "total_tokens": { "type": "integer", "minimum": 0 },
            "currency_micro_usd": { "type": ["integer", "null"] }
          }
        },
        "retry_class": { "type": ["string", "null"] },
        "cancellation_acknowledged": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
