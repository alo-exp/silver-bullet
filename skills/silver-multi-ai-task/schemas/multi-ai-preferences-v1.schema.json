{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multi-ai-preferences-v1.schema.json",
  "title": "MultiAiPreferencesV1",
  "type": "object",
  "required": ["schema_id", "version"],
  "properties": {
    "schema_id": { "const": "multi-ai-preferences-v1" },
    "version": { "const": "1.0.0" },
    "multi_ai": {
      "type": "object",
      "properties": {
        "cursor_subscription": { "enum": ["auto", "subscribed", "unsubscribed"] },
        "capability_cache": {
          "type": "object",
          "properties": {
            "ttl_seconds": { "type": "integer", "minimum": 1 },
            "refresh": { "type": "boolean" },
            "bypass": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "default_ocg_pool": { "enum": ["none", "lite", "regular"] },
        "default_cursor_pool": { "enum": ["none", "default"] },
        "max_cost_usd": { "type": "string" },
        "max_total_tokens": { "type": "integer" },
        "max_agents": { "type": "integer" },
        "concurrency": { "type": "integer" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
