{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multi-ai-result-index-v1.schema.json",
  "title": "MultiAiResultIndexV1",
  "type": "object",
  "required": [
    "schema_id",
    "version",
    "spine",
    "run_id",
    "ledger_generation",
    "ledger_head_hash",
    "entries"
  ],
  "properties": {
    "schema_id": { "const": "multi-ai-result-index-v1" },
    "version": { "const": "1.0.0" },
    "spine": { "const": "multi-ai-task-v2" },
    "run_id": { "type": "string", "pattern": "^run-[0-9a-f]{32}$" },
    "ledger_generation": { "type": "integer", "minimum": 0 },
    "ledger_head_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["work_item_id", "logical_model_id", "status"],
        "properties": {
          "work_item_id": { "type": "string" },
          "logical_model_id": { "type": "string" },
          "status": {
            "enum": ["completed", "partial", "failed", "excluded", "cancelled", "budget_stopped", "pending"]
          },
          "authoritative_attempt_id": { "type": ["string", "null"] },
          "validation_outcome": { "type": ["string", "null"] },
          "terminal_reason": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
