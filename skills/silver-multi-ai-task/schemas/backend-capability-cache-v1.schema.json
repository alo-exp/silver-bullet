{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backend-capability-cache-v1.schema.json",
  "title": "BackendCapabilityCacheV1",
  "type": "object",
  "required": ["schema_id", "version", "entries"],
  "properties": {
    "schema_id": { "const": "backend-capability-cache-v1" },
    "version": { "const": "1.0.0" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cache_identity", "probed_at", "expires_at", "evidence_hash", "backend", "status"],
        "properties": {
          "cache_identity": { "type": "string" },
          "probed_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" },
          "evidence_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "backend": { "enum": ["cursor", "ocg"] },
          "status": { "enum": ["enabled", "disabled"] },
          "disable_reason": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
