# Secrets — never commit credentials to this repo
.env
.env.*
*.key
*.pem
id_rsa*
secrets.json

.DS_Store
__pycache__/
*.py[cod]
data/state_store.db/
site/new/
*.swp
*.swo
.worktrees/

# Claude Code runtime artifacts (per-session, per-user)
# Committed config (.claude/settings.json, .claude/commands/) stays tracked.
.claude/projects/
.claude/local/
.claude/.silver-bullet/
.claude/settings.local.json
.claude/worktrees/

# Session log artifacts (generated per-session by session-log-init.sh hook)
docs/sessions/

# E2E matrix / run-all-tests runtime logs (never commit)
.e2e-row*.log
.e2e-cursor-install-version.txt
.e2e-matrix-pass-at-version.tsv
.run-all-tests-*.log

# Visual QA capture outputs — ignore new dated runs; golden sets stay tracked
.visual-audit/responsive-full/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
!.visual-audit/responsive-full/2026-06-30-post-fix/
!.visual-audit/responsive-full/2026-06-30-pipeline-proof/
.visual-audit/proof-test-results-*.json
.visual-audit/responsive-full/*/capture-manifest.json
!.visual-audit/responsive-full/2026-06-30-post-fix/capture-manifest.json
!.visual-audit/responsive-full/2026-06-30-pipeline-proof/capture-manifest.json

# E2E test app -- SB-generated artifacts (excluded from SB repo)
tests/test-app/node_modules/
tests/test-app/.planning/
.planning/agent-codex/
.planning/agent-codex-pilot-*/
.planning/agent-codex-smoke/
.planning/agent-cursor/
.planning/agent-claude/
.planning/agent-claude-pilot-*/
.planning/agent-claude-smoke/
.planning/agent-claude-smoke-*/
.planning/agent-opencode/
.planning/agent-pi/
tests/test-app/.silver-bullet.json
tests/forge-test-app/node_modules/
tests/test-app/silver-bullet.md
tests/test-app/CLAUDE.md
tests/test-app/docs/
tests/test-app/.github/
plugins/silver-bullet/.generated-skills/
tests/live/agents/*/transcripts/

# Multi-agent phase coordination — runtime lock state (Phase 70)
# .phase-locks.json is the live lock state; .lock is the flock(1) sidecar.
# Both are per-checkout runtime state, never committed.
.planning/.phase-locks.json
.planning/.phase-locks.json.lock

# Composed-workflow tracker — runtime per-instance workflow files (Pass 2, v0.29.1)
# Active workflow files at .planning/workflows/<id>.md are local runtime state and
# never committed. The .archive/ subdir keeps completed workflow files for
# postmortem reference and is also gitignored.
.planning/workflows/
.planning/.context-cache/
temp_auto_push.bat
temp_interactive_push.bat
.gitignore
branch_structure.json

# Graphify's shared, reviewable artifacts are committed; local caches and
# provider-specific/transient output stay untracked.
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/manifest.json
graphify-out/cache/
graphify-out/cost.json
raw/

# === agentmemory managed block ===
# Most contents are gitignored, specific files committed
.agentmemory/*
!.agentmemory/memory/
!.agentmemory/memory/**
!.agentmemory/snapshots/
!.agentmemory/snapshots/**
!.agentmemory/profile.md
# === end agentmemory managed block ===
site/.preview-server.pid
site/.preview-server.log

# === local-only agent artifacts (never committed) ===
.claude/settings.json.graphify-bak
.claude/CLAUDE.md
