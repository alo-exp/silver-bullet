# Python bytecode
__pycache__/
*.py[cod]

# Coverage runs (tests/coverage/run-coverage.sh)
/.coverage-run/
.coverage
.coverage.*

# Graphify incremental caches; graph.json, GRAPH_REPORT.md and manifest.json stay tracked
graphify-out/cache/
graphify-out/converted/

# Contributor virtualenv created by `make setup`
/.venv/

# Silver Bullet runtime files written into a project (caches, telemetry, scan state); the
# audit logs (orchestrator-override-log.jsonl) are deliberately not ignored
/.planning/.context-cache/
/.planning/orchestrator-composition-log.jsonl
/.planning/enterprise-e2e/token-telemetry.jsonl
/.silver-bullet/scan-state.json

# Per-developer host configuration generated by tool installers (absolute paths, binaries
# that exist only on one machine); the installers regenerate them.
# .codex/hooks.json is the portable dogfood config and stays tracked.
/.github/hooks/
/.claude/launch.json
/data/iii-config.yaml

# Lock files written by scripts/render-agent-bundle.py
*.render.lock

# Runtime state written into the checkout by optional tools
.github/context-mode/
.silver-bullet/graphify-query
.silver-bullet/agentmemory-usage
data/state_store.db/
data/stream_store/
data/iii-config.runtime.yaml

# Enterprise E2E supervisor scratch files (scripts/run-enterprise-e2e-*.sh)
/.e2e-*

# Editor and OS leftovers
*.bak
*.swp
.DS_Store

# Private or operational data that must not be committed (R13-11): machine setup reports, AI
# CLI session transcripts and logs, account or quota plans. scripts/check-repo-invariants.sh
# (personal-data) fails when personal machine paths or foreign email addresses are tracked.
/SETUP_REPORT.md
*.err
*.err.*
*.log.*
.planning/**/*.log
.planning/**/*.log.*
research/**/*.log
.planning/**/CLAUDE-QUOTA.md

# Node
node_modules/

# Agent worktrees created inside the checkout
.claude/worktrees/
graphify-out/.graphify_*
graphify-out/graph.html
graphify-out/.graph.html.stale

# agentmemory snapshot store (was an orphan gitlink with no .gitmodules entry)
/.agentmemory/snapshots/
