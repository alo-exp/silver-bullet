{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multi-ai-work-item-manifest-v1.schema.json",
  "title": "MultiAiWorkItemManifestV1",
  "type": "object",
  "required": [
    "schema_id",
    "version",
    "spine",
    "run_id",
    "work_item_id",
    "input_hash",
    "resolved_logical_ids",
    "attempts",
    "budget"
  ],
  "properties": {
    "schema_id": { "const": "multi-ai-work-item-manifest-v1" },
    "version": { "const": "1.0.0" },
    "spine": { "const": "multi-ai-task-v2" },
    "run_id": { "type": "string", "pattern": "^run-[0-9a-f]{32}$" },
    "work_item_id": { "type": "string", "pattern": "^work-[0-9a-f]{32}$" },
    "input_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "task_schema_ref": { "type": "string" },
    "output_schema_ref": { "type": "string" },
    "resolved_logical_ids": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "logical_model_id",
          "model_family_id",
          "requested_model_id",
          "effective_model_id",
          "model_family_registry_version",
          "model_family_registry_sha256"
        ],
        "properties": {
          "logical_model_id": { "type": "string" },
          "model_family_id": { "type": "string" },
          "requested_model_id": { "type": "string" },
          "effective_model_id": { "type": "string" },
          "backend": { "enum": ["cursor", "ocg"] },
          "model_family_registry_version": { "type": "string" },
          "model_family_registry_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attempt_id", "logical_model_id", "status"],
        "properties": {
          "attempt_id": { "type": "string" },
          "logical_model_id": { "type": "string" },
          "status": {
            "enum": ["queued", "running", "completed", "partial", "failed", "cancelled", "excluded", "budget_stopped"]
          },
          "authoritative": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "budget": {
      "type": "object",
      "required": ["currency_micro_usd_cap", "total_tokens_cap"],
      "properties": {
        "currency_micro_usd_cap": { "type": "integer", "minimum": 0 },
        "total_tokens_cap": { "type": "integer", "minimum": 0 },
        "currency_micro_usd_actual": { "type": "integer", "minimum": 0 },
        "total_tokens_actual": { "type": "integer", "minimum": 0 },
        "price_known": { "type": "boolean" },
        "usage_metered": { "type": "boolean" },
        "budget_stop_reason": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "array",
      "items": { "type": "object" },
      "default": []
    }
  },
  "additionalProperties": false
}
