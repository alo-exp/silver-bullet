{
  "version": "1.1.0",
  "channels": {
    "web": {"provider": "search-cli", "mode": "general", "fallback": "host_web_search"},
    "academic": {"provider": "search-cli", "mode": "academic", "fallback": "host_web_search"},
    "gov": {"provider": "search-cli", "mode": "general", "domain_filter": ".gov"},
    "docs": {"provider": "search-cli", "mode": "general", "domain_filter": "docs."},
    "code": {"provider": "search-cli", "mode": "general", "domain_filter": "github.com,gitlab.com"},
    "stats": {"provider": "search-cli", "mode": "general", "fallback": "host_web_search"},
    "gitlab": {
      "provider": "official_api",
      "host": "gitlab.com",
      "method": "GET /api/v4/search",
      "scopes": ["projects", "blobs", "issues", "merge_requests", "wiki_blobs"],
      "scope_notes": "Instance wiki_blobs is Premium/Ultimate + advanced search; gitlab.com has advanced search.",
      "fallback": "search-cli -p brave,serper site:gitlab.com",
      "mvp": true
    },
    "youtube": {
      "provider": "official_api",
      "host": "www.googleapis.com/youtube/v3",
      "method": "search.list",
      "fallback": "search-cli -p brave,serper site:youtube.com",
      "mvp": true
    },
    "linkedin": {
      "provider": "search-cli",
      "mode": "general",
      "domain_filter": "linkedin.com",
      "paid_api": "marketing_community_management_partner",
      "mvp": false
    },
    "x": {
      "provider": "paid_api",
      "host": "api.x.com",
      "method": "GET /2/tweets/search/recent",
      "fallback": "search-cli -p brave,serper site:x.com OR site:twitter.com",
      "mvp": false
    },
    "facebook": {
      "provider": "sample_only",
      "must_search": false,
      "fallback": "search-cli -p brave,serper site:facebook.com"
    }
  }
}
