{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "description": "Need-profile personas for weighted comparison-matrix scoring. Set persona_id on need_profile.json.",
  "personas": {
    "startup": {
      "label": "Startup / early-stage",
      "description": "Small team, fast time-to-value, limited ops headcount, predictable cost.",
      "audience_default": "Founder or early engineering lead",
      "priority_hints": {
        "must_have": "Critical",
        "nice_to_have": "High",
        "default": "Medium"
      },
      "category_priority_floor": {
        "Developer Experience": "High",
        "Pricing and licensing": "Very High",
        "Time to value": "Critical"
      },
      "feature_priority_overrides": {
        "Self-serve signup": "Critical",
        "Managed hosting": "Critical",
        "Predictable pricing": "Very High",
        "Quick onboarding": "Critical"
      },
      "suggested_must_haves": [
        "Self-serve signup",
        "Managed hosting",
        "API access"
      ],
      "suggested_constraints": [
        "Limited budget",
        "Small team",
        "Prefer low operational overhead"
      ]
    },
    "enterprise": {
      "label": "Enterprise",
      "description": "Large org, SSO/RBAC/compliance, procurement, multi-team rollout.",
      "audience_default": "Enterprise architect or platform engineering lead",
      "priority_hints": {
        "must_have": "Critical",
        "nice_to_have": "Medium",
        "default": "Medium"
      },
      "category_priority_floor": {
        "Security and compliance": "Critical",
        "Identity and access": "Critical",
        "Governance": "Very High"
      },
      "feature_priority_overrides": {
        "SSO": "Critical",
        "RBAC": "Critical",
        "Audit log": "Very High",
        "SOC 2": "Critical"
      },
      "suggested_must_haves": [
        "SSO",
        "RBAC",
        "Audit log"
      ],
      "suggested_constraints": [
        "Procurement review",
        "Data residency",
        "Vendor security questionnaire"
      ]
    },
    "regulated": {
      "label": "Regulated industry",
      "description": "Healthcare, finance, or public sector with strict compliance and data controls.",
      "audience_default": "Compliance-aware engineering or security lead",
      "priority_hints": {
        "must_have": "Critical",
        "nice_to_have": "High",
        "default": "Medium"
      },
      "category_priority_floor": {
        "Security and compliance": "Critical",
        "Data residency": "Critical",
        "Audit and traceability": "Critical"
      },
      "feature_priority_overrides": {
        "HIPAA": "Critical",
        "Data residency controls": "Critical",
        "Immutable audit log": "Critical"
      },
      "suggested_must_haves": [
        "Audit log",
        "Data residency controls",
        "Encryption at rest"
      ],
      "suggested_constraints": [
        "Regulatory attestation",
        "On-prem or dedicated tenancy"
      ]
    }
  }
}
