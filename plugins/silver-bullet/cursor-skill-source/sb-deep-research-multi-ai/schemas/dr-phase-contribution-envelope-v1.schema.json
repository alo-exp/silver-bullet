{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dr-phase-contribution-envelope-v1.schema.json",
  "title": "DrPhaseContributionEnvelopeV1",
  "type": "object",
  "required": [
    "schema_id",
    "version",
    "run_id",
    "work_item_id",
    "phase_id",
    "logical_model_id",
    "attempt_id",
    "payload",
    "model_family_id"
  ],
  "properties": {
    "schema_id": {
      "const": "dr-phase-contribution-envelope-v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string"
    },
    "work_item_id": {
      "type": "string"
    },
    "phase_id": {
      "enum": [
        "DR-RETRIEVE",
        "DR-TRIANGULATE",
        "DR-CRITIQUE"
      ]
    },
    "logical_model_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "properties": {
        "matrix_entries": {
          "type": "array",
          "description": "Optional structured capability votes: one row per vendor and feature.",
          "items": {
            "type": "object",
            "required": [
              "vendor",
              "feature",
              "supported"
            ],
            "properties": {
              "vendor": {
                "type": "string"
              },
              "feature": {
                "type": "string"
              },
              "supported": {
                "type": "boolean"
              },
              "source_ref": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "model_family_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase_id": {
            "const": "DR-RETRIEVE"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "sources": {
                "type": "array"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "vendors": {
                      "type": "array",
                      "description": "Optional: the exact vendor slugs (from the [CATEGORY_PACK] list or the names used in matrix_entries) this row's statement is about; [] when none. An ambiguous product name (Director, Cursor, Linear, Devin, ...) is credited only through this field or a source that names it.",
                      "maxItems": 12,
                      "items": {
                        "type": "string",
                        "maxLength": 80
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase_id": {
            "const": "DR-TRIANGULATE"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "claim_candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "vendors": {
                      "type": "array",
                      "description": "Optional: the exact vendor slugs (from the [CATEGORY_PACK] list or the names used in matrix_entries) this row's statement is about; [] when none. An ambiguous product name (Director, Cursor, Linear, Devin, ...) is credited only through this field or a source that names it.",
                      "maxItems": 12,
                      "items": {
                        "type": "string",
                        "maxLength": 80
                      }
                    }
                  }
                }
              },
              "cross_checks": {
                "type": "array"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase_id": {
            "const": "DR-CRITIQUE"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "critiques": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "vendors": {
                      "type": "array",
                      "description": "Optional: the exact vendor slugs (from the [CATEGORY_PACK] list or the names used in matrix_entries) this row's statement is about; [] when none. An ambiguous product name (Director, Cursor, Linear, Devin, ...) is credited only through this field or a source that names it.",
                      "maxItems": 12,
                      "items": {
                        "type": "string",
                        "maxLength": 80
                      }
                    }
                  }
                }
              },
              "gaps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "vendors": {
                      "type": "array",
                      "description": "Optional: the exact vendor slugs (from the [CATEGORY_PACK] list or the names used in matrix_entries) this row's statement is about; [] when none. An ambiguous product name (Director, Cursor, Linear, Devin, ...) is credited only through this field or a source that names it.",
                      "maxItems": 12,
                      "items": {
                        "type": "string",
                        "maxLength": 80
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
